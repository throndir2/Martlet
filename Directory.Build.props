<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <_RuntimeLockRids Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_RuntimeLockRids>
    <_RuntimeLockRids Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != ''">$(RuntimeIdentifiers)</_RuntimeLockRids>
    <_RuntimeLockKeyValid Condition="'$(_RuntimeLockRids)' != ''">$([System.Text.RegularExpressions.Regex]::IsMatch('$(_RuntimeLockRids)', '^[A-Za-z0-9][A-Za-z0-9.-]*(;[A-Za-z0-9][A-Za-z0-9.-]*)*$'))</_RuntimeLockKeyValid>
    <NuGetLockFilePath Condition="'$(_RuntimeLockRids)' != '' and '$(_RuntimeLockKeyValid)' == 'True' and '$(NuGetLockFilePath)' == ''">$(MSBuildProjectDirectory)\obj\runtime-locks\$([System.String]::Copy('$(_RuntimeLockRids)').Replace(';', '_'))\packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>0.67.0</Version>
  </PropertyGroup>
  <Target Name="ValidateRuntimeLockKey" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild"
          Condition="'$(_RuntimeLockRids)' != '' and '$(_RuntimeLockKeyValid)' != 'True'">
    <Error Text="Runtime identifiers must be bounded local RID tokens; path separators and unsupported characters are not accepted." />
  </Target>
</Project>
