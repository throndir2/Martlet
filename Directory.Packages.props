<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.84.0" />
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" />
    <PackageVersion Include="NetCord" Version="1.0.0-beta.28" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
    <PackageVersion Include="SoundFlow" Version="1.4.0" />
    <PackageVersion Include="SoundFlow.Extensions.WebRtc.Apm" Version="1.4.0" />
    <PackageVersion Include="SSH.NET" Version="2024.1.0" />
    <PackageVersion Include="System.Speech" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- SSH.NET 2024.1.0 (no dependencies) advisories that affect only ScpClient; Martlet's HostShell never uses SCP and passes
         data on stdin instead. Review again before using ScpClient or upgrading. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-mggc-4xg6-vcxf" />
  </ItemGroup>
</Project>
