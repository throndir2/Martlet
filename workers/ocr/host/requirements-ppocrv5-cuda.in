# The PP-OCRv5 engine of the ocr role on an NVIDIA graphics card (host/Dockerfile.ppocrv5 with ACCELERATOR=gpu): ONNX
# Runtime's CUDA 13 build with NVIDIA's CUDA and cuDNN libraries from PyPI. Regenerate the lock with:
#   uv pip compile workers/ocr/host/requirements-ppocrv5-cuda.in --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 -o workers/ocr/host/requirements-ppocrv5-cuda.lock
# setuptools builds omegaconf's antlr4-python3-runtime 4.9.3, which PyPI has only as source.
rapidocr==3.10.0
onnxruntime-gpu[cuda,cudnn]==1.31.0
setuptools
