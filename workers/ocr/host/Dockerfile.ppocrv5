# Martlet OCR host image, PP-OCRv5 engine: RapidOCR 3.10.0 with PaddleOCR's PP-OCRv5 ONNX models (mobile and server, both
# baked in and SHA-256 checked, so changing the model only restarts the service) on ONNX Runtime 1.31.0. ACCELERATOR=gpu
# (the ocr role's compose.gpu.yaml) installs ONNX Runtime's CUDA 13 build with NVIDIA's CUDA and cuDNN libraries from PyPI;
# it needs an NVIDIA driver for CUDA 13 (580 or newer). Built on the host by "martlet-host add ocr" with context workers/ocr.
# Package trees and models are root-owned and read-only for the unprivileged runtime user. Images are read in memory and
# never stored. ORT_DISABLE_TELEMETRY turns off ONNX Runtime's usage telemetry to Microsoft.
FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db

ARG ACCELERATOR=cpu
ENV ORT_DISABLE_TELEMETRY=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore \
    PIP_DEFAULT_TIMEOUT=60 PIP_RETRIES=10 PIP_RESUME_RETRIES=10

RUN mkdir -p /opt/martlet-ocr/build \
 && echo 'pip==26.2.1 --hash=sha256:71138adf1f4ca900cdb7d289c21b7494329f2332b6d85f0e1c42108c0384ed3e' > /opt/martlet-ocr/build/pip.lock \
 && python3.12 -m pip install --no-deps --require-hashes --no-compile -r /opt/martlet-ocr/build/pip.lock \
 && rm -f /opt/martlet-ocr/build/pip.lock

# setuptools first: omegaconf's antlr4-python3-runtime 4.9.3 is on PyPI only as source and builds with it.
COPY host/requirements-ppocrv5.lock host/requirements-ppocrv5-cuda.lock /opt/martlet-ocr/build/
RUN case "${ACCELERATOR}" in \
      cpu) lock=/opt/martlet-ocr/build/requirements-ppocrv5.lock ;; \
      gpu) lock=/opt/martlet-ocr/build/requirements-ppocrv5-cuda.lock ;; \
      *) echo "ACCELERATOR must be cpu or gpu" >&2; exit 1 ;; \
    esac \
 && grep -A200 '^setuptools==' "${lock}" | sed '/^    # via/q' > /opt/martlet-ocr/build/setuptools.lock \
 && python3.12 -m pip install --no-deps --require-hashes --no-compile -r /opt/martlet-ocr/build/setuptools.lock \
 && python3.12 -m pip install --no-deps --require-hashes --no-compile --no-build-isolation -r "${lock}" \
 && rm -rf /opt/martlet-ocr/build \
 && find /usr/local/lib/python3.12/site-packages -name __pycache__ -type d -prune -exec rm -rf {} + \
 && find /usr/local/lib/python3.12/site-packages -name '*.pyc' -type f -exec rm -f {} + \
 && chmod -R go-w /usr/local/lib/python3.12/site-packages

COPY host/martlet_ocr_host.py /opt/martlet-ocr/host/martlet_ocr_host.py
# The models come from RapidOCR's ModelScope release v3.10.0, or from an identical Hugging Face copy when ModelScope fails;
# the build fails when no copy matches its pinned SHA-256.
# The self-test then reads a generated image with each model on the processor (no graphics card while building).
RUN python3.12 /opt/martlet-ocr/host/martlet_ocr_host.py fetch-models /opt/martlet-ocr/models \
 && MARTLET_OCR_ENGINE=ppocrv5 OCR_MODEL=ppocrv5-mobile MARTLET_OCR_ACCELERATOR=cpu python3.12 /opt/martlet-ocr/host/martlet_ocr_host.py selftest \
 && MARTLET_OCR_ENGINE=ppocrv5 OCR_MODEL=ppocrv5-server MARTLET_OCR_ACCELERATOR=cpu python3.12 /opt/martlet-ocr/host/martlet_ocr_host.py selftest \
 && find /usr/local/lib/python3.12/site-packages /opt/martlet-ocr -name __pycache__ -type d -prune -exec rm -rf {} + \
 && chmod -R go-w /opt/martlet-ocr

ENV MARTLET_OCR_PORT=50087 MARTLET_OCR_ENGINE=ppocrv5 OCR_MODEL=ppocrv5-mobile MARTLET_OCR_ACCELERATOR=${ACCELERATOR} \
    MARTLET_OCR_MODELS=/opt/martlet-ocr/models
RUN useradd --uid 10057 --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin martlet-ocr

USER 10057:10057
WORKDIR /opt/martlet-ocr
EXPOSE 50087
ENTRYPOINT ["/usr/local/bin/python3.12", "/opt/martlet-ocr/host/martlet_ocr_host.py"]
CMD ["serve"]
