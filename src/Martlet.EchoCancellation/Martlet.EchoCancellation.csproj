<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Martlet.Audio\Martlet.Audio.csproj" />
    <!-- WebRTC's acoustic echo canceller (AEC3; BSD-3-Clause, PulseAudio's standalone webrtc-audio-processing build) through
         SoundFlow's MIT wrapper: webrtc-apm.dll and its managed binding. -->
    <PackageReference Include="SoundFlow.Extensions.WebRtc.Apm" ExcludeAssets="contentFiles;build;buildTransitive;analyzers" />
  </ItemGroup>
</Project>
