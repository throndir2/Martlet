<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer check run by Martlet.Mcp's node_link_check tool: the node-to-node command protocol end to end on loopback. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Martlet.Gateway\Martlet.Gateway.csproj" />
    <ProjectReference Include="..\Martlet.Gateway.Ollama\Martlet.Gateway.Ollama.csproj" />
    <ProjectReference Include="..\Martlet.Gateway.F5\Martlet.Gateway.F5.csproj" />
    <!-- voice-engine (voice_engine_check) uses every voice role's production relay. -->
    <ProjectReference Include="..\Martlet.Gateway.Xtts\Martlet.Gateway.Xtts.csproj" />
    <ProjectReference Include="..\Martlet.Gateway.GptSovits\Martlet.Gateway.GptSovits.csproj" />
    <ProjectReference Include="..\Martlet.Gateway.Dia\Martlet.Gateway.Dia.csproj" />
    <!-- singing-check (singing_check) makes a song through the singing role's production relay. -->
    <ProjectReference Include="..\Martlet.Gateway.Singing\Martlet.Gateway.Singing.csproj" />
    <!-- listening-engine (listening_engine_check) transcribes through the stt role's production relay. -->
    <ProjectReference Include="..\Martlet.Gateway.Stt\Martlet.Gateway.Stt.csproj" />
    <!-- singing-check paired:<data directory> and singing-status sign requests to a paired host with the desktop's pairing
         secret from Windows Credential Manager (never printed). -->
    <ProjectReference Include="..\Martlet.Credentials.Windows\Martlet.Credentials.Windows.csproj" />
    <ProjectReference Include="..\Martlet.Avatar.Audio2Face\Martlet.Avatar.Audio2Face.csproj" />
    <ProjectReference Include="..\Martlet.Avatar.Hosting\Martlet.Avatar.Hosting.csproj" />
    <!-- memories (memory_sync_selftest) keeps real memory stores the same through the hosts. -->
    <ProjectReference Include="..\Martlet.Memory\Martlet.Memory.csproj" />
    <!-- logs (logs_share_selftest) reads real log folders and saves the share bundle. -->
    <ProjectReference Include="..\Martlet.Diagnostics\Martlet.Diagnostics.csproj" />
  </ItemGroup>
</Project>
