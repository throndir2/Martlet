<local:ThemedWindow x:Class="Martlet.Desktop.RecommendedSetupWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}"
        Title="Martlet - Recommended setup" Width="860" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        AutomationProperties.AutomationId="RecommendedSetupWindow">
    <!-- Home's Recommended setup (MainWindow.RecommendedSetup.cs): the review of what changes on your computers. Nothing changes
         until Reconfigure. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,10" Background="{DynamicResource SoftBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="_Not now" IsCancel="True" Click="Cancel_Click" Padding="14,8" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="RecommendedSetupCancel" AutomationProperties.Name="Not now"/>
                    <Button x:Name="ApplyButton" Content="_Reconfigure" Click="Apply_Click" Padding="14,8" IsEnabled="False"
                            Style="{DynamicResource PrimaryButton}" AutomationProperties.AutomationId="RecommendedSetupApply"
                            AutomationProperties.Name="Reconfigure"/>
                    <Button x:Name="CloseButton" Content="_Close" Click="Close_Click" Padding="14,8" Visibility="Collapsed"
                            AutomationProperties.AutomationId="RecommendedSetupClose" AutomationProperties.Name="Close"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="RecommendedSetupStatus"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="900">
                <!-- A problem (Martlet can't reply) or the free-key tip (no hosted provider has a saved key): FreeKeyPrompt. -->
                <Border x:Name="Banner" Visibility="Collapsed" CornerRadius="14" Padding="16,12" BorderThickness="1" Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        AutomationProperties.AutomationId="RecommendedSetupBanner">
                    <StackPanel>
                        <TextBlock x:Name="BannerTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="RecommendedSetupBannerTitle"/>
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap" Margin="0,4,0,10"
                                   AutomationProperties.AutomationId="RecommendedSetupBannerText" AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FreeKeyAddButton" Content="Add your key" Click="FreeKeyAdd_Click" Padding="14,6" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="RecommendedSetupFreeKeyAdd"/>
                            <Button x:Name="FreeKeyGetButton" Content="Get a free key" Click="FreeKeyGet_Click" Padding="14,6"
                                    AutomationProperties.AutomationId="RecommendedSetupFreeKeyGet"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="RecommendedSetupTitle"/>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,16"
                           AutomationProperties.AutomationId="RecommendedSetupSummary"/>
                <TextBlock x:Name="OfflineText" TextWrapping="Wrap" Margin="0,-8,0,16" Visibility="Collapsed"
                           Foreground="{DynamicResource WarningBrush}" AutomationProperties.AutomationId="RecommendedSetupOffline"/>

                <!-- Your preferences (RecommendationPreferences, shared by your computers; the games answers are one per companion
                     PC): built in code by RecommendationPreferencesControls with the RecommendedSetup prefix
                     (RecommendedSetupQuality, RecommendedSetupOnline, RecommendedSetupGames-n, RecommendedSetupHearing,
                     RecommendedSetupHostShare, RecommendedSetupUseServedModels, RecommendedSetupPreferHostModels). A change saves
                     the preferences and plans again at once. -->
                <TextBlock Text="Your preferences" Style="{DynamicResource SectionHeading}"/>
                <TextBlock x:Name="PreferencesText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                           AutomationProperties.AutomationId="RecommendedSetupPreferences"
                           Text="Martlet plans with these. A change plans again at once and is saved for all your computers (each computer keeps its own games answer)."/>
                <StackPanel x:Name="PreferencesPanel" Margin="0,0,0,16" AutomationProperties.Name="Your preferences"/>

                <!-- Your choices (RecommendedSetupReview.Choices): each job's lock (RecommendedSetupLock-<job>; a change saves the
                     recommendation preferences and plans again), who does it today, Martlet's clearly better choice next to it
                     (RecommendedSetupSuggestion-<job>) and Use the suggestion (RecommendedSetupUseSuggestion-<job>), which plans that
                     job's suggestion this once. The voice always stays the owner's. Then the numbers Martlet measured instead of
                     estimating (RecommendedSetupMeasured). -->
                <StackPanel x:Name="ChoicesSection">
                    <TextBlock Text="Your choices" Style="{DynamicResource SectionHeading}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                               AutomationProperties.AutomationId="RecommendedSetupChoicesIntro"
                               Text="A locked job keeps its model: Martlet only suggests a clearly better one (smarter at the same speed, or as smart with less memory). Unlock a job to let Martlet choose. A job you change by hand locks again."/>
                    <StackPanel x:Name="ChoicesPanel" Margin="0,0,0,8" AutomationProperties.Name="Your choices"
                                AutomationProperties.AutomationId="RecommendedSetupChoices"/>
                    <TextBlock x:Name="MeasuredText" TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed"
                               Foreground="{DynamicResource MutedBrush}" AutomationProperties.AutomationId="RecommendedSetupMeasured"/>
                </StackPanel>

                <!-- Every part of Martlet in priority order (ComponentRanking): where it runs, or Off. Optional parts that run as
                     host roles have an explicit Off choice; the review then plans again without them. Vision, Reading, Hearing
                     and Smart home are this PC's choice on their Companion pages (ComponentRanking.SetOnPage). -->
                <StackPanel x:Name="PartsSection" Visibility="Collapsed">
                    <TextBlock Text="Every part, in priority order" Style="{DynamicResource SectionHeading}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                               Text="Martlet sets up the parts at the top first. Needed parts make a conversation work. Optional parts can be off: tick Off to plan without one. Vision, Reading, Hearing and Smart home are this PC's choice: turn them off on their Companion page."/>
                    <StackPanel x:Name="PartsPanel" Margin="0,0,0,16" AutomationProperties.Name="Every part, in priority order"
                                AutomationProperties.AutomationId="RecommendedSetupParts"/>
                </StackPanel>

                <StackPanel x:Name="ChangesSection">
                    <TextBlock Text="What changes, in the order Reconfigure makes them" Style="{DynamicResource SectionHeading}"/>
                    <StackPanel x:Name="ChangesPanel" Margin="0,0,0,16" AutomationProperties.Name="What changes"
                                AutomationProperties.AutomationId="RecommendedSetupChanges"/>
                </StackPanel>

                <TextBlock Text="Your computers" Style="{DynamicResource SectionHeading}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                           Text="Each bar is how full the recommended setup makes that computer, from Martlet's estimates."/>
                <StackPanel x:Name="ComputersPanel" Margin="0,0,0,16" AutomationProperties.Name="Your computers"
                            AutomationProperties.AutomationId="RecommendedSetupComputers"/>

                <TextBlock Text="Who does each job" Style="{DynamicResource SectionHeading}"/>
                <StackPanel x:Name="JobsPanel" Margin="0,0,0,16" AutomationProperties.Name="Who does each job"
                            AutomationProperties.AutomationId="RecommendedSetupJobs"/>

                <StackPanel x:Name="SituationsSection" Visibility="Collapsed">
                    <TextBlock Text="Three plans" Style="{DynamicResource SectionHeading}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                               Text="Martlet changes between these plans by itself: while a game runs on a companion PC used for games, and while a host doesn't answer. Each live job comes back when the game ends or the host answers again."/>
                    <StackPanel x:Name="SituationsPanel" Margin="0,0,0,16" AutomationProperties.Name="Three plans"
                                AutomationProperties.AutomationId="RecommendedSetupSituations"/>
                </StackPanel>

                <StackPanel x:Name="ManualSection" Visibility="Collapsed">
                    <TextBlock Text="Needs someone at the computer" Style="{DynamicResource SectionHeading}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                               Text="Martlet can't change these computers from here. Make these changes at each one, or connect it on the Devices page."/>
                    <StackPanel x:Name="ManualPanel" Margin="0,0,0,16" AutomationProperties.Name="Needs someone at the computer"/>
                </StackPanel>

                <TextBlock x:Name="DownloadsText" TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed"
                           AutomationProperties.AutomationId="RecommendedSetupDownloads"/>

                <StackPanel x:Name="PreflightSection" Visibility="Collapsed">
                    <TextBlock Text="Before it starts" Style="{DynamicResource SectionHeading}"/>
                    <StackPanel x:Name="PreflightPanel" Margin="0,0,0,8" AutomationProperties.Name="Before it starts"
                                AutomationProperties.AutomationId="RecommendedSetupPreflight"/>
                    <StackPanel x:Name="TermsSection" Visibility="Collapsed">
                        <TextBlock Text="Reconfigure accepts these terms" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <StackPanel x:Name="TermsPanel" Margin="0,0,0,8" AutomationProperties.Name="Terms you accept"/>
                    </StackPanel>
                    <StackPanel x:Name="SecretsSection" Visibility="Collapsed">
                        <TextBlock Text="Keys it needs" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                                   Text="Type each key the change needs. A change whose key you leave empty is skipped, and its computer shows it needs attention."/>
                        <StackPanel x:Name="SecretsPanel" Margin="0,0,0,8" AutomationProperties.Name="Keys it needs"/>
                    </StackPanel>
                    <Border Height="8"/>
                </StackPanel>

                <StackPanel x:Name="NotesSection" Visibility="Collapsed">
                    <TextBlock Text="Good to know" Style="{DynamicResource SectionHeading}"/>
                    <StackPanel x:Name="NotesPanel" AutomationProperties.Name="Good to know"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:ThemedWindow>
