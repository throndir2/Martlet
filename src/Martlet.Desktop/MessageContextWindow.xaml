<local:ThemedWindow x:Class="Martlet.Desktop.MessageContextWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}"
        Width="900" Height="780" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="MessageContextWindow">
    <!-- What was sent: everything one of Martlet's messages was made from, in the order the request sends it. Each section has a
         colored bar on its left; the bar at the top shows how much of the request each section takes. The text shows on this PC
         only: MCP reads the titles, sizes and shares (MessageContextSummary, MessageContextSize-*, MessageContextShare-*,
         MessageContextPart-*), never the text (MessageContextText-*). -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="22,16,22,12">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Style="{DynamicResource SectionHeading}" Margin="0,0,0,4"
                           AutomationProperties.AutomationId="MessageContextTitle"/>
                <TextBlock x:Name="SummaryText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="MessageContextSummary"/>
                <DockPanel x:Name="RequestRow" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RequestChoice" MinWidth="300" HorizontalAlignment="Left" SelectionChanged="RequestChoice_SelectionChanged"
                              ToolTip="A reply sends one request, and one more after each round of tool calls (or to ask again)."
                              AutomationProperties.Name="Which request to show" AutomationProperties.AutomationId="MessageContextRequest"/>
                </DockPanel>
                <Border CornerRadius="5" Height="10" Margin="0,12,0,0" ClipToBounds="True" Background="{DynamicResource SoftBrush}">
                    <Grid x:Name="ShareBar" AutomationProperties.AutomationId="MessageContextShareBar"
                          AutomationProperties.Name="How much of the request each section takes"/>
                </Border>
                <WrapPanel x:Name="Legend" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Close" IsCancel="True" Click="Close_Click" MinWidth="100"
                        AutomationProperties.AutomationId="MessageContextClose"/>
                <Button DockPanel.Dock="Right" x:Name="CopyAllButton" Content="Copy _all" Click="CopyAll_Click" MinWidth="110" Margin="0,0,10,0"
                        ToolTip="Copy everything this request sent, as text" AutomationProperties.AutomationId="MessageContextCopyAll"
                        AutomationProperties.HelpText="Copies everything this request sent, as text."/>
                <TextBlock Style="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Shown on this PC only, and Martlet never saves or logs it."/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="22,14,22,6" Focusable="False">
            <StackPanel x:Name="SectionsPanel" AutomationProperties.AutomationId="MessageContextSections"/>
        </ScrollViewer>
    </DockPanel>
</local:ThemedWindow>
