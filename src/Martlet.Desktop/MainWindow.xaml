<local:ThemedWindow x:Class="Martlet.Desktop.MainWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet" Width="1240" Height="820" MinWidth="900" MinHeight="580"
        Style="{DynamicResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MartletMainWindow"
        AutomationProperties.Name="Martlet"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border x:Name="NavRail" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image x:Name="RailMark" Style="{DynamicResource Mascot}" Width="40" Height="40"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="martlet" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="ModeText" Text="Companion PC" FontSize="12" Style="{DynamicResource Muted}"
                                   AutomationProperties.AutomationId="DeviceRoleSummary"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel AutomationProperties.Name="Sections">
                    <RadioButton x:Name="NavHome" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE80F;" Content="Home"
                                 IsChecked="True" Checked="Nav_Checked" AutomationProperties.AutomationId="NavHome"/>
                    <RadioButton x:Name="NavDevices" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE772;" Content="Devices"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavDevices"/>
                    <RadioButton x:Name="NavCompanion" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE76E;" Content="Companion"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavCompanion"/>
                    <RadioButton x:Name="NavConversations" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE8BD;" Content="Conversations"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavConversations"/>
                    <RadioButton x:Name="NavCreations" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE790;" Content="Creations"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavCreations"/>
                    <!-- Background tasks: its count shows how many run now (MainWindow.Tasks.cs). -->
                    <RadioButton x:Name="NavTasks" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE916;"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavTasks" AutomationProperties.Name="Background tasks">
                        <DockPanel>
                            <Border x:Name="NavTasksBadge" DockPanel.Dock="Right" Visibility="Collapsed" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="9" MinWidth="20" Height="18" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NavTasksCount" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="NavTasksCount"/>
                            </Border>
                            <TextBlock Text="Background tasks" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                    <!-- Thinking requests: every request for the Thinking pool's slots, with its timings; its count shows how many
                         wait or run now (MainWindow.ThinkingRequests.cs). -->
                    <RadioButton x:Name="NavThinkingRequests" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE82F;"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavThinkingRequests" AutomationProperties.Name="Thinking requests">
                        <DockPanel>
                            <Border x:Name="NavThinkingRequestsBadge" DockPanel.Dock="Right" Visibility="Collapsed" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="9" MinWidth="20" Height="18" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NavThinkingRequestsCount" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="NavThinkingRequestsCount"/>
                            </Border>
                            <TextBlock Text="Thinking requests" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDiagnostics" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE9D9;" Content="Diagnostics"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavDiagnostics"/>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE713;" Content="Settings"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavSettings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="PageArea" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Home: is anything wrong or missing, and Start talking (every choice is made in Companion), or the host dashboard -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,24" MaxWidth="1000">
                    <StackPanel x:Name="CompanionHome">
                        <Border x:Name="HeroCard" Style="{DynamicResource HeroCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="GreetingText" Style="{DynamicResource Eyebrow}" Text="HELLO"/>
                                    <TextBlock x:Name="StageTitle" Style="{DynamicResource HeroTitle}" Margin="0,6,0,0"
                                               Text="Let's bring your companion to life" AutomationProperties.AutomationId="StageTitle"/>
                                    <TextBlock x:Name="StageText" Style="{DynamicResource Muted}" FontSize="15" Margin="0,8,0,20" MaxWidth="560"
                                               HorizontalAlignment="Left" AutomationProperties.AutomationId="StageText"
                                               Text="First, set up how Martlet thinks. It runs on this PC by default."/>
                                    <WrapPanel>
                                        <Button x:Name="PrimaryStageButton" Style="{DynamicResource PrimaryButton}" Content="Set up thinking"
                                                Click="PrimaryStage_Click" Padding="22,12" FontSize="15" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="PrimaryStageAction"/>
                                        <!-- A new PC: join your other computers first and use their hosts (MainWindow.Health.cs) -->
                                        <Button x:Name="ConnectComputersButton" Content="Connect to your other computers" Click="ConnectComputers_Click"
                                                Padding="20,12" FontSize="15" Margin="0,0,12,8" Visibility="Collapsed"
                                                AutomationProperties.AutomationId="HomeConnectComputers"/>
                                        <Button x:Name="ListenButton" Content="Start listening" Click="Listen_Click" Padding="20,12" FontSize="15" Margin="0,0,12,8"
                                                Visibility="Collapsed" AutomationProperties.AutomationId="HomeListen"
                                                AutomationProperties.Name="Start listening"/>
                                        <!-- Start watching / Stop watching, shown while vision is on in Companion (MainWindow.BackgroundTalk.cs) -->
                                        <Button x:Name="WatchButton" Content="Start watching" Click="Watch_Click" Padding="20,12" FontSize="15" Margin="0,0,12,8"
                                                Visibility="Collapsed" AutomationProperties.AutomationId="HomeWatch"
                                                AutomationProperties.Name="Start watching"/>
                                        <Button x:Name="ConversationButton" Content="Start talking" Click="Conversation_Click" Padding="20,12" FontSize="15" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="OpenLiveConversation"
                                                AutomationProperties.Name="Start talking"/>
                                        <Button x:Name="CharacterButton" Content="Show character" Click="Character_Click" Padding="16,12" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="ToggleCharacter" AutomationProperties.Name="Show or hide the animated desktop character"/>
                                        <Button x:Name="ResetCharacterButton" Content="Reset character position" Click="ResetCharacter_Click" Padding="16,12" Margin="0,0,12,8"
                                                Visibility="Collapsed" ToolTip="Move the character back to its default position" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.AutomationId="ResetCharacterPosition" AutomationProperties.Name="Reset character position"/>
                                        <Button x:Name="ResetCharacterZoomButton" Content="Reset character zoom" Click="ResetCharacterZoom_Click" Padding="16,12" Margin="0,0,12,8"
                                                Visibility="Collapsed" ToolTip="Return the character to its default zoom"
                                                AutomationProperties.AutomationId="ResetCharacterZoom" AutomationProperties.Name="Reset character zoom"/>
                                    </WrapPanel>
                                    <!-- Character profiles (MainWindow.CharacterProfiles.cs): switch look, voice and personality at once -->
                                    <WrapPanel x:Name="HomeCharacterRow" Margin="0,0,0,8" Visibility="Collapsed">
                                        <Label x:Name="HomeCharacterLabel" Content="C_haracter" Target="{Binding ElementName=HomeCharacterChoice}"
                                               VerticalAlignment="Center" Padding="0,4,10,4"/>
                                        <ComboBox x:Name="HomeCharacterChoice" MinWidth="220" MaxWidth="360" MinHeight="30" VerticalAlignment="Center"
                                                  SelectionChanged="HomeCharacter_SelectionChanged"
                                                  AutomationProperties.AutomationId="HomeCharacterProfile" AutomationProperties.Name="Character profile"/>
                                        <Button x:Name="HomeCharacterManage" Style="{DynamicResource LinkButton}" Content="Manage profiles" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Click="HomeCharacterManage_Click"
                                                AutomationProperties.AutomationId="HomeManageCharacters"/>
                                    </WrapPanel>
                                    <!-- Whether Martlet is listening and watching (MainWindow.BackgroundTalk.cs), with or without the talk window -->
                                    <WrapPanel>
                                        <Border x:Name="ListeningIndicator" Visibility="Collapsed" HorizontalAlignment="Left" CornerRadius="14"
                                                Padding="12,6" Margin="0,2,8,8" BorderThickness="1" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ListeningDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="ListeningStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                                           AutomationProperties.AutomationId="HomeListeningStatus" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="WatchingIndicator" Visibility="Collapsed" HorizontalAlignment="Left" CornerRadius="14"
                                                Padding="12,6" Margin="0,2,8,8" BorderThickness="1" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="WatchingDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="WatchingStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                                           AutomationProperties.AutomationId="HomeWatchingStatus" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Configuring your computers (MainWindow.RecommendedSetupApply.cs): a run applying the recommended setup,
                                             a host role being changed or this PC following a plan change. Opens the Devices map. -->
                                        <Button x:Name="ConfiguringIndicator" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,6" Margin="0,2,8,8"
                                                Click="Configuring_Click" Cursor="Hand" ToolTip="See your computers on the Devices map"
                                                AutomationProperties.AutomationId="HomeConfiguring" AutomationProperties.Name="Configuring your computers">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ConfiguringDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource AccentBrush}"/>
                                                <TextBlock x:Name="ConfiguringStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                                           AutomationProperties.AutomationId="HomeConfiguringStatus" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <!-- The best use of all your computers, reviewed before anything changes (MainWindow.RecommendedSetup.cs) -->
                                        <Button x:Name="RecommendedSetupButton" Content="Reco_mmended setup" Click="RecommendedSetup_Click"
                                                Padding="16,8" Margin="0,0,16,8" VerticalAlignment="Center"
                                                ToolTip="Work out the best use of all your computers and review the changes before anything changes"
                                                AutomationProperties.AutomationId="HomeRecommendedSetup" AutomationProperties.Name="Recommended setup"/>
                                        <Button x:Name="AdvisorButton" Style="{DynamicResource LinkButton}" Content="Plan a setup from scratch"
                                                Click="Advisor_Click" AutomationProperties.AutomationId="OpenSetupAdvisor" VerticalAlignment="Center"
                                                Margin="0,0,0,8" AutomationProperties.Name="Plan a setup from scratch"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="190" Height="190" Margin="20,0,0,0" IsHitTestVisible="False" Focusable="False"
                                         VerticalAlignment="Center">
                                    <Canvas Width="120" Height="120">
                                        <Ellipse x:Name="HeroGlow" Width="104" Height="104" Canvas.Left="8" Canvas.Top="10" Fill="{DynamicResource GlowBrush}" Opacity="0.7"
                                                 RenderTransformOrigin="0.5,0.5"/>
                                        <Canvas x:Name="HeroFloat" Width="120" Height="120">
                                            <Image x:Name="HeroMascot" Style="{DynamicResource Mascot}" Width="92" Height="92" Canvas.Left="14" Canvas.Top="16"/>
                                        </Canvas>
                                        <Path x:Name="Sparkle1" Canvas.Left="84" Canvas.Top="2" Data="M 9 0 L 11.5 6.5 L 18 9 L 11.5 11.5 L 9 18 L 6.5 11.5 L 0 9 L 6.5 6.5 Z"
                                              Fill="{DynamicResource AccentBrush}"/>
                                        <Path x:Name="Sparkle2" Canvas.Left="6" Canvas.Top="88" Data="M 6 0 L 7.7 4.3 L 12 6 L 7.7 7.7 L 6 12 L 4.3 7.7 L 0 6 L 4.3 4.3 Z"
                                              Fill="{DynamicResource AccentBrush}"/>
                                        <Path x:Name="Sparkle3" Canvas.Left="100" Canvas.Top="84" Data="M 5 0 L 6.4 3.6 L 10 5 L 6.4 6.4 L 5 10 L 3.6 6.4 L 0 5 L 3.6 3.6 Z"
                                              Fill="{DynamicResource AccentBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- What needs attention: problems, warnings and good-to-know items, each with its fixes (MainWindow.Health.cs) -->
                        <Border x:Name="AttentionCard" Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="HealthRecheckButton" DockPanel.Dock="Right" Content="Check _again" Click="HealthRecheck_Click"
                                            VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.AutomationId="HealthRecheck"
                                            AutomationProperties.Name="Check again"/>
                                    <StackPanel>
                                        <TextBlock x:Name="HealthTitle" Text="Needs attention" Style="{DynamicResource SectionHeading}" Margin="0,0,0,2"
                                                   AutomationProperties.AutomationId="HealthTitle"/>
                                        <TextBlock x:Name="HealthSummary" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="HealthSummary" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="HealthIssues" AutomationProperties.Name="What needs attention" AutomationProperties.AutomationId="HealthIssues"/>
                            </StackPanel>
                        </Border>

                        <!-- Health: every part Martlet checks, one tile each; a tile only opens where that part is changed -->
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Health" Style="{DynamicResource SectionHeading}" Margin="0,0,0,2"/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           Text="Select a part of Martlet to see or change it."/>
                                <UniformGrid x:Name="HealthChecks" Columns="3" SizeChanged="HealthChecks_SizeChanged"
                                             AutomationProperties.Name="Health checks" AutomationProperties.AutomationId="HealthChecks"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HostHome" Visibility="Collapsed">
                        <!-- The way back comes first: a host PC doesn't talk or listen, and one click makes it your companion PC again. -->
                        <Border x:Name="SwitchToCompanionCard" Style="{DynamicResource CardStyle}" Padding="20,16"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Content="Switch to companion PC"
                                        Click="UseCompanion_Click" Padding="20,12" FontSize="15" Margin="16,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="SwitchToCompanion"/>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE76E;" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Want to talk with Martlet on this PC?" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0"
                                               Text="As a host PC, it doesn't talk or listen. Switch to make it your companion PC."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{DynamicResource HeroCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Eyebrow}" Text="HOST SERVICE"/>
                                    <TextBlock Style="{DynamicResource HeroTitle}" Margin="0,6,0,0" Text="This PC is a Martlet host"/>
                                    <TextBlock Style="{DynamicResource Muted}" FontSize="15" Margin="0,8,0,14" MaxWidth="560" HorizontalAlignment="Left"
                                               Text="Use this PC for heavier Martlet tasks from your main PC. Connect to:"/>
                                    <Border Style="{DynamicResource Chip}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,18">
                                        <TextBlock x:Name="HostAddressText" FontFamily="Consolas" FontSize="15" TextWrapping="NoWrap"
                                                   AutomationProperties.AutomationId="HostServiceAddress"/>
                                    </Border>
                                    <WrapPanel>
                                        <Button x:Name="CheckHostServiceButton" Content="Check again"
                                                Click="CheckHostService_Click" Padding="20,12" Margin="0,0,12,8"
                                                AutomationProperties.Name="Check the host service again"
                                                AutomationProperties.AutomationId="CheckHostService"/>
                                        <Button Content="Show host status" Click="HostStatusConsole_Click" Padding="16,12" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="HostStatusConsole"/>
                                    </WrapPanel>
                                    <!-- Configuring your computers, as on the companion Home (MainWindow.RecommendedSetupApply.cs). -->
                                    <Button x:Name="HostConfiguringIndicator" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,6" Margin="0,2,8,8"
                                            Click="Configuring_Click" Cursor="Hand" ToolTip="See your computers on the Devices map"
                                            AutomationProperties.AutomationId="HostConfiguring" AutomationProperties.Name="Configuring your computers">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HostConfiguringDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="HostConfiguringStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                                       AutomationProperties.AutomationId="HostConfiguringStatus" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="170" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                                        <Ellipse x:Name="HostPulse" Fill="{DynamicResource GlowBrush}" RenderTransformOrigin="0.5,0.5" Opacity="0"/>
                                        <Ellipse Width="96" Height="96" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}"/>
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="40" Text="&#xE7F4;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="HostStatusText" Margin="0,136,0,0" TextAlignment="Center" FontWeight="SemiBold"
                                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostServiceStatus"
                                               Text="Checking..."/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="HostStepsHeading" Text="Get this host running" Style="{DynamicResource SectionHeading}"
                                           AutomationProperties.AutomationId="HostStepsHeading"/>
                                <TextBlock x:Name="HostStepsSummary" Style="{DynamicResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostStepsSummary"
                                           Text="Checking this PC's host service..."/>
                                <!-- The setup runs working now (they run side by side), each with its status line. -->
                                <TextBlock x:Name="HostRunsText" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostRunsNow"/>
                                <!-- What Martlet did by itself when this PC became (or started as) a host PC: Docker Desktop and the roles, warm. -->
                                <TextBlock x:Name="HostAutoStartText" Style="{DynamicResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostAutoStart"/>
                                <StackPanel x:Name="HostStepsPanel" AutomationProperties.Name="Host setup steps"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Good to know" Style="{DynamicResource SectionHeading}"/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap" Text="&#x2022; Paired computers connect only on your private network. Your other computers can find this PC there and ask to pair; you allow each one here."/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,4" Text="&#x2022; Lip-sync may send generated voice here. Microphone audio and files stay on your main PC."/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,10" Text="&#x2022; GPU tasks need an NVIDIA graphics card, current drivers and Docker Desktop."/>
                                <Button Style="{DynamicResource LinkButton}" Content="Set up a host on another computer" Click="Hosts_Click"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Devices: the map of computers and services on top, then the selected device's jobs and settings, then settings for all devices -->
            <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" SizeChanged="DevicesPage_SizeChanged">
                <StackPanel Margin="36,30,36,24" MaxWidth="1100">
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Map or list (MainWindow.DeviceList.cs): the list shows by itself once the map can't fit every device. -->
                            <RadioButton x:Name="DevicesViewMap" GroupName="DevicesView" Style="{DynamicResource FilterPill}" Margin="0,0,6,0"
                                         VerticalAlignment="Center" Checked="DevicesView_Checked"
                                         AutomationProperties.AutomationId="DevicesViewMap" AutomationProperties.Name="Show devices as a map">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{DynamicResource Icon}" FontSize="13" Text="&#xE968;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Map" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DevicesViewList" GroupName="DevicesView" Style="{DynamicResource FilterPill}" Margin="0,0,16,0"
                                         VerticalAlignment="Center" Checked="DevicesView_Checked"
                                         AutomationProperties.AutomationId="DevicesViewList" AutomationProperties.Name="Show devices as a list">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{DynamicResource Icon}" FontSize="13" Text="&#xE8FD;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="List" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <Button Content="Refresh" Click="RefreshDevices_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="RefreshDevices"/>
                            <Button Content="Add a computer" Style="{DynamicResource PrimaryButton}" Click="Hosts_Click"
                                    AutomationProperties.AutomationId="AddComputer"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Your devices" Style="{DynamicResource PageTitle}"/>
                            <TextBlock x:Name="DevicesSummary" Style="{DynamicResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap"
                                       Text="Select a computer or service to see details."
                                       AutomationProperties.AutomationId="DevicesSummary" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="MapHost" CornerRadius="24" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,18" Height="380" SizeChanged="MapHost_SizeChanged" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="8">
                            <Canvas x:Name="MapCanvas" Width="900" Height="364" AutomationProperties.Name="Device map"/>
                        </Viewbox>
                    </Border>
                    <!-- Every device as a grid of cards, filtered and searched; it scrolls on its own so the details stay close. -->
                    <StackPanel x:Name="DeviceListHost" Visibility="Collapsed" Margin="0,0,0,18">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,6">
                                <Label Content="_Find" Target="{Binding ElementName=DeviceSearch}" Padding="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="DeviceSearch" Width="220" MaxLength="100" VerticalAlignment="Center" TextChanged="DeviceSearch_Changed"
                                         AutomationProperties.AutomationId="DeviceSearch" AutomationProperties.Name="Find a device by name, status or job"/>
                            </StackPanel>
                            <WrapPanel x:Name="DeviceFilters" VerticalAlignment="Center" AutomationProperties.Name="Show devices"/>
                        </DockPanel>
                        <TextBlock x:Name="DeviceListStatus" Style="{DynamicResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="DeviceListStatus" AutomationProperties.LiveSetting="Polite"/>
                        <Border CornerRadius="24" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Padding="14,14,4,4">
                            <ScrollViewer x:Name="DeviceListScroll" VerticalScrollBarVisibility="Auto" MaxHeight="420"
                                          SizeChanged="DeviceListScroll_SizeChanged">
                                <UniformGrid x:Name="DeviceList" Columns="4" VerticalAlignment="Top" AutomationProperties.Name="Devices"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="RolesCoverage" AutomationProperties.Name="What isn't working right now"/>
                    <Border x:Name="DetailCard" Style="{DynamicResource CardStyle}" Padding="26,22">
                        <StackPanel x:Name="DetailContent" AutomationProperties.Name="Selected device" AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                    <!-- What your computers can run: parts covered here, online or not at all, the totals and what else fits (MainWindow.DeviceCapacity.cs) -->
                    <Border x:Name="CapacityCard" Style="{DynamicResource CardStyle}" Padding="26,22" Visibility="Collapsed"
                            AutomationProperties.AutomationId="CapacityCard" AutomationProperties.Name="What your computers can run">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE9D9;" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="What your computers can run" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="From Martlet's estimates of what each part needs. Select a computer above to see its share."/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="CapacityCoverageText" TextWrapping="Wrap" Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="CapacityCoverage"/>
                            <TextBlock x:Name="CapacityTotalsText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="CapacityTotals"/>
                            <TextBlock x:Name="CapacityFitsText" TextWrapping="Wrap" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="CapacityFits"/>
                        </StackPanel>
                    </Border>
                    <!-- Your Martlet network: the owner's computers that trust each other (MainWindow.Network.cs) -->
                    <Border x:Name="NetworkCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Your Martlet network">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="NetworkCheckButton" DockPanel.Dock="Right" Content="Check now" Click="NetworkCheck_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="NetworkCheck" AutomationProperties.Name="Check your Martlet network now"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE968;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Your Martlet network" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Pair a host once: every computer in your network can use it and pairs with it by itself."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="NetworkStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="NetworkStatus" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="NetworkJoinsPanel" AutomationProperties.Name="Computers asking to join"/>
                            <StackPanel x:Name="NetworkMembersPanel" AutomationProperties.Name="Computers in your network"/>
                        </StackPanel>
                    </Border>
                    <!-- Friends: who your hosts' engines are shared with, per person, across your hosts (MainWindow.Friends.cs, docs/NETWORK.md) -->
                    <Border x:Name="FriendsCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Friends" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="FriendsCheckButton" DockPanel.Dock="Right" Content="Check now" Click="FriendsCheck_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="FriendsCheck" AutomationProperties.Name="Read who your hosts are shared with now"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE716;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Friends" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Share a host's engines with a friend's Martlet. They sign in with their own account and never join your network."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="FriendsStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="FriendsStatus" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="FriendsPanel" AutomationProperties.Name="Your friends and the hosts you share with them"/>
                        </StackPanel>
                    </Border>
                    <!-- Hosts shared with this PC: friends' hosts this PC signed in to as a friend; their engines only (MainWindow.Friends.cs) -->
                    <Border x:Name="SharedHostsCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Hosts shared with this PC" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="SharedHostsCheckButton" DockPanel.Dock="Right" Content="Check now" Click="SharedHostsCheck_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="SharedHostsCheck" AutomationProperties.Name="Check the hosts friends share with this PC now"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE72D;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Hosts shared with this PC" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Friends' hosts you signed in to as a friend. This PC may use their engines; their owners' own work comes first."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="SharedHostsStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SharedHostsStatus" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="SharedHostsPanel" AutomationProperties.Name="Hosts friends share with this PC"/>
                        </StackPanel>
                    </Border>
                    <!-- Sharing work: which computers take a job when the one doing it is busy (MainWindow.WorkSharing.cs, docs/CLUSTER.md) -->
                    <Border x:Name="WorkSharingCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Sharing work">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE8AB;" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sharing work" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Each job's page lists the machines that do it, in order: when the first is busy, the next one takes it. The lists are the same on all your computers."/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="WorkSharingStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="WorkSharingStatus" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="WorkSharingJobsPanel" AutomationProperties.Name="Jobs your computers share"/>
                            <StackPanel x:Name="WorkSharingHostsPanel" AutomationProperties.Name="Computers kept for one companion PC"/>
                        </StackPanel>
                    </Border>
                    <!-- Apps and API keys: keys that software outside the network uses to call your hosts (MainWindow.ApiKeys.cs, docs/API.md) -->
                    <Border x:Name="ApiKeysCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Apps and API keys">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="ApiKeyCreateButton" DockPanel.Dock="Right" Content="Create API key" Click="ApiKeyCreate_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="ApiKeyCreate" AutomationProperties.Name="Create an API key"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE8D7;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Apps and API keys" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Let other apps and scripts, such as Home Assistant, use your hosts. Each key works on every host in your network."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="ApiKeysStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ApiKeysStatus" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="ApiKeysPanel" AutomationProperties.Name="API keys"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RolesCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Settings for all devices">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="CheckHostsButton" DockPanel.Dock="Right" Content="Check all hosts" Click="CheckHosts_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="CheckHosts"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE713;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Settings for all devices" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" Text="These apply to every computer at once."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{DynamicResource CanvasBrush}" CornerRadius="14" Padding="16,12">
                                <StackPanel>
                                    <CheckBox x:Name="ClusterSyncChoice" Checked="ClusterSync_Changed" Unchecked="ClusterSync_Changed"
                                              Content="Keep Martlet the same on all my computers"
                                              ToolTip="Martlet is one app on all your computers: who does what, its settings (how it thinks, listens and speaks with your API keys, its character, personality, replies and the rest), what it remembers, your characters, what it makes (Creations) and Home Assistant travel through your paired hosts. The people Martlet recognizes by voice are always shared with your computers, even while this is off. Audio devices, cameras and what this PC itself is stay with each computer. No conversations are shared."
                                              AutomationProperties.AutomationId="ClusterSync"/>
                                    <TextBlock x:Name="ClusterStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,2,0,0"
                                               AutomationProperties.AutomationId="ClusterStatus" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="SettingsSyncStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,6,0,0"
                                               AutomationProperties.AutomationId="SettingsSyncStatus" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="MemorySyncStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,4,0,0"
                                               Text="Memories: not synced yet."
                                               AutomationProperties.AutomationId="MemorySyncStatus" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="SettingsSyncWaitingText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,4,0,0"
                                               Visibility="Collapsed" AutomationProperties.AutomationId="SettingsSyncWaiting"/>
                                    <Button x:Name="SettingsSyncClaimButton" Content="Use this PC's settings on all my computers" Margin="24,8,0,0"
                                            HorizontalAlignment="Left" Click="SettingsSyncClaim_Click"
                                            ToolTip="If your computers disagree, make every one of them use what this PC has now."
                                            AutomationProperties.AutomationId="SettingsSyncClaim"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="UnassignedJobs" AutomationProperties.Name="Jobs nobody does yet"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Companion: the one place each choice is made: a side list of pages in groups, and the open page (built in MainWindow.Companion.cs). Home only shows status. -->
            <Grid x:Name="CompanionPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CompanionNav" Width="190" Margin="12,30,12,24"
                                    AutomationProperties.Name="Companion pages" AutomationProperties.AutomationId="CompanionNav"/>
                    </ScrollViewer>
                </Border>
                <ScrollViewer x:Name="CompanionScroll" AutomationProperties.AutomationId="CompanionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CompanionContent" Margin="32,30,32,24" MaxWidth="1000" AutomationProperties.AutomationId="CompanionPage"/>
                </ScrollViewer>
            </Grid>

            <!-- Conversations: the record of every conversation, from this PC and the messaging apps, to read, search, edit and
                 delete (ConversationsView.xaml; MainWindow.Shell.cs shows it). -->
            <local:ConversationsView x:Name="ConversationsPage" Visibility="Collapsed" MaxWidth="1200"/>

            <!-- Creations: everything Martlet made, kept the same on all the owner's computers (MainWindow.Creations.cs, docs/CREATIONS.md).
                 No Play, Show or Activate here: Martlet performs its creations itself when asked. -->
            <ScrollViewer x:Name="CreationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,24" MaxWidth="1100" AutomationProperties.AutomationId="CreationsPage">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Creations" Style="{DynamicResource PageTitle}"/>
                        <TextBlock Style="{DynamicResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap"
                                   Text="Everything Martlet makes, kept on all your computers."/>
                        <TextBlock x:Name="CreationsNoteText" Margin="0,6,12,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="Ask Martlet to sing or show any of these." AutomationProperties.AutomationId="CreationsNote"/>
                    </StackPanel>
                    <TextBlock x:Name="CreationsSummaryText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="CreationsSummary" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="CreationsStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,14"
                               AutomationProperties.AutomationId="CreationsStatus" AutomationProperties.LiveSetting="Polite"/>
                    <Border x:Name="CreationsEmptyCard" Style="{DynamicResource CardStyle}" Padding="26,22" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE790;" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock x:Name="CreationsEmptyText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="15"
                                       Text="Things Martlet makes, like songs, appear here." AutomationProperties.AutomationId="CreationsEmpty"/>
                        </StackPanel>
                    </Border>
                    <Grid x:Name="CreationsContent" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" MinWidth="280"/>
                            <ColumnDefinition Width="7*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CreationsList" AutomationProperties.Name="Your creations" AutomationProperties.AutomationId="CreationsList"/>
                        <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Padding="26,22" Margin="18,0,0,0" VerticalAlignment="Top">
                            <StackPanel x:Name="CreationDetail" AutomationProperties.Name="Selected creation" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Background tasks: the long steps Martlet runs in a run window (setting up or updating a computer, a download, pairing),
                 running or finished this session. Hiding a run window keeps it running here; Show brings it back and Cancel asks
                 first (MainWindow.Tasks.cs, BackgroundTasks.cs). -->
            <ScrollViewer x:Name="TasksPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,24" MaxWidth="1000" AutomationProperties.AutomationId="TasksPage">
                    <DockPanel Margin="0,0,0,14">
                        <Button x:Name="TasksClearButton" DockPanel.Dock="Right" VerticalAlignment="Top" Content="C_lear finished"
                                Click="TasksClear_Click" AutomationProperties.AutomationId="TasksClear"
                                AutomationProperties.Name="Clear finished tasks from the list"/>
                        <StackPanel>
                            <TextBlock Text="Background tasks" Style="{DynamicResource PageTitle}"/>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap"
                                       Text="Setting up your computers, downloads and other long steps. Hiding their window keeps them running here."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="TasksSummaryText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                               AutomationProperties.AutomationId="TasksSummary" AutomationProperties.LiveSetting="Polite"/>
                    <Border x:Name="TasksEmptyCard" Style="{DynamicResource CardStyle}" Padding="26,22">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE916;" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="15" AutomationProperties.AutomationId="TasksEmpty"
                                       Text="Long steps, like setting up a computer or a download, show here while they run."/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="TasksList" AutomationProperties.Name="Background tasks, newest first" AutomationProperties.AutomationId="TasksList"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Thinking requests: every request for the Thinking pool's slots (judges, summaries, check-ins, memory, naming, touch
                 zones, thinking longer, research): what it is for, the companion it is for, where it runs, its tries and how long it
                 waited and ran (MainWindow.ThinkingRequests.cs, ThinkingRequests.cs). -->
            <Grid x:Name="ThinkingRequestsPage" Visibility="Collapsed" Margin="36,30,36,16" AutomationProperties.AutomationId="ThinkingRequestsPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="ThinkingRequestsCopyButton" Content="_Copy shown" Click="ThinkingRequestsCopy_Click" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="ThinkingRequestsCopy" AutomationProperties.Name="Copy the shown requests with their timings"/>
                        <Button x:Name="ThinkingRequestsClearButton" Content="C_lear finished" Click="ThinkingRequestsClear_Click"
                                AutomationProperties.AutomationId="ThinkingRequestsClear" AutomationProperties.Name="Clear finished requests from the list"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Thinking requests" Style="{DynamicResource PageTitle}"/>
                        <TextBlock Style="{DynamicResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap"
                                   Text="Everything your companions ask the Thinking pool to do: what it is for, where it runs, how long it waits and runs, and what it answers."/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock x:Name="ThinkingRequestsSummary" TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="ThinkingRequestsSummary" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="ThinkingRequestsPool" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                               AutomationProperties.AutomationId="ThinkingRequestsPool"/>
                </StackPanel>
                <Expander Grid.Row="2" x:Name="ThinkingRequestsTimingExpander" Header="_Timing by type" Margin="0,0,0,10" IsExpanded="False"
                          AutomationProperties.AutomationId="ThinkingRequestsTimingExpander" AutomationProperties.Name="Timing by type since Martlet started">
                    <Border Style="{DynamicResource CardStyle}" Padding="16,10" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Every request that ended since Martlet started, by type. Wait is the time in line; run is the time on a computer."/>
                            <TextBlock x:Name="ThinkingRequestsTiming" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                       AutomationProperties.AutomationId="ThinkingRequestsTiming"/>
                        </StackPanel>
                    </Border>
                </Expander>
                <DockPanel Grid.Row="3" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="T_ype" Target="{Binding ElementName=ThinkingRequestsKind}" Padding="0,0,8,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThinkingRequestsKind" Width="170" SelectionChanged="ThinkingRequestsFilter_Changed"
                                  AutomationProperties.AutomationId="ThinkingRequestsKind" AutomationProperties.Name="Show requests of type"/>
                    </StackPanel>
                    <WrapPanel x:Name="ThinkingRequestsFilters" VerticalAlignment="Center" AutomationProperties.Name="Show">
                        <RadioButton x:Name="ThinkingRequestsShowAll" GroupName="ThinkingRequestsShow" Content="_All" IsChecked="True" Margin="0,0,16,0"
                                     Checked="ThinkingRequestsFilter_Changed" AutomationProperties.AutomationId="ThinkingRequestsFilter-all"/>
                        <RadioButton x:Name="ThinkingRequestsShowActive" GroupName="ThinkingRequestsShow" Content="Waiting or _running" Margin="0,0,16,0"
                                     Checked="ThinkingRequestsFilter_Changed" AutomationProperties.AutomationId="ThinkingRequestsFilter-active"/>
                        <RadioButton x:Name="ThinkingRequestsShowProblems" GroupName="ThinkingRequestsShow" Content="_Problems and retries"
                                     Checked="ThinkingRequestsFilter_Changed" AutomationProperties.AutomationId="ThinkingRequestsFilter-problems"/>
                    </WrapPanel>
                </DockPanel>
                <Grid Grid.Row="4">
                    <ListBox x:Name="ThinkingRequestsList" SelectionChanged="ThinkingRequestsList_SelectionChanged" BorderThickness="1"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="ThinkingRequestsList" AutomationProperties.Name="Thinking requests: waiting and running first, then the newest">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{DynamicResource Icon}" FontSize="13" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="State" Text="{Binding State}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Task}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Where}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Origin}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                                               ToolTip="The companion it is for"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Waited}" VerticalAlignment="Center" ToolTip="Time in line"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Ran}" VerticalAlignment="Center" ToolTip="Time on a computer"/>
