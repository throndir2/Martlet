                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Level" Grid.Column="1" Text="{Binding Level}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Where}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Headline}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="1">
