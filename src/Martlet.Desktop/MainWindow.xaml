<local:ThemedWindow x:Class="Martlet.Desktop.MainWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet" Width="1240" Height="820" MinWidth="900" MinHeight="580"
        Style="{DynamicResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MartletMainWindow"
        AutomationProperties.Name="Martlet"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image x:Name="RailMark" Style="{DynamicResource Mascot}" Width="40" Height="40"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="martlet" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="ModeText" Text="Companion PC" FontSize="12" Style="{DynamicResource Muted}"
                                   AutomationProperties.AutomationId="DeviceRoleSummary"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel AutomationProperties.Name="Sections">
                    <RadioButton x:Name="NavHome" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE80F;" Content="Home"
                                 IsChecked="True" Checked="Nav_Checked" AutomationProperties.AutomationId="NavHome"/>
                    <RadioButton x:Name="NavDevices" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE772;" Content="Devices"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavDevices"/>
                    <RadioButton x:Name="NavCompanion" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE76E;" Content="Companion"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavCompanion"/>
                    <RadioButton x:Name="NavDiagnostics" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE9D9;" Content="Diagnostics"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavDiagnostics"/>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{DynamicResource NavItem}" Tag="&#xE713;" Content="Settings"
                                 Checked="Nav_Checked" AutomationProperties.AutomationId="NavSettings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Home: is anything wrong or missing, and Start talking (every choice is made in Companion), or the host dashboard -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,24" MaxWidth="1000">
                    <StackPanel x:Name="CompanionHome">
                        <Border x:Name="HeroCard" Style="{DynamicResource HeroCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="GreetingText" Style="{DynamicResource Eyebrow}" Text="HELLO"/>
                                    <TextBlock x:Name="StageTitle" Style="{DynamicResource HeroTitle}" Margin="0,6,0,0"
                                               Text="Let's bring your companion to life" AutomationProperties.AutomationId="StageTitle"/>
                                    <TextBlock x:Name="StageText" Style="{DynamicResource Muted}" FontSize="15" Margin="0,8,0,20" MaxWidth="560"
                                               HorizontalAlignment="Left" AutomationProperties.AutomationId="StageText"
                                               Text="First, set up how Martlet thinks. It runs on this PC by default."/>
                                    <WrapPanel>
                                        <Button x:Name="PrimaryStageButton" Style="{DynamicResource PrimaryButton}" Content="Set up thinking"
                                                Click="PrimaryStage_Click" Padding="22,12" FontSize="15" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="PrimaryStageAction"/>
                                        <Button x:Name="ListenButton" Content="Start _listening" Click="Listen_Click" Padding="20,12" FontSize="15" Margin="0,0,12,8"
                                                Visibility="Collapsed" AutomationProperties.AutomationId="HomeListen"
                                                AutomationProperties.Name="Start listening"/>
                                        <Button x:Name="ConversationButton" Content="Start _talking" Click="Conversation_Click" Padding="20,12" FontSize="15" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="OpenLiveConversation"
                                                AutomationProperties.Name="Start talking"/>
                                        <Button x:Name="CharacterButton" Content="Show _character" Click="Character_Click" Padding="16,12" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="ToggleCharacter" AutomationProperties.Name="Show or hide the animated desktop character"/>
                                        <Button x:Name="ResetCharacterButton" Content="_Reset character position" Click="ResetCharacter_Click" Padding="16,12" Margin="0,0,12,8"
                                                Visibility="Collapsed" ToolTip="Move the character back to its default position"
                                                AutomationProperties.AutomationId="ResetCharacterPosition" AutomationProperties.Name="Reset character position"/>
                                        <Button x:Name="ResetCharacterZoomButton" Content="Reset character _zoom" Click="ResetCharacterZoom_Click" Padding="16,12" Margin="0,0,12,8"
                                                Visibility="Collapsed" ToolTip="Return the character to its default zoom"
                                                AutomationProperties.AutomationId="ResetCharacterZoom" AutomationProperties.Name="Reset character zoom"/>
                                    </WrapPanel>
                                    <!-- Whether Martlet is listening (MainWindow.BackgroundTalk.cs), with or without the talk window -->
                                    <Border x:Name="ListeningIndicator" Visibility="Collapsed" HorizontalAlignment="Left" CornerRadius="14"
                                            Padding="12,6" Margin="0,2,0,8" BorderThickness="1" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ListeningDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="ListeningStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                                       AutomationProperties.AutomationId="HomeListeningStatus" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button x:Name="AdvisorButton" Style="{DynamicResource LinkButton}" Content="Get a setup recommendation"
                                                Click="Advisor_Click" AutomationProperties.AutomationId="OpenSetupAdvisor"
                                                AutomationProperties.Name="Get a setup recommendation"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="190" Height="190" Margin="20,0,0,0" IsHitTestVisible="False" Focusable="False"
                                         VerticalAlignment="Center">
                                    <Canvas Width="120" Height="120">
                                        <Ellipse x:Name="HeroGlow" Width="104" Height="104" Canvas.Left="8" Canvas.Top="10" Fill="{DynamicResource GlowBrush}" Opacity="0.7"
                                                 RenderTransformOrigin="0.5,0.5"/>
                                        <Canvas x:Name="HeroFloat" Width="120" Height="120">
                                            <Image x:Name="HeroMascot" Style="{DynamicResource Mascot}" Width="92" Height="92" Canvas.Left="14" Canvas.Top="16"/>
                                        </Canvas>
                                        <Path x:Name="Sparkle1" Canvas.Left="84" Canvas.Top="2" Data="M 9 0 L 11.5 6.5 L 18 9 L 11.5 11.5 L 9 18 L 6.5 11.5 L 0 9 L 6.5 6.5 Z"
                                              Fill="{DynamicResource AccentBrush}"/>
                                        <Path x:Name="Sparkle2" Canvas.Left="6" Canvas.Top="88" Data="M 6 0 L 7.7 4.3 L 12 6 L 7.7 7.7 L 6 12 L 4.3 7.7 L 0 6 L 4.3 4.3 Z"
                                              Fill="{DynamicResource AccentBrush}"/>
                                        <Path x:Name="Sparkle3" Canvas.Left="100" Canvas.Top="84" Data="M 5 0 L 6.4 3.6 L 10 5 L 6.4 6.4 L 5 10 L 3.6 6.4 L 0 5 L 3.6 3.6 Z"
                                              Fill="{DynamicResource AccentBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- What needs attention: problems, warnings and good-to-know items, each with its fixes (MainWindow.Health.cs) -->
                        <Border x:Name="AttentionCard" Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="HealthRecheckButton" DockPanel.Dock="Right" Content="Check _again" Click="HealthRecheck_Click"
                                            VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.AutomationId="HealthRecheck"
                                            AutomationProperties.Name="Check again"/>
                                    <StackPanel>
                                        <TextBlock x:Name="HealthTitle" Text="Needs attention" Style="{DynamicResource SectionHeading}" Margin="0,0,0,2"
                                                   AutomationProperties.AutomationId="HealthTitle"/>
                                        <TextBlock x:Name="HealthSummary" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="HealthSummary" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="HealthIssues" AutomationProperties.Name="What needs attention" AutomationProperties.AutomationId="HealthIssues"/>
                            </StackPanel>
                        </Border>

                        <!-- Health: every part Martlet checks, one tile each; a tile only opens where that part is changed -->
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Health" Style="{DynamicResource SectionHeading}" Margin="0,0,0,2"/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           Text="Select a part of Martlet to see or change it."/>
                                <UniformGrid x:Name="HealthChecks" Columns="3" SizeChanged="HealthChecks_SizeChanged"
                                             AutomationProperties.Name="Health checks" AutomationProperties.AutomationId="HealthChecks"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HostHome" Visibility="Collapsed">
                        <Border Style="{DynamicResource HeroCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Eyebrow}" Text="HOST SERVICE"/>
                                    <TextBlock Style="{DynamicResource HeroTitle}" Margin="0,6,0,0" Text="This PC is a Martlet host"/>
                                    <TextBlock Style="{DynamicResource Muted}" FontSize="15" Margin="0,8,0,14" MaxWidth="560" HorizontalAlignment="Left"
                                               Text="Use this PC for heavier Martlet tasks from your main PC. Connect to:"/>
                                    <Border Style="{DynamicResource Chip}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,18">
                                        <TextBlock x:Name="HostAddressText" FontFamily="Consolas" FontSize="15" TextWrapping="NoWrap"
                                                   AutomationProperties.AutomationId="HostServiceAddress"/>
                                    </Border>
                                    <WrapPanel>
                                        <Button x:Name="CheckHostServiceButton" Content="Check again"
                                                Click="CheckHostService_Click" Padding="20,12" Margin="0,0,12,8"
                                                AutomationProperties.Name="Check the host service again"
                                                AutomationProperties.AutomationId="CheckHostService"/>
                                        <Button Content="Show host status" Click="HostStatusConsole_Click" Padding="16,12" Margin="0,0,12,8"
                                                AutomationProperties.AutomationId="HostStatusConsole"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="170" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                                        <Ellipse x:Name="HostPulse" Fill="{DynamicResource GlowBrush}" RenderTransformOrigin="0.5,0.5" Opacity="0"/>
                                        <Ellipse Width="96" Height="96" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}"/>
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="40" Text="&#xE7F4;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="HostStatusText" Margin="0,136,0,0" TextAlignment="Center" FontWeight="SemiBold"
                                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostServiceStatus"
                                               Text="Checking..."/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="HostStepsHeading" Text="Get this host running" Style="{DynamicResource SectionHeading}"
                                           AutomationProperties.AutomationId="HostStepsHeading"/>
                                <TextBlock x:Name="HostStepsSummary" Style="{DynamicResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostStepsSummary"
                                           Text="Checking this PC's host service..."/>
                                <StackPanel x:Name="HostStepsPanel" AutomationProperties.Name="Host setup steps"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Good to know" Style="{DynamicResource SectionHeading}"/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap" Text="&#x2022; Paired computers connect only on your private network. Your other computers can find this PC there and ask to pair; you allow each one here."/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,4" Text="&#x2022; Lip-sync may send generated voice here. Microphone audio and files stay on your main PC."/>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,10" Text="&#x2022; GPU tasks need an NVIDIA graphics card, current drivers and Docker Desktop."/>
                                <WrapPanel>
                                    <Button Style="{DynamicResource LinkButton}" Content="Use this PC as a companion instead" Click="UseCompanion_Click"
                                            AutomationProperties.AutomationId="SwitchToCompanion"/>
                                    <Button Style="{DynamicResource LinkButton}" Content="Set up a host on another computer" Click="Hosts_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Devices: the map of computers and services on top, then the selected device's jobs and settings, then settings for all devices -->
            <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" SizeChanged="DevicesPage_SizeChanged">
                <StackPanel Margin="36,30,36,24" MaxWidth="1100">
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Refresh" Click="RefreshDevices_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="RefreshDevices"/>
                            <Button Content="Add a computer" Style="{DynamicResource PrimaryButton}" Click="Hosts_Click"
                                    AutomationProperties.AutomationId="AddComputer"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Your devices" Style="{DynamicResource PageTitle}"/>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,4,12,0"
                                       Text="Select a computer or service to see details."/>
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="MapHost" CornerRadius="24" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,18" Height="380" SizeChanged="MapHost_SizeChanged" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="8">
                            <Canvas x:Name="MapCanvas" Width="900" Height="364" AutomationProperties.Name="Device map"/>
                        </Viewbox>
                    </Border>
                    <StackPanel x:Name="RolesCoverage" AutomationProperties.Name="What isn't working right now"/>
                    <Border x:Name="DetailCard" Style="{DynamicResource CardStyle}" Padding="26,22">
                        <StackPanel x:Name="DetailContent" AutomationProperties.Name="Selected device" AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                    <!-- Your Martlet network: the owner's computers that trust each other (MainWindow.Network.cs) -->
                    <Border x:Name="NetworkCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Your Martlet network">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="NetworkCheckButton" DockPanel.Dock="Right" Content="Check now" Click="NetworkCheck_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="NetworkCheck" AutomationProperties.Name="Check your Martlet network now"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE968;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Your Martlet network" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Pair a host once: every computer in your network can use it and pairs with it by itself."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="NetworkStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="NetworkStatus" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="NetworkJoinsPanel" AutomationProperties.Name="Computers asking to join"/>
                            <StackPanel x:Name="NetworkMembersPanel" AutomationProperties.Name="Computers in your network"/>
                        </StackPanel>
                    </Border>
                    <!-- Apps and API keys: keys that software outside the network uses to call your hosts (MainWindow.ApiKeys.cs, docs/API.md) -->
                    <Border x:Name="ApiKeysCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Apps and API keys">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="ApiKeyCreateButton" DockPanel.Dock="Right" Content="Create API key" Click="ApiKeyCreate_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="ApiKeyCreate" AutomationProperties.Name="Create an API key"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE8D7;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Apps and API keys" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Let other apps and scripts, such as Home Assistant, use your hosts. Each key works on every host in your network."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="ApiKeysStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ApiKeysStatus" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="ApiKeysPanel" AutomationProperties.Name="API keys"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RolesCard" Style="{DynamicResource CardStyle}" Padding="26,22" AutomationProperties.Name="Settings for all devices">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="CheckHostsButton" DockPanel.Dock="Right" Content="Check all hosts" Click="CheckHosts_Click" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="CheckHosts"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Style="{DynamicResource Icon}" FontSize="18" Text="&#xE713;" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Settings for all devices" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{DynamicResource Muted}" Margin="0,2,0,0" Text="These apply to every computer at once."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{DynamicResource CanvasBrush}" CornerRadius="14" Padding="16,12">
                                <StackPanel>
                                    <CheckBox x:Name="ClusterSyncChoice" Checked="ClusterSync_Changed" Unchecked="ClusterSync_Changed"
                                              Content="Keep device roles in sync"
                                              ToolTip="Paired computers use the same plan while Martlet is open. No keys or conversations are shared."
                                              AutomationProperties.AutomationId="ClusterSync"/>
                                    <TextBlock x:Name="ClusterStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24,2,0,0"
                                               AutomationProperties.AutomationId="ClusterStatus" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="UnassignedJobs" AutomationProperties.Name="Jobs nobody does yet"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Companion: the one place each choice is made: a side list of pages in groups, and the open page (built in MainWindow.Companion.cs). Home only shows status. -->
            <Grid x:Name="CompanionPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CompanionNav" Width="190" Margin="12,30,12,24"
                                    AutomationProperties.Name="Companion pages" AutomationProperties.AutomationId="CompanionNav"/>
                    </ScrollViewer>
                </Border>
                <ScrollViewer x:Name="CompanionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CompanionContent" Margin="32,30,32,24" MaxWidth="1000" AutomationProperties.AutomationId="CompanionPage"/>
                </ScrollViewer>
            </Grid>

            <!-- Diagnostics: every part's activity, warnings and errors, from this PC and (with a log host) all the owner's computers (MainWindow.Logs.cs) -->
            <Grid x:Name="DiagnosticsPage" Visibility="Collapsed" Margin="36,30,36,16" AutomationProperties.AutomationId="DiagnosticsPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="LogsRefreshButton" Content="_Refresh" Click="LogsRefresh_Click" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="LogsRefresh" AutomationProperties.Name="Refresh the logs"/>
                        <Button Content="_Copy shown" Click="LogsCopy_Click" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="LogsCopy" AutomationProperties.Name="Copy the shown log lines"/>
                        <Button Content="Open logs _folder" Click="LogsOpenFolder_Click"
                                AutomationProperties.AutomationId="LogsOpenFolder" AutomationProperties.Name="Open this PC's logs folder"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Diagnostics" Style="{DynamicResource PageTitle}"/>
                        <TextBlock Style="{DynamicResource Muted}" Margin="0,4,12,0"
                                   Text="Activity, warnings and errors from Martlet and your paired computers."/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="20,14" AutomationProperties.Name="Log host">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox x:Name="LogHostChoice" DockPanel.Dock="Right" MinWidth="260" VerticalAlignment="Center"
                                      SelectionChanged="LogHost_Changed" AutomationProperties.AutomationId="LogHostChoice"
                                      AutomationProperties.Name="Computer that collects the logs of all your computers"/>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Collect logs from all my computers on" FontWeight="SemiBold"/>
                                <TextBlock Style="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"
                                           Text="Choose a paired host to keep everyone's logs in one place."/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="LogHostStatus" Style="{DynamicResource Muted}" Margin="0,8,0,0"
                                   AutomationProperties.AutomationId="LogHostStatus" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,2,0,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,6">
                            <Label Content="_Search" Target="{Binding ElementName=LogSearch}" Padding="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="LogSearch" Width="220" TextChanged="LogSearch_Changed" MaxLength="200" VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="LogSearch" AutomationProperties.Name="Show only lines containing"/>
                        </StackPanel>
                        <WrapPanel>
                            <WrapPanel x:Name="LogLevelFilters" Margin="0,0,18,0" AutomationProperties.Name="Show lines of"/>
                            <WrapPanel x:Name="LogPartFilters" AutomationProperties.Name="Show lines written by"/>
                        </WrapPanel>
                    </DockPanel>
                    <WrapPanel x:Name="LogSourceFilters" AutomationProperties.Name="Show lines from"/>
                </StackPanel>
                <TextBlock Grid.Row="3" x:Name="LogSummary" Style="{DynamicResource Muted}" Margin="0,4,0,6"
                           AutomationProperties.AutomationId="LogSummary" AutomationProperties.LiveSetting="Polite"/>
                <ListBox Grid.Row="4" x:Name="LogList" SelectionChanged="LogList_SelectionChanged" BorderThickness="1"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="LogList" AutomationProperties.Name="Log lines, newest first">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Level" Grid.Column="1" Text="{Binding Level}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Where}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Headline}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="1">
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="2">
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="3">
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Grid.Row="5" x:Name="LogDetail" IsReadOnly="True" TextWrapping="Wrap" Height="130" Margin="0,8,0,0" Visibility="Collapsed"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                         AutomationProperties.AutomationId="LogDetail" AutomationProperties.Name="The selected log line in full"/>
            </Grid>

            <!-- Settings: appearance, role, updates, tools and diagnostics -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,24" MaxWidth="1000">
                    <TextBlock Text="Settings" Style="{DynamicResource PageTitle}" Margin="0,0,0,18"/>

                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{DynamicResource SectionHeading}"/>
                            <Label Content="Your _palette" Target="{Binding ElementName=ThemeChoice}" Padding="0,0,0,6"/>
                            <ComboBox x:Name="ThemeChoice" Width="220" HorizontalAlignment="Left" SelectionChanged="Theme_Changed"
                                      AutomationProperties.AutomationId="AppearanceTheme" AutomationProperties.Name="Appearance theme">
                                <ComboBoxItem Content="Pink light"/>
                                <ComboBoxItem Content="Rose dark"/>
                            </ComboBox>
                            <TextBlock x:Name="AppearanceStatus" Style="{DynamicResource Muted}" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AppearanceStatus"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Startup and closing" Style="{DynamicResource SectionHeading}"/>
                            <CheckBox x:Name="CloseToTrayCheck" Margin="0,4,0,6" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed"
                                      AutomationProperties.AutomationId="CloseToTray">
                                <TextBlock TextWrapping="Wrap" Text="Keep Martlet running in the notification area when I close its window"/>
                            </CheckBox>
                            <CheckBox x:Name="StartWithWindowsCheck" Margin="0,4,0,6" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"
                                      AutomationProperties.AutomationId="StartWithWindows">
                                <TextBlock TextWrapping="Wrap" Text="Start Martlet when I sign in to Windows"/>
                            </CheckBox>
                            <CheckBox x:Name="StartInTrayCheck" Margin="24,0,0,6" Checked="StartInTray_Changed" Unchecked="StartInTray_Changed"
                                      AutomationProperties.AutomationId="StartInTray">
                                <TextBlock TextWrapping="Wrap" Text="Start in the notification area, without opening the window"/>
                            </CheckBox>
                            <CheckBox x:Name="StartCompanionCheck" Margin="0,4,0,6" Checked="StartCompanion_Changed" Unchecked="StartCompanion_Changed"
                                      AutomationProperties.AutomationId="StartCompanion">
                                <TextBlock TextWrapping="Wrap" Text="When Martlet starts, show the character and start listening"/>
                            </CheckBox>
                            <TextBlock x:Name="BackgroundStatusText" Style="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="BackgroundStatus"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="What this PC is for" Style="{DynamicResource SectionHeading}"/>
                            <TextBlock x:Name="RoleText" Style="{DynamicResource Muted}" Margin="0,0,0,10" AutomationProperties.AutomationId="DeviceRoleText"/>
                            <WrapPanel>
                                <Button x:Name="UseCompanionButton" Content="Use as my companion PC" Click="UseCompanion_Click" Margin="0,0,10,6"
                                        AutomationProperties.AutomationId="UseAsCompanion"/>
                                <Button x:Name="UseHostButton" Content="Use as a Martlet host" Click="UseHost_Click" Margin="0,0,10,6"
                                        AutomationProperties.AutomationId="UseAsHost"/>
                                <Button Content="Replay the welcome tour" Click="ReplayTour_Click" Margin="0,0,10,6"
                                        AutomationProperties.AutomationId="ReplayTour"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="App updates" Style="{DynamicResource SectionHeading}"/>
                            <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       Text="Martlet can check for updates and install them when you choose."/>
                            <TextBlock x:Name="CurrentVersionText" Margin="0,6,0,0" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AppCurrentVersion"/>
                            <CheckBox x:Name="AutomaticUpdateCheck" Content="Check for updates automatically"
                                      Margin="0,10,0,6" Checked="UpdateCheckSetting_Changed" Unchecked="UpdateCheckSetting_Changed"
                                      AutomationProperties.AutomationId="AutomaticUpdateCheck" />
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,6">
                                <Label Content="Check _every" Target="{Binding ElementName=UpdateIntervalChoice}" Padding="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="UpdateIntervalChoice" Width="140" SelectionChanged="UpdatePreference_Changed"
                                          AutomationProperties.AutomationId="UpdateCheckInterval" AutomationProperties.Name="How often to check for updates"/>
                            </StackPanel>
                            <CheckBox x:Name="AutomaticUpdateInstall" Margin="0,4,0,6" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"
                                      AutomationProperties.AutomationId="AutomaticUpdateInstall">
                                <TextBlock TextWrapping="Wrap" Text="Install updates automatically"/>
                            </CheckBox>
                            <CheckBox x:Name="AutomaticHostUpdate" Margin="0,4,0,8" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"
                                      AutomationProperties.AutomationId="AutomaticHostUpdate">
                                <TextBlock TextWrapping="Wrap" Text="Update paired hosts automatically"/>
                            </CheckBox>
                            <WrapPanel>
                                <Button x:Name="CheckForUpdatesButton" Content="Check _for updates now" Click="CheckForUpdates_Click"
                                        Margin="0,4,12,4" AutomationProperties.AutomationId="CheckForAppUpdates"/>
                                <Button x:Name="DownloadUpdateButton" Content="_Install update" Click="DownloadUpdate_Click" Style="{DynamicResource PrimaryButton}"
                                        Margin="0,4,12,4" Visibility="Collapsed" AutomationProperties.AutomationId="InstallAppUpdate"/>
                                <Button x:Name="ReviewUpdateButton" Content="View release _notes" Click="ReviewUpdate_Click"
                                        Margin="0,4,12,4" Visibility="Collapsed" AutomationProperties.AutomationId="ViewAppRelease"/>
                                <Button x:Name="UpdateHostsButton" Content="Update _hosts" Click="UpdateHosts_Click"
                                        Margin="0,4,0,4" AutomationProperties.AutomationId="UpdateHostsNow"/>
                            </WrapPanel>
                            <TextBlock x:Name="UpdateStatusText" Style="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AppUpdateStatus"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Your other computers" Style="{DynamicResource SectionHeading}"/>
                            <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       Text="Your paired Martlet computers send commands through this PC's host service over the pinned, signed connection you paired. Martlet here runs only these: update Martlet and the host service (official GitHub Releases only), install or remove a role, show status. It also keeps this PC's host service on this PC's version."/>
                            <CheckBox x:Name="AllowNodeCommands" Margin="0,10,0,6" Checked="AllowNodeCommands_Changed" Unchecked="AllowNodeCommands_Changed"
                                      AutomationProperties.AutomationId="AllowNodeCommands">
                                <TextBlock TextWrapping="Wrap" Text="Let my other paired computers update Martlet here and manage this PC's host service"/>
                            </CheckBox>
                            <TextBlock x:Name="NodeAgentStatus" Style="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="NodeAgentStatus"/>
                            <CheckBox x:Name="NearbyShareChoice" Checked="NearbyShare_Changed" Unchecked="NearbyShare_Changed" Margin="0,14,0,6"
                                      ToolTip="Martlet on your other computers can find this PC on your private network (port 9444) and ask to use the hosts it runs or reaches over SSH. Each request shows a check number here and needs your Allow."
                                      AutomationProperties.AutomationId="NearbyShare">
                                <TextBlock TextWrapping="Wrap" Text="Let my other computers find this PC and ask to use its hosts"/>
                            </CheckBox>
                            <TextBlock x:Name="NearbyShareStatusText" Style="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="NearbyShareStatus"/>
                            <Button x:Name="NearbyFirewallButton" Content="Let my other computers reach this PC" Click="NearbyFirewall_Click"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
                                    ToolTip="Adds Windows Firewall rules for port 9444 on your private network (administrator approval once)"
                                    AutomationProperties.AutomationId="NearbyFirewall"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tools" Style="{DynamicResource SectionHeading}"/>
                            <WrapPanel>
                                <Button Content="_Troubleshooting" Click="Troubleshooting_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenTroubleshooting" AutomationProperties.Name="Open troubleshooting" />
                                <Button Content="Backup / restore" Click="Recovery_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenConfigurationRecovery" AutomationProperties.Name="Open backup and restore"/>
                                <Button Content="Prere_quisites" Click="Prerequisites_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenPrerequisites" AutomationProperties.Name="Check prerequisites" />
                                <Button Content="_Hosts" Click="Hosts_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenHosts" AutomationProperties.Name="Set up hosts" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <Expander Header="Diagnostics" AutomationProperties.AutomationId="DiagnosticsSection">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{DynamicResource Muted}" Text="Detailed local status."/>
                                <TextBlock x:Name="ActivityText" Style="{DynamicResource Muted}" Margin="0,4,0,0"
                                           AutomationProperties.Name="Diagnostic activity" AutomationProperties.LiveSetting="Polite" />
                                <Label Target="{Binding ElementName=PipelineText}" Content="_Pipeline status" />
                                <TextBox x:Name="PipelineText" IsReadOnly="True" TextWrapping="Wrap" Height="160" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="PipelineStatus"
                                         AutomationProperties.Name="Conversation status" />
                                <Label Target="{Binding ElementName=StatusText}" Content="_Status" />
                                <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Foundation status details" AutomationProperties.AutomationId="FoundationStatus" />
                                <TextBlock x:Name="DataPathText" Style="{DynamicResource Muted}" Margin="0,10,0,0" AutomationProperties.Name="Local settings location" />
                                <Label Content="Audio setup _status" Target="{Binding ElementName=AudioStatusText}" />
                                <TextBox x:Name="AudioStatusText" IsReadOnly="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="LocalAudioStatus" AutomationProperties.Name="Audio setup status" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RefreshButton" Content="_Refresh local status" Margin="0,4,12,4" Click="Refresh_Click"
                                            AutomationProperties.AutomationId="RefreshDiagnostics" AutomationProperties.Name="Refresh local status" />
                                    <Button x:Name="StopButton" Content="S_top diagnostics" Margin="0,4,12,4" IsEnabled="False" Click="Stop_Click"
                                            AutomationProperties.AutomationId="StopDiagnostics" AutomationProperties.Name="Stop diagnostics" />
                                    <Button x:Name="CreateButton" Content="_Create profile" Margin="0,4,12,4" IsEnabled="False" Click="Create_Click"
                                            AutomationProperties.AutomationId="CreateProfile" AutomationProperties.Name="Create profile" />
                                </WrapPanel>
                                <TextBlock Style="{DynamicResource Muted}" Margin="0,10,0,0"
                                           Text="Creating a profile saves starter settings. Exit Martlet closes it completely." />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="E_xit Martlet" Click="Exit_Click" AutomationProperties.Name="Exit Martlet"
                                AutomationProperties.AutomationId="ExitMartlet"/>
                        <TextBlock Style="{DynamicResource Muted}" VerticalAlignment="Center"
                                   Text="Martlet closes completely when you exit, here or from its notification-area icon."/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Status line for results of actions taken from this window -->
            <Border x:Name="StatusBar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="20,10" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Content="Dismiss" Margin="12,0,0,0" Click="DismissStatus_Click"
                            VerticalAlignment="Center" AutomationProperties.AutomationId="DismissStatus"/>
                    <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Icon}" Text="&#xE946;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ActionText" VerticalAlignment="Center" AutomationProperties.Name="Settings action result"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ActionResult"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Welcome tour: shown until this PC's role is chosen -->
        <Grid x:Name="Tour" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource CanvasBrush}"
              AutomationProperties.AutomationId="WelcomeTour">
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="TourBlob1" Width="520" Height="520" Canvas.Left="-160" Canvas.Top="-180" Fill="{DynamicResource GlowBrush}" Opacity="0.55"/>
                <Ellipse x:Name="TourBlob2" Width="420" Height="420" Canvas.Right="-120" Canvas.Bottom="-140" Fill="{DynamicResource SoftBrush}" Opacity="0.9"/>
            </Canvas>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border x:Name="TourCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="28" Padding="40,34" MaxWidth="680" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel x:Name="TourWelcome">
                            <Viewbox Width="130" Height="130" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Width="104" Height="104" Canvas.Left="8" Canvas.Top="10" Fill="{DynamicResource GlowBrush}" Opacity="0.7"/>
                                    <Canvas x:Name="TourFloat" Width="120" Height="120">
                                        <Image x:Name="TourMascot" Style="{DynamicResource Mascot}" Width="92" Height="92" Canvas.Left="14" Canvas.Top="16"/>
                                    </Canvas>
                                    <Path x:Name="TourSparkle" Canvas.Left="86" Canvas.Top="4" Data="M 9 0 L 11.5 6.5 L 18 9 L 11.5 11.5 L 9 18 L 6.5 11.5 L 0 9 L 6.5 6.5 Z"
                                          Fill="{DynamicResource AccentBrush}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Hi! I'm Martlet." Style="{DynamicResource HeroTitle}" TextAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Style="{DynamicResource Muted}" FontSize="15" TextAlignment="Center" Margin="0,10,0,24"
                                       Text="A desktop companion that can chat, speak and show an animated character. Let's get set up."/>
                            <Button Style="{DynamicResource PrimaryButton}" Content="Let's begin" HorizontalAlignment="Center" Padding="28,12" FontSize="15"
                                    Click="TourBegin_Click" AutomationProperties.AutomationId="TourBegin"/>
                        </StackPanel>

                        <StackPanel x:Name="TourRole" Visibility="Collapsed">
                            <TextBlock Text="What's this computer for?" Style="{DynamicResource HeroTitle}" FontSize="26"/>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,6,0,20" Text="You can change this any time in Settings."/>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE770;" Margin="0,0,0,12" Click="TourCompanion_Click"
                                    AutomationProperties.AutomationId="TourCompanion">
                                <StackPanel>
                                    <TextBlock Text="Talk with my companion here" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" Text="This is the PC you sit at. Martlet chats with you and shows its character here."/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE7F4;" Margin="0,0,0,4" Click="TourHost_Click"
                                    AutomationProperties.AutomationId="TourHost">
                                <StackPanel>
                                    <TextBlock Text="Lend this PC to Martlet" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" Text="Use another PC for heavier Martlet tasks and manage it here."/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="TourStart" Visibility="Collapsed">
                            <TextBlock Text="How would you like to start?" Style="{DynamicResource HeroTitle}" FontSize="26"/>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,6,0,20" Text="You'll confirm any install, upload or setup change."/>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE82F;" Margin="0,0,0,12" Click="TourAdvisor_Click"
                                    AutomationProperties.AutomationId="TourAdvisor">
                                <StackPanel>
                                    <TextBlock Text="Recommend a setup for me" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" Text="Three quick questions about your goal and your computers."/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE713;" Margin="0,0,0,4" Click="TourSetup_Click"
                                    AutomationProperties.AutomationId="TourSetup">
                                <StackPanel>
                                    <TextBlock Text="I know what I want" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" Text="Choose a conversation model and add any needed key."/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Margin="0,26,0,0">
                            <Button x:Name="TourBackButton" Style="{DynamicResource LinkButton}" Content="Back" HorizontalAlignment="Left"
                                    Click="TourBack_Click" Visibility="Hidden" AutomationProperties.AutomationId="TourBack"/>
                            <StackPanel x:Name="TourDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="Tour progress"/>
                            <Button Style="{DynamicResource LinkButton}" Content="Skip for now" HorizontalAlignment="Right" Margin="0"
                                    Click="TourSkip_Click" AutomationProperties.AutomationId="TourSkip"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:ThemedWindow>
