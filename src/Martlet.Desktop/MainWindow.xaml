<Window x:Class="Martlet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - Diagnostics" Width="950" Height="800" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Martlet foundation status"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Martlet - offline fixture and diagnostics" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Not connected / not configured" FontSize="18" Margin="0,8,0,12" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Try the offline fixture without creating a profile. All demo text is scripted, NOT live transcription or AI. Capture, providers, credentials, network and GPU work remain unavailable. Audio is OFF unless you confirm the separate tone action. No consent is saved." />
            <Label Target="{Binding ElementName=ScenarioChoice}" Content="_Offline scenario (FIXTURE - NOT AI)" />
            <ComboBox x:Name="ScenarioChoice" SelectedIndex="0" MinHeight="30"
                      AutomationProperties.AutomationId="FixtureScenario" AutomationProperties.Name="Offline fixture scenario" />
            <WrapPanel>
                <Button x:Name="DemoButton" Content="_Try fixture (audio OFF)" Click="Demo_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="StartFixture" AutomationProperties.Name="Try offline fixture, audio off" />
                <Button x:Name="ToneButton" Content="Completed fixture + confirm 200 ms _tone" Click="Tone_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="FixtureTone" AutomationProperties.Name="Confirm completed fixture and synthetic tone, not speech" />
                <Button x:Name="FixtureStopButton" Content="Stop _fixture" Click="FixtureStop_Click" IsEnabled="False" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="StopFixture" AutomationProperties.Name="Stop fixture and tone" />
            </WrapPanel>
            <Label Target="{Binding ElementName=FixtureText}" Content="Fixture _text, trace and status (separate from real-mode status)" />
            <TextBox x:Name="FixtureText" IsReadOnly="True" TextWrapping="Wrap" Height="210" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="FixtureStatus" AutomationProperties.Name="Scripted fixture text and trace, not AI" />
            <TextBlock x:Name="ActivityText" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.Name="Diagnostic activity" AutomationProperties.LiveSetting="Polite" />
            <Label Target="{Binding ElementName=PipelineText}" Content="_Pipeline status" />
            <TextBox x:Name="PipelineText" IsReadOnly="True" TextWrapping="Wrap"
                     Height="180" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="PipelineStatus"
                     AutomationProperties.Name="Mic VAD STT policy LLM TTS playback and optional host status" />
            <Label Target="{Binding ElementName=StatusText}" Content="_Status details" />
            <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap"
                     MinHeight="200" MaxHeight="380" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Foundation status details"
                     AutomationProperties.AutomationId="FoundationStatus" />
            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Margin="0,12,0,0"
                       AutomationProperties.Name="Local settings location" />
            <TextBlock x:Name="ActionText" TextWrapping="Wrap" Margin="0,8,0,8"
                       AutomationProperties.Name="Settings action result"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel>
                <Button x:Name="RefreshButton" Content="_Refresh local status" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="RefreshDiagnostics"
                        AutomationProperties.Name="Refresh local status" Click="Refresh_Click" />
                <Button x:Name="StopButton" Content="S_top diagnostics" Padding="12,8" Margin="0,4,12,4"
                        IsEnabled="False" AutomationProperties.AutomationId="StopDiagnostics"
                        AutomationProperties.Name="Stop diagnostics" Click="Stop_Click" />
                <Button x:Name="CreateButton" Content="_Create unconfigured local profile" Padding="12,8" Margin="0,4,12,4"
                        IsEnabled="False" AutomationProperties.AutomationId="CreateProfile" AutomationProperties.Name="Create unconfigured local profile"
                        Click="Create_Click" />
                <Button Content="E_xit" Padding="12,8" Margin="0,4,0,4"
                        AutomationProperties.Name="Exit Martlet" Click="Exit_Click" />
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Creating a profile saves unconfigured settings only. It grants no consent. Tone output binds the Windows default once at explicit start, never follows a changed default or falls back to room speakers. Tone accounting is not proof of audibility. Closing exits Martlet; there is no background tray process." />
        </StackPanel>
    </ScrollViewer>
</Window>
