                            </WrapPanel>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PresenceAwayStatus"
                                       Text="Home says when one of your computers stops answering for 30 seconds and when it is back. A short miss is not counted."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tools" Style="{DynamicResource SectionHeading}"/>
                            <TextBlock x:Name="ThisPcArchitectureText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="ThisPcArchitecture"/>
                            <WrapPanel>
                                <Button Content="_Troubleshooting" Click="Troubleshooting_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenTroubleshooting" AutomationProperties.Name="Open troubleshooting" />
                                <Button Content="Backup / restore" Click="Recovery_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenConfigurationRecovery" AutomationProperties.Name="Open backup and restore"/>
                                <Button Content="Prere_quisites" Click="Prerequisites_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenPrerequisites" AutomationProperties.Name="Check prerequisites" />
                                <Button Content="_Hosts" Click="Hosts_Click" Margin="0,4,12,4"
                                        AutomationProperties.AutomationId="OpenHosts" AutomationProperties.Name="Set up hosts" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="E_xit Martlet" Click="Exit_Click" AutomationProperties.Name="Exit Martlet"
                                AutomationProperties.AutomationId="ExitMartlet"/>
                        <TextBlock Style="{DynamicResource Muted}" VerticalAlignment="Center"
                                   Text="Martlet closes completely when you exit, here or from its notification-area icon."/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Status line for results of actions taken from this window -->
            <Border x:Name="StatusBar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="20,10" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Content="Dismiss" Margin="12,0,0,0" Click="DismissStatus_Click"
                            VerticalAlignment="Center" AutomationProperties.AutomationId="DismissStatus"/>
                    <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Icon}" Text="&#xE946;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ActionText" VerticalAlignment="Center" AutomationProperties.Name="Settings action result"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ActionResult"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Welcome wizard: shown until this PC's role is chosen (docs/WELCOME_WIZARD.md) -->
        <Grid x:Name="Tour" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource CanvasBrush}"
              AutomationProperties.AutomationId="WelcomeTour">
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="TourBlob1" Width="520" Height="520" Canvas.Left="-160" Canvas.Top="-180" Fill="{DynamicResource GlowBrush}" Opacity="0.55"/>
                <Ellipse x:Name="TourBlob2" Width="420" Height="420" Canvas.Right="-120" Canvas.Bottom="-140" Fill="{DynamicResource SoftBrush}" Opacity="0.9"/>
            </Canvas>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border x:Name="TourCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="28" Padding="40,34" MaxWidth="680" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel x:Name="TourWelcome">
                            <Viewbox Width="130" Height="130" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Width="104" Height="104" Canvas.Left="8" Canvas.Top="10" Fill="{DynamicResource GlowBrush}" Opacity="0.7"/>
                                    <Canvas x:Name="TourFloat" Width="120" Height="120">
                                        <Image x:Name="TourMascot" Style="{DynamicResource Mascot}" Width="92" Height="92" Canvas.Left="14" Canvas.Top="16"/>
                                    </Canvas>
                                    <Path x:Name="TourSparkle" Canvas.Left="86" Canvas.Top="4" Data="M 9 0 L 11.5 6.5 L 18 9 L 11.5 11.5 L 9 18 L 6.5 11.5 L 0 9 L 6.5 6.5 Z"
                                          Fill="{DynamicResource AccentBrush}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Hi! I'm Martlet." Style="{DynamicResource HeroTitle}" TextAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Style="{DynamicResource Muted}" FontSize="15" TextAlignment="Center" Margin="0,10,0,24"
                                       Text="A desktop companion that can chat, speak and show an animated character. Let's get set up."/>
                            <Button Style="{DynamicResource PrimaryButton}" Content="Let's begin" HorizontalAlignment="Center" Padding="28,12" FontSize="15"
                                    Click="TourBegin_Click" AutomationProperties.AutomationId="TourBegin"/>
                        </StackPanel>

                        <!-- Step 1: start a new Martlet network or join one found on the local network (Nearby, port 9444). -->
                        <StackPanel x:Name="TourNetwork" Visibility="Collapsed">
                            <TextBlock Text="Is Martlet already on another of your computers?" Style="{DynamicResource HeroTitle}" FontSize="26" TextWrapping="Wrap"/>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,6,0,20" TextWrapping="Wrap"
                                       Text="Your computers with Martlet form your Martlet network. They share the work, so each does what it's best at."/>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE710;" Margin="0,0,0,12" Click="WizardNewNetwork_Click"
                                    AutomationProperties.AutomationId="WizardNewNetwork">
                                <StackPanel>
                                    <TextBlock Text="No, this is my first one" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Text="Start a new Martlet network on this PC. You can add your other computers later."/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE968;" Margin="0,0,0,4" Click="WizardJoinNetwork_Click"
                                    AutomationProperties.AutomationId="WizardJoinNetwork">
                                <StackPanel>
                                    <TextBlock Text="Yes, join my Martlet network" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Text="Martlet looks for your other computers on this network. You allow this PC on one of them by comparing a number."/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="WizardJoinPanel" Visibility="Collapsed" Background="{DynamicResource SoftBrush}" CornerRadius="16"
                                    Padding="18,14" Margin="0,10,0,0" AutomationProperties.AutomationId="WizardJoinPanel">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="WizardScanAgainButton" DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Content="Look again"
                                                Click="WizardScanAgain_Click" VerticalAlignment="Top" AutomationProperties.AutomationId="WizardScanAgain"/>
                                        <TextBlock x:Name="WizardScanStatus" TextWrapping="Wrap" FontSize="14" AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.AutomationId="WizardScanStatus"/>
                                    </DockPanel>
                                    <!-- One row per Martlet found, built in code (WizardFound-n, WizardConnect-n). -->
                                    <StackPanel x:Name="WizardFoundList" Margin="0,6,0,0"/>
                                    <Button Style="{DynamicResource LinkButton}" Content="It isn't listed: enter its address and pairing code" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="WizardJoinManual_Click" AutomationProperties.AutomationId="WizardJoinManual"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{DynamicResource LinkButton}" Content="This PC only lends its power to my other computers (host PC)" HorizontalAlignment="Left"
                                    Margin="0,16,0,0" Click="TourHost_Click" AutomationProperties.AutomationId="TourHost"/>
                        </StackPanel>

                        <!-- Step 2: what this PC has (graphics card, memory, processor). -->
                        <StackPanel x:Name="TourSpecs" Visibility="Collapsed">
                            <TextBlock Text="Here's what this PC has" Style="{DynamicResource HeroTitle}" FontSize="26"/>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,6,0,16" TextWrapping="Wrap"
                                       Text="Martlet reads this on this PC only, to work out what can run here. Nothing is sent anywhere."/>
                            <Border Background="{DynamicResource SoftBrush}" CornerRadius="16" Padding="18,14">
                                <StackPanel x:Name="WizardSpecRows"/>
                            </Border>
                            <TextBlock x:Name="WizardSpecs" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       AutomationProperties.AutomationId="WizardSpecs"/>
                            <Button x:Name="WizardSpecsNextButton" Style="{DynamicResource PrimaryButton}" Content="Next" HorizontalAlignment="Right" Padding="24,10"
                                    Margin="0,18,0,0" Click="WizardSpecsNext_Click" AutomationProperties.AutomationId="WizardSpecsNext"/>
                        </StackPanel>

                        <!-- Step 3: keep everything on my computers, or free online services are fine. -->
                        <StackPanel x:Name="TourPreference" Visibility="Collapsed">
                            <TextBlock Text="Where may Martlet do its thinking?" Style="{DynamicResource HeroTitle}" FontSize="26" TextWrapping="Wrap"/>
                            <TextBlock Style="{DynamicResource Muted}" Margin="0,6,0,20" TextWrapping="Wrap"
                                       Text="Free online services take the heaviest work off a smaller PC. You can change this later in Companion."/>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE72E;" Margin="0,0,0,12" Click="WizardPreferLocal_Click"
                                    AutomationProperties.AutomationId="WizardPreferLocal">
                                <StackPanel>
                                    <TextBlock Text="Keep everything on my computers" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Text="What you say and Martlet's replies stay at home. On a smaller PC, replies can be slower."/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource CardButton}" Tag="&#xE753;" Margin="0,0,0,4" Click="WizardPreferOnline_Click"
                                    AutomationProperties.AutomationId="WizardPreferOnline">
                                <StackPanel>
                                    <TextBlock Text="Free online services are fine" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Text="When this PC is short on room, Martlet thinks with a free NVIDIA model online. You sign up for a free NVIDIA key; what you say goes to NVIDIA."/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Step 4: the recommendation, with what each part uses of this PC. -->
                        <StackPanel x:Name="TourPlan" Visibility="Collapsed">
                            <TextBlock x:Name="WizardPlanTitle" Text="Here's what fits this PC" Style="{DynamicResource HeroTitle}" FontSize="26" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WizardPlanSummary" Style="{DynamicResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="WizardPlanSummary"/>
                            <!-- One card per part, built in code (WizardPlanItem-<part>). -->
                            <StackPanel x:Name="WizardPlanList"/>
                            <TextBlock x:Name="WizardPlanTotals" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="WizardPlanTotals"/>
                            <Button x:Name="WizardAcceptButton" Style="{DynamicResource PrimaryButton}" Content="Use these suggestions" HorizontalAlignment="Stretch"
                                    Padding="24,12" FontSize="15" Margin="0,18,0,0" Click="WizardAccept_Click" IsEnabled="False"
                                    AutomationProperties.AutomationId="WizardAccept"/>
                            <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                       Text="You'll confirm downloads, installs and any key before anything changes."/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Style="{DynamicResource LinkButton}" Content="Ask me three questions instead" Click="TourAdvisor_Click" Margin="0,0,18,0"
                                        AutomationProperties.AutomationId="TourAdvisor"/>
                                <Button Style="{DynamicResource LinkButton}" Content="I'll choose myself" Click="TourSetup_Click"
                                        AutomationProperties.AutomationId="TourSetup"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 5 (only when Thinking goes online): a free NVIDIA Build key. -->
                        <StackPanel x:Name="TourKey" Visibility="Collapsed">
                            <TextBlock Text="Get your free NVIDIA key" Style="{DynamicResource HeroTitle}" FontSize="26"/>
                            <TextBlock x:Name="WizardKeyIntro" Style="{DynamicResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="WizardKeyIntro"/>
                            <TextBlock x:Name="WizardKeySteps" TextWrapping="Wrap" FontSize="14" LineHeight="22" AutomationProperties.AutomationId="WizardKeySteps"/>
                            <Button Style="{DynamicResource LinkButton}" Content="Open build.nvidia.com" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="WizardKeyOpen_Click" AutomationProperties.AutomationId="WizardKeyOpen"/>
                            <Label Content="_NVIDIA API key (starts with nvapi-)" Target="{Binding ElementName=WizardKeyBox}" Padding="0,14,0,4"/>
                            <PasswordBox x:Name="WizardKeyBox" AutomationProperties.AutomationId="WizardKey" AutomationProperties.Name="NVIDIA API key"/>
                            <CheckBox x:Name="WizardKeyConsent" Margin="0,12,0,0" AutomationProperties.AutomationId="WizardKeyConsent">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Send what I say and Martlet's conversation to NVIDIA Build for Thinking. NVIDIA's terms apply; the free tier has limits."/>
                            </CheckBox>
                            <TextBlock x:Name="WizardKeyStatus" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WizardKeyStatus"/>
                            <Button x:Name="WizardKeySaveButton" Style="{DynamicResource PrimaryButton}" Content="Save key and set it all up" HorizontalAlignment="Stretch"
                                    Padding="24,12" Margin="0,14,0,0" Click="WizardKeySave_Click" AutomationProperties.AutomationId="WizardKeySave"/>
                            <Button Style="{DynamicResource LinkButton}" Content="Skip the key: set up the rest now" HorizontalAlignment="Center" Margin="0,10,0,0"
                                    Click="WizardKeySkip_Click" AutomationProperties.AutomationId="WizardKeySkip"/>
                        </StackPanel>

                        <Grid Margin="0,26,0,0">
                            <Button x:Name="TourBackButton" Style="{DynamicResource LinkButton}" Content="Back" HorizontalAlignment="Left"
                                    Click="TourBack_Click" Visibility="Hidden" AutomationProperties.AutomationId="TourBack"/>
                            <StackPanel x:Name="TourDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="Tour progress"/>
                            <Button Style="{DynamicResource LinkButton}" Content="Skip for now" HorizontalAlignment="Right" Margin="0"
                                    Click="TourSkip_Click" AutomationProperties.AutomationId="TourSkip"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Closing: what Martlet is still finishing as it exits, and Exit now when that takes longer than usual -->
        <Grid x:Name="ClosingOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" AutomationProperties.AutomationId="ClosingPanel">
            <Rectangle Fill="{DynamicResource CanvasBrush}" Opacity="0.9"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="32,28" MaxWidth="560" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Closing Martlet..." Style="{DynamicResource SectionHeading}"/>
                    <TextBlock x:Name="ClosingStatusText" TextWrapping="Wrap" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="ClosingStatus" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel x:Name="ClosingSlowPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock x:Name="ClosingSlowText" Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ClosingSlow"/>
                        <Button x:Name="ClosingExitNowButton" Content="E_xit now" Style="{DynamicResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="ClosingExitNow_Click"
                                AutomationProperties.AutomationId="ClosingExitNow"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</local:ThemedWindow>
