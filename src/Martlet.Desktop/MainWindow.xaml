                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="0">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="1">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="2">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
