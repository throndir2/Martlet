<local:ThemedWindow x:Class="Martlet.Desktop.MainWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - Your companion corner" Width="1000" Height="860" MinWidth="520" MinHeight="420"
        Style="{DynamicResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MartletMainWindow"
        AutomationProperties.Name="Martlet foundation status"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="1120">
            <WrapPanel Margin="0,0,0,18">
                <StackPanel Margin="0,0,32,8">
                    <TextBlock Text="martlet" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="A little space for your companion." Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Your _palette" Target="{Binding ElementName=ThemeChoice}" Padding="0,0,0,4"/>
                    <ComboBox x:Name="ThemeChoice" Width="190" SelectionChanged="Theme_Changed"
                              AutomationProperties.AutomationId="AppearanceTheme" AutomationProperties.Name="Appearance theme">
                        <ComboBoxItem Content="Pink light"/>
                        <ComboBoxItem Content="Rose dark"/>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
            <TextBlock x:Name="AppearanceStatus" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="AppearanceStatus"/>
            <Border Style="{DynamicResource CardStyle}" Background="{DynamicResource SoftBrush}" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Your cozy companion corner" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="A conversation, a little company, a moment for you." TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16"/>
                        <TextBlock Text="You're in control" FontWeight="SemiBold"/>
                        <TextBlock Text="Nothing listens on launch. Network remains idle unless you opted in to app update checks; real conversations need your configured routes and explicit permission for each action."
                                   TextWrapping="Wrap" Margin="0,4,0,16"/>
                        <WrapPanel>
                            <Button x:Name="ConversationButton" Content="Open _real API conversation" Click="Conversation_Click"
                                    Style="{DynamicResource PrimaryButton}" Margin="0,0,12,6"
                                    AutomationProperties.AutomationId="OpenLiveConversation" AutomationProperties.Name="Open real API conversation without network, credentials or device effects" />
                            <Button x:Name="SetupButton" Content="Set_up / resume" Click="Setup_Click" Margin="0,0,12,6"
                                    AutomationProperties.AutomationId="OpenSetup" AutomationProperties.Name="Open resumable setup, no network or credential lookup" />
                            <Button x:Name="AdvisorButton" Content="_Which setup is right for me?" Click="Advisor_Click" Margin="0,0,0,6"
                                    AutomationProperties.AutomationId="OpenSetupAdvisor" AutomationProperties.Name="Get a recommended setup for your goal and computers; saves and contacts nothing" />
                        </WrapPanel>
                    </StackPanel>
                    <Viewbox Grid.Column="1" Width="74" Height="90" Margin="16,0,0,0" VerticalAlignment="Top"
                             IsHitTestVisible="False" Focusable="False">
                        <Canvas Width="90" Height="100">
                            <Ellipse Width="78" Height="78" Canvas.Top="10" Fill="{DynamicResource SurfaceBrush}"/>
                            <Path Data="M 39 66 C 33 59 14 48 19 34 C 23 23 35 26 39 33 C 45 23 58 24 62 34 C 68 47 48 61 39 66 Z"
                                  Fill="{DynamicResource AccentBrush}"/>
                            <Path Data="M 72 3 L 75 12 L 84 15 L 75 18 L 72 27 L 69 18 L 60 15 L 69 12 Z M 12 73 L 14 79 L 20 81 L 14 83 L 12 89 L 10 83 L 4 81 L 10 79 Z"
                                  Fill="{DynamicResource AccentBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
            <TextBlock Text="A tiny test, no strings attached" Style="{DynamicResource SectionHeading}"/>
            <TextBlock Text="Explore a scripted demo without an account. FIXTURE - NOT AI. No microphone, provider or network; audio stays off unless you separately confirm a tone."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            <Label Target="{Binding ElementName=ScenarioChoice}" Content="_Offline scenario (FIXTURE - NOT AI)" />
            <ComboBox x:Name="ScenarioChoice" SelectedIndex="0" MinHeight="30"
                      AutomationProperties.AutomationId="FixtureScenario" AutomationProperties.Name="Offline fixture scenario" />
            <WrapPanel>
                <Button x:Name="DemoButton" Content="_Try fixture (audio OFF)" Click="Demo_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="StartFixture" AutomationProperties.Name="Try offline fixture, audio off" />
                <Button x:Name="ToneButton" Content="Completed fixture + confirm 200 ms _tone" Click="Tone_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="FixtureTone" AutomationProperties.Name="Confirm completed fixture and synthetic tone, not speech" />
                <Button x:Name="FixtureStopButton" Content="Stop _fixture" Click="FixtureStop_Click" IsEnabled="False" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="StopFixture" AutomationProperties.Name="Stop fixture and tone" />
            </WrapPanel>
            <Label Target="{Binding ElementName=FixtureText}" Content="Fixture _text, trace and status (separate from real-mode status)" />
            <TextBox x:Name="FixtureText" IsReadOnly="True" TextWrapping="Wrap" Height="210" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="FixtureStatus" AutomationProperties.Name="Scripted fixture text and trace, not AI" />
            <TextBlock x:Name="ActivityText" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.Name="Diagnostic activity" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
            <TextBlock Text="Make yourself at home" Style="{DynamicResource SectionHeading}"/>
            <TextBlock Text="Set up your routes, choose local audio devices, or check in on your configuration."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button x:Name="CompanionButton" Content="_Companion personas" Click="Companion_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenCompanion" AutomationProperties.Name="Edit local companion personas and response-style weights" />
                <Button x:Name="VoiceLibraryButton" Content="Voice _Library (local preparation; five engine targets)" Click="VoiceLibrary_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenVoiceLibrary" AutomationProperties.Name="Open local voice library without file scan, model loading or playback" />
                <Button x:Name="MemoryButton" Content="Local _memory (OFF by default)" Click="Memory_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenMemory" AutomationProperties.Name="Manage explicit local memory facts without opening the store on launch" />
                <Button x:Name="AudioSetupButton" Content="_Audio setup (local only)" Click="AudioSetup_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenAudioSetup" AutomationProperties.Name="Open local audio setup without enumerating or testing devices" />
                <Button Content="Open _Troubleshooting" Click="Troubleshooting_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenTroubleshooting" AutomationProperties.Name="Open passive troubleshooting and local support preview" />
                <Button x:Name="CharacterButton" Content="Show _character" Click="Character_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="ToggleCharacter" AutomationProperties.Name="Show or hide the animated desktop character" />
                <Button Content="Character _settings" Click="Avatar_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenAvatar" AutomationProperties.Name="Open character and avatar settings" />
                <Button Content="Martlet _hosts" Click="Hosts_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenHosts" AutomationProperties.Name="Set up and pair Martlet hosts on this PC or other computers" />
                <Button Content="Prere_quisites (check / install)" Click="Prerequisites_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenPrerequisites" AutomationProperties.Name="Check and install Windows prerequisites such as WebView2, Windows speech, Ollama and Docker Desktop in a console window" />
            </WrapPanel>
            <TextBlock Text="App updates" Style="{DynamicResource SectionHeading}" Margin="0,14,0,0"/>
            <TextBlock Text="GitHub Releases are checked only when you ask, or after you opt in to checks at launch. Downloading requires a separate confirmation. Martlet saves the installer but does not install it for you; the installer is not code-signed."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            <CheckBox x:Name="AutomaticUpdateCheck" Content="Check for app updates on launch (contacts GitHub)"
                      Margin="0,8,0,8" Checked="UpdateCheckSetting_Changed" Unchecked="UpdateCheckSetting_Changed"
                      AutomationProperties.AutomationId="AutomaticUpdateCheck" />
            <WrapPanel>
                <Button x:Name="CheckForUpdatesButton" Content="Check _for app updates" Click="CheckForUpdates_Click"
                        Padding="12,8" Margin="0,4,12,4" AutomationProperties.AutomationId="CheckForAppUpdates"/>
                <Button x:Name="DownloadUpdateButton" Content="_Download update (review first)" Click="DownloadUpdate_Click"
                        Padding="12,8" Margin="0,4,0,4" Visibility="Collapsed"
                        AutomationProperties.AutomationId="DownloadAppUpdate"/>
                <Button x:Name="ReviewUpdateButton" Content="_View release details" Click="ReviewUpdate_Click"
                        Padding="12,8" Margin="0,4,0,4" Visibility="Collapsed"
                        AutomationProperties.AutomationId="ViewAppRelease"/>
            </WrapPanel>
            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="AppUpdateStatus"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
            <TextBlock Text="Behind the scenes" Style="{DynamicResource SectionHeading}"/>
            <TextBlock Text="Local diagnostics and honest status. A demo result never means a real connection is ready."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            <Label Target="{Binding ElementName=PipelineText}" Content="_Pipeline status" />
            <TextBox x:Name="PipelineText" IsReadOnly="True" TextWrapping="Wrap"
                     Height="180" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="PipelineStatus"
                     AutomationProperties.Name="Mic VAD STT policy LLM TTS playback and optional host status" />
            <Label Target="{Binding ElementName=StatusText}" Content="_Status details" />
            <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap"
                     MinHeight="200" MaxHeight="380" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Foundation status details"
                     AutomationProperties.AutomationId="FoundationStatus" />
            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Margin="0,12,0,0"
                       AutomationProperties.Name="Local settings location" />
            <Label Content="Local audio setup _evidence (separate from fixture/provider status)" Target="{Binding ElementName=AudioStatusText}" />
            <TextBox x:Name="AudioStatusText" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="LocalAudioStatus" AutomationProperties.Name="Local audio setup stages and historical evidence" />
            <TextBlock x:Name="ActionText" TextWrapping="Wrap" Margin="0,8,0,8"
                       AutomationProperties.Name="Settings action result"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel>
                <Button Content="Configuration backup / restore (local only)" Click="Recovery_Click" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="OpenConfigurationRecovery" AutomationProperties.Name="Open passive local configuration backup and restore"/>
                <Button x:Name="RefreshButton" Content="_Refresh local status" Padding="12,8" Margin="0,4,12,4"
                        AutomationProperties.AutomationId="RefreshDiagnostics"
                        AutomationProperties.Name="Refresh local status" Click="Refresh_Click" />
                <Button x:Name="StopButton" Content="S_top diagnostics" Padding="12,8" Margin="0,4,12,4"
                        IsEnabled="False" AutomationProperties.AutomationId="StopDiagnostics"
                        AutomationProperties.Name="Stop diagnostics" Click="Stop_Click" />
                <Button x:Name="CreateButton" Content="_Create unconfigured local profile" Padding="12,8" Margin="0,4,12,4"
                        IsEnabled="False" AutomationProperties.AutomationId="CreateProfile" AutomationProperties.Name="Create unconfigured local profile"
                        Click="Create_Click" />
                <Button Content="E_xit" Padding="12,8" Margin="0,4,0,4"
                        AutomationProperties.Name="Exit Martlet" Click="Exit_Click" />
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Creating a profile saves unconfigured settings only. It grants no consent. Tone output binds the Windows default once at explicit start, never follows a changed default or falls back to room speakers. Tone accounting is not proof of audibility. Closing exits Martlet; there is no background tray process." />
                </StackPanel>
            </Border>
            <TextBlock Text="Made for a little more warmth in your day." HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</local:ThemedWindow>
