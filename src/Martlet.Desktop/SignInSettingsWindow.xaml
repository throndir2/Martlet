<local:ThemedWindow x:Class="Martlet.Desktop.SignInSettingsWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}" Title="Martlet - Sign-in from outside"
        Width="680" MinWidth="520" Height="760" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="SignInSettingsWindow">
    <DockPanel Margin="26,20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="_Close" IsCancel="True" Click="Close_Click" DockPanel.Dock="Right" MinWidth="100"
                    AutomationProperties.AutomationId="SignInSettingsClose"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="SignInSettingsStatus"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Style="{DynamicResource SectionHeading}" TextWrapping="Wrap" AutomationProperties.AutomationId="SignInSettingsTitle"/>
                <TextBlock x:Name="OutsideWarningText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed"
                           Foreground="{DynamicResource WarningBrush}" AutomationProperties.AutomationId="SignInOutsideWarning"/>
                <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"
                           Text="Let one of your computers join this host while it is away from home, by signing in instead of typing a code shown here. A computer that signs in is paired like any other and joins your Martlet network by itself. You can also share this host's engines with a friend: allow their account as a friend below and send them the invite. Remove a sign-in here to take access away."/>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Owner account" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="OwnerStateText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                                   AutomationProperties.AutomationId="SignInOwnerState"/>
                        <TextBlock Text="Account name"/>
                        <TextBox x:Name="OwnerUserText" Margin="0,4,0,8" Text="owner" AutomationProperties.AutomationId="SignInOwnerUser"/>
                        <TextBlock Text="Password (12 characters or more)"/>
                        <PasswordBox x:Name="OwnerPasswordText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInOwnerPassword"/>
                        <Button x:Name="NewSecretButton" Content="1. Make an _authenticator secret" Click="NewSecret_Click" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SignInTotpNew"/>
                        <StackPanel x:Name="SecretPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap"
                                       Text="Add it to your authenticator app (Google Authenticator, Aegis, 1Password, Bitwarden...): open the link, or type the secret. It is required for every sign-in."/>
                            <TextBox x:Name="SecretText" IsReadOnly="True" FontFamily="Consolas" Margin="0,4,0,4" AutomationProperties.AutomationId="SignInTotpSecret"/>
                            <TextBox x:Name="SecretLinkText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"
                                     AutomationProperties.AutomationId="SignInTotpLink"/>
                            <TextBlock Text="2. The 6-digit code your app shows now"/>
                            <TextBox x:Name="OwnerCodeText" FontFamily="Consolas" FontSize="16" MaxLength="8" Margin="0,4,0,8"
                                     AutomationProperties.AutomationId="SignInOwnerCode"/>
                            <Button x:Name="SaveOwnerButton" Content="3. _Save owner account" Click="SaveOwner_Click" Style="{DynamicResource PrimaryButton}"
                                    HorizontalAlignment="Left" AutomationProperties.AutomationId="SignInOwnerSave"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="New _recovery codes" Click="NewCodes_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="SignInRecoveryNew"/>
                            <Button Content="Remo_ve owner account" Click="RemoveOwner_Click" AutomationProperties.AutomationId="SignInOwnerRemove"/>
                        </StackPanel>
                        <TextBox x:Name="RecoveryText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"
                                 AutomationProperties.AutomationId="SignInRecoveryCodes"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Allowed sign-ins" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="Identities at a sign-in provider set up on this host (the provider's ID and the account's stable subject). Each is one of your own computers, which joins your Martlet network, or a friend's, which uses only this host's engines (thinking, listening, speaking, lip-sync and reading), never joins your network and always goes after your own work. Changing which one an identity is makes its computers sign in again. Removing one takes access away from the computers it signed in."/>
                        <TextBlock x:Name="AllowedText" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="SignInAllowedList"/>
                        <StackPanel x:Name="AllowedPanel" AutomationProperties.Name="Allowed sign-ins" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ProvidersText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   AutomationProperties.AutomationId="SignInProvidersList"/>
                        <TextBlock Text="Allow another sign-in: provider ID, subject and a label (an email or name)" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AllowProviderText" Margin="0,0,6,0" AutomationProperties.AutomationId="SignInAllowProvider"
                                     AutomationProperties.Name="Provider ID"/>
                            <TextBox x:Name="AllowSubjectText" Grid.Column="1" Margin="0,0,6,0" AutomationProperties.AutomationId="SignInAllowSubject"
                                     AutomationProperties.Name="Subject"/>
                            <TextBox x:Name="AllowLabelText" Grid.Column="2" AutomationProperties.AutomationId="SignInAllowLabel"
                                     AutomationProperties.Name="Label (an email or name)"/>
                        </Grid>
                        <ComboBox x:Name="AllowAccessBox" Margin="0,8,0,0" AutomationProperties.AutomationId="SignInAllowAccess"
                                  AutomationProperties.Name="What the computers it signs in get">
                            <ComboBoxItem Content="One of my computers: it joins my Martlet network" Tag="member" IsSelected="True"
                                          AutomationProperties.AutomationId="SignInAllowAccess-member"/>
                            <ComboBoxItem Content="A friend: this host's engines only, never my network" Tag="friend"
                                          AutomationProperties.AutomationId="SignInAllowAccess-friend"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="A_llow" Click="Allow_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="SignInAllow"/>
                            <Button Content="Remove and take its computers' access away" Click="Disallow_Click" AutomationProperties.AutomationId="SignInDisallow"
                                    ToolTip="This host revokes the computers it signed in. Your own computers among them are removed from your Martlet network on your computers' next sync, so they lose every host; a friend's computer never joined it"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Sign-in providers for your household" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="Sign in in the browser with your own identity provider (Authentik, Authelia, Keycloak, Pocket ID or any OpenID Connect issuer), Google, Microsoft, Discord or Steam. Register a client for Martlet there (Google: Cloud console › APIs &amp; Services › Credentials › OAuth client ID › Desktop app; Microsoft: Entra admin center › App registrations, a Mobile and desktop application with the redirect http://127.0.0.1; Discord: Developer Portal › your application › OAuth2, with the redirect http://127.0.0.1:&lt;port&gt;/; Steam needs nothing) and enter its ID and secret here. Martlet saves the provider on every host of your Martlet network, so you set it up once; the hosts keep the secret, and this PC keeps a copy only to add it to a host that joins later. Then sign in once from the computer you want to allow and allow it below."/>
                        <TextBlock x:Name="HouseholdProvidersText" TextWrapping="Wrap" Margin="0,0,0,6" Text="Reading your hosts' providers..."
                                   AutomationProperties.AutomationId="SignInHouseholdProviders"/>
                        <Button Content="Add to the other hosts" Click="PushProviders_Click" HorizontalAlignment="Left" Margin="0,0,0,10"
                                AutomationProperties.AutomationId="SignInProvidersPush"
                                ToolTip="Adds each household provider to the hosts of your network that miss it (a provider that needs a client secret only when this PC keeps it)"/>
                        <ComboBox x:Name="ProviderKindBox" SelectionChanged="ProviderKind_Changed" Margin="0,0,0,8" AutomationProperties.AutomationId="SignInProviderKind">
                            <ComboBoxItem Content="OpenID Connect (Authentik, Authelia, Keycloak, Pocket ID...)" Tag="oidc" IsSelected="True"/>
                            <ComboBoxItem Content="Google" Tag="google"/>
                            <ComboBoxItem Content="Microsoft (personal accounts)" Tag="microsoft"/>
                            <ComboBoxItem Content="Discord" Tag="discord"/>
                            <ComboBoxItem Content="Steam" Tag="steam"/>
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="ID (short, like authentik)"/>
                                <TextBox x:Name="ProviderIdText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInProviderId"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Name people see"/>
                                <TextBox x:Name="ProviderNameText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInProviderName"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Issuer URL"/>
                        <TextBox x:Name="ProviderIssuerText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInProviderIssuer"/>
                        <TextBlock Text="Client ID"/>
                        <TextBox x:Name="ProviderClientIdText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInProviderClientId"/>
                        <TextBlock Text="Client secret (leave empty to keep the saved one, or for a public client)"/>
                        <PasswordBox x:Name="ProviderSecretText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInProviderSecret"/>
                        <TextBlock Text="Scopes"/>
                        <TextBox x:Name="ProviderScopesText" Text="openid email profile" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInProviderScopes"/>
                        <TextBlock Text="Loopback port (only for providers that need a registered redirect, such as Discord: register http://127.0.0.1:&lt;port&gt;/ there)"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Name="ProviderPortText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInProviderPort"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save _provider" Click="SaveProvider_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="SignInProviderSave"/>
                            <Button Content="Remove provider" Click="RemoveProvider_Click" AutomationProperties.AutomationId="SignInProviderRemove"/>
                        </StackPanel>
                        <TextBlock Text="Signed in but not allowed yet" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock x:Name="RefusedText" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="SignInRefusedList"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Allow the _newest as one of my computers" Click="AllowRefused_Click" Margin="0,0,10,0"
                                    AutomationProperties.AutomationId="SignInRefusedAllow"/>
                            <Button Content="Allow the newest as a _friend" Click="AllowRefusedFriend_Click"
                                    AutomationProperties.AutomationId="SignInRefusedAllowFriend"
                                    ToolTip="Their computer may then use only this host's engines; it never joins your Martlet network"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Computers that signed in" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="EnrolledText" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="SignInEnrolledList"/>
                        <TextBlock Text="Being removed from your network" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="RemovedText" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="SignInRemovedList"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Invite" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="The invite tells a computer away from home where this host answers and which key to expect. It holds no secret; signing in is what lets a computer in. Send it to a friend too, once their account is allowed as a friend. It starts with the outside addresses your network has for this host (Your Martlet network › Outside addresses); set them there so the computer keeps reaching the host after it joins."/>
                        <TextBlock Text="Outside address(es), separated by spaces"/>
                        <TextBox x:Name="InviteAddressText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInInviteAddress"/>
                        <Button Content="_Make invite" Click="MakeInvite_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="SignInInviteMake"/>
                        <TextBox x:Name="InviteText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                                 AutomationProperties.AutomationId="SignInInviteText"/>
                        <Button x:Name="CopyInviteButton" Content="_Copy invite" Click="CopyInvite_Click" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="Collapsed" AutomationProperties.AutomationId="SignInInviteCopy"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:ThemedWindow>
