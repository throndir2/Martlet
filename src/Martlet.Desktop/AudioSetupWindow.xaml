<Window x:Class="Martlet.Desktop.AudioSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - Local audio setup" Width="840" Height="780" MinWidth="520" MinHeight="420"
        AutomationProperties.AutomationId="AudioSetupWindow" AutomationProperties.Name="Explicit local audio setup"
        Loaded="Window_Loaded" Closing="Window_Closing" Deactivated="Window_Deactivated">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Audio setup - LOCAL tests, not AI" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,8" TextWrapping="Wrap"
                       Text="Opening this window does not enumerate or open devices. Find devices lists local Windows endpoints only, not microphone permission or audibility. Each test needs fresh permission. No recording is saved, no speech recognition/VAD, provider, network or vault access occurs. Settings never authorize listening on launch." />
            <WrapPanel>
                <Button x:Name="FindButton" Content="_Find devices" Click="Find_Click" Margin="0,4,12,4" Padding="10,6"
                        AutomationProperties.AutomationId="AudioFind" AutomationProperties.Name="Find local input and output devices explicitly" />
                <Button x:Name="ReloadButton" Content="_Reload saved choices" Click="Reload_Click" Margin="0,4,12,4" Padding="10,6"
                        AutomationProperties.AutomationId="AudioReload" />
            </WrapPanel>
            <StackPanel x:Name="ChoicesPanel">
                <Label Content="_Microphone" Target="{Binding ElementName=InputChoice}" />
                <ComboBox x:Name="InputChoice" MinHeight="30" SelectionChanged="Choice_Changed"
                          AutomationProperties.AutomationId="AudioInput" AutomationProperties.Name="Microphone fixed endpoint or follow default on next test" />
                <TextBlock TextWrapping="Wrap" Margin="0,6"
                           Text="Default follows only on the NEXT authorized test. A default/input/format change during capture stops and discards; it never reopens. Fixed selection never falls back." />
                <Button x:Name="MicButton" Content="_Test microphone (confirm up to 5 seconds)" Click="Mic_Click" HorizontalAlignment="Left" Padding="10,6"
                        AutomationProperties.AutomationId="AudioTestMic" />
                <Label Content="Actual input _level (amplitude only, NOT speech detection)" Target="{Binding ElementName=LevelText}" />
                <TextBox x:Name="LevelText" IsReadOnly="True" Text="No PCM received." AutomationProperties.AutomationId="AudioLevel"
                         AutomationProperties.Name="Actual selected input peak RMS and sample count" />
                <Label Content="_Output" Target="{Binding ElementName=OutputChoice}" />
                <ComboBox x:Name="OutputChoice" MinHeight="30" SelectionChanged="Choice_Changed"
                          AutomationProperties.AutomationId="AudioOutput" AutomationProperties.Name="Output fixed endpoint or default bound once at start" />
                <TextBlock TextWrapping="Wrap" Margin="0,6"
                           Text="Output binds once at test start; no active switching or fallback. A quiet 200 ms faded 440 Hz synthetic tone is not speech. Check your output, volume and audience first; Martlet does not change volume or system defaults." />
                <WrapPanel>
                    <Button x:Name="OutputButton" Content="Test output (confirm _tone)" Click="Output_Click" Margin="0,4,12,4" Padding="10,6"
                            AutomationProperties.AutomationId="AudioTestOutput" />
                    <Button x:Name="HeardButton" Content="I _heard it on this output" Click="Heard_Click" Margin="0,4,12,4" Padding="10,6" IsEnabled="False"
                            AutomationProperties.AutomationId="AudioHeard" />
                </WrapPanel>
                <Button x:Name="SaveButton" Content="_Save audio choices and historical checkpoints" Click="Save_Click"
                        HorizontalAlignment="Left" Margin="0,8" Padding="10,6" AutomationProperties.AutomationId="AudioSave" />
            </StackPanel>
            <WrapPanel>
                <Button x:Name="StopButton" Content="_Stop current local action" Click="Stop_Click" Margin="0,4,12,4" Padding="10,6"
                        AutomationProperties.AutomationId="AudioStop" />
                <Button x:Name="PauseButton" Content="_Pause local test (discard)" Click="Stop_Click" Margin="0,4,12,4" Padding="10,6"
                        AutomationProperties.AutomationId="AudioPause" />
                <Button Content="_Close audio setup" Click="Close_Click" Margin="0,4,12,4" Padding="10,6"
                        AutomationProperties.AutomationId="AudioClose" />
            </WrapPanel>
            <TextBlock x:Name="ActivityText" TextWrapping="Wrap" Margin="0,6" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Local audio action and ownership" />
            <Label Content="Local _stages and historical evidence" Target="{Binding ElementName=StatusText}" />
            <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="230" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="AudioStatus" AutomationProperties.Name="Local microphone and output outcomes, not provider readiness" />
            <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="AudioResult" AutomationProperties.Name="Audio action result and remedy" />
        </StackPanel>
    </ScrollViewer>
</Window>
