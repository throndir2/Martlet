<local:ThemedWindow x:Class="Martlet.Desktop.AccountProveWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}" Title="Martlet - Sign in"
        Width="480" MinWidth="400" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="ProveWindow">
    <StackPanel Margin="26,24">
        <TextBlock x:Name="HeadingText" Style="{DynamicResource SectionHeading}" TextWrapping="Wrap" Text="Sign in as someone else"
                   AutomationProperties.AutomationId="ProveTitle"/>
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,6,0,14" Style="{DynamicResource Muted}"
                   Text="Sign in with your Martlet user name and password. One of your hosts checks them; the password is never kept on this PC, only a check of it so it can unlock you here later."/>
        <TextBlock Text="Host that checks it"/>
        <ComboBox x:Name="HostChoice" Margin="0,4,0,8" DisplayMemberPath="Label" AutomationProperties.AutomationId="ProveHost"/>
        <TextBlock Text="Sign in with"/>
        <StackPanel x:Name="MethodList" Margin="0,4,0,8" AutomationProperties.AutomationId="ProveMethods">
            <RadioButton x:Name="PasswordMethod" Content="Martlet password" GroupName="ProveMethod" IsChecked="True"
                         AutomationProperties.AutomationId="ProveMethod-martlet"/>
        </StackPanel>
        <StackPanel x:Name="PasswordPanel">
            <TextBlock Text="User name"/>
            <TextBox x:Name="UserText" Margin="0,4,0,8" MaxLength="64" AutomationProperties.AutomationId="ProveUser"/>
            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordText" Margin="0,4,0,8" MaxLength="256" AutomationProperties.AutomationId="ProvePassword"/>
            <TextBlock Text="Authenticator code, when you set one up (or a recovery code)"/>
            <TextBox x:Name="CodeText" FontFamily="Consolas" FontSize="16" Margin="0,4,0,8" MaxLength="16"
                     AutomationProperties.AutomationId="ProveCode"/>
        </StackPanel>
        <CheckBox x:Name="RememberCheck" Content="_Remember me on this PC" IsChecked="True" Margin="0,4,0,0"
                  AutomationProperties.AutomationId="ProveRemember"/>
        <TextBlock x:Name="RememberHint" TextWrapping="Wrap" Margin="22,2,0,0" Style="{DynamicResource Muted}"
                   Text="Off, you are signed out of this PC when Martlet closes."/>
        <Button x:Name="SignInButton" Content="_Sign in" Click="SignIn_Click" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"
                MinWidth="110" Margin="0,14,0,0" IsDefault="True" AutomationProperties.AutomationId="ProveSubmit"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="ProveStatus"/>
        <Button Content="_Close" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" MinWidth="100" Margin="0,14,0,0"
                AutomationProperties.AutomationId="ProveClose"/>
    </StackPanel>
</local:ThemedWindow>
