<local:ThemedWindow x:Class="Martlet.Desktop.HostRunWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}"
        Width="880" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        AutomationProperties.AutomationId="HostRunWindow">
    <DockPanel Margin="24">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" Style="{DynamicResource SectionHeading}"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="_Cancel" Click="Cancel_Click" MinWidth="100" IsCancel="True"
                    AutomationProperties.AutomationId="HostRunCancel"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostRunStatus"/>
        </DockPanel>
        <TextBox x:Name="OutputText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"
                 AutomationProperties.Name="Output from the host" AutomationProperties.AutomationId="HostRunOutput"/>
    </DockPanel>
</local:ThemedWindow>
