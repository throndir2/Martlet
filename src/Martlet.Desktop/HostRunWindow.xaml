<local:ThemedWindow x:Class="Martlet.Desktop.HostRunWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns:presentation="clr-namespace:Martlet.Presentation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}"
        Width="880" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        AutomationProperties.AutomationId="HostRunWindow">
    <DockPanel Margin="24">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" Style="{DynamicResource SectionHeading}"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <!-- Hide (Esc, or the window's close button) only hides a running task: it keeps going in Background tasks.
                 Cancel task asks first. Once it has finished, Hide becomes Close. -->
            <Button x:Name="HideButton" DockPanel.Dock="Right" Content="_Hide" Click="Hide_Click" MinWidth="100" IsCancel="True"
                    ToolTip="Hides this window. The task keeps running in Background tasks."
                    AutomationProperties.AutomationId="HostRunHide"/>
            <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Cancel _task..." Click="Cancel_Click" VerticalAlignment="Center"
                    Margin="0,0,16,0" ToolTip="Stops this task. Martlet asks first."
                    AutomationProperties.AutomationId="HostRunCancel"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HostRunStatus"/>
                <TextBlock x:Name="HideHint" Style="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Hide keeps it running. Find it again in Background tasks in Martlet's main window."
                           AutomationProperties.AutomationId="HostRunHideHint"/>
            </StackPanel>
        </DockPanel>
        <Border x:Name="PairingPanel" DockPanel.Dock="Top" Visibility="Collapsed" Style="{DynamicResource CardStyle}" Margin="0,12,0,0"
                AutomationProperties.AutomationId="HostRunPairing">
            <StackPanel>
                <TextBlock Text="On your main PC, go to Devices &gt; Add a computer &gt; Enter a pairing code and enter:" TextWrapping="Wrap"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Address" Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <TextBlock x:Name="PairingAddressText" Grid.Column="1" FontSize="28" FontWeight="SemiBold" FontFamily="Consolas"
                               AutomationProperties.AutomationId="HostRunPairAddress"/>
                    <TextBlock Grid.Row="1" Text="Code" Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="PairingCodeText" FontSize="40" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="HostRunPairCode"/>
                        <Button x:Name="PairingCopyButton" Content="Copy code" Style="{DynamicResource CopyButton}" Click="CopyPairingCode_Click"
                                VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Copy the code to paste it on your main PC"
                                AutomationProperties.Name="Copy the pairing code" AutomationProperties.AutomationId="HostRunPairCopy"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PairingNoteText" Style="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="HostRunPairNote"
                           Text="The code works once and doesn't expire: it stays valid until your main PC uses it or you cancel here. This PC's host jobs pause until then."/>
            </StackPanel>
        </Border>
        <TextBox x:Name="OutputText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"
                 AutomationProperties.Name="Host output" AutomationProperties.AutomationId="HostRunOutput">
            <!-- Copy (Copy-HostRunOutput) puts which run and its status above the output. -->
            <presentation:CopyText.Context>
                <MultiBinding StringFormat="{}{0}: {1}&#10;Status: {2}">
                    <Binding Source="{x:Static presentation:CopyText.Product}"/>
                    <Binding ElementName="HeadingText" Path="Text"/>
                    <Binding ElementName="StatusText" Path="Text"/>
                </MultiBinding>
            </presentation:CopyText.Context>
        </TextBox>
    </DockPanel>
</local:ThemedWindow>
