<local:ThemedWindow x:Class="Martlet.Desktop.SetupWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        Style="{DynamicResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - AI setup" Width="850" Height="820" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing"
        AutomationProperties.AutomationId="SetupWindow" AutomationProperties.Name="Martlet AI setup">
    <local:ThemedWindow.Resources>
        <local:SetupJobNameConverter x:Key="JobName"/>
    </local:ThemedWindow.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Set up Martlet's AI" Style="{DynamicResource PageTitle}"/>
            <TextBlock Style="{DynamicResource Muted}" Margin="0,6,0,16"
                       Text="Choose how Martlet thinks, listens and speaks. Defaults are filled in to help you get started."/>
            <StackPanel x:Name="EditorPanel">
                <TabControl x:Name="Steps" Style="{DynamicResource StepperTabs}" SelectionChanged="Step_Changed" AutomationProperties.AutomationId="SetupSteps">
                    <TabItem Header="1. _Overview">
                        <StackPanel Margin="12">
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8" Text="Martlet can use OpenAI, OpenRouter, NVIDIA Build or your own compatible server."/>
                            <TextBlock TextWrapping="Wrap" Text="Use OpenAI for listening and speaking, or send those jobs to a paired Martlet host. You can still type if you skip voice."/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="2. _Jobs">
                        <StackPanel Margin="12">
                            <TextBlock TextWrapping="Wrap" Text="Set up thinking, listening and speaking one at a time. You can choose microphones, speakers and paired hosts later."/>
                            <TextBlock x:Name="DisclosureText" TextWrapping="Wrap" Margin="0,8"/>
                            <TextBlock TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://openai.com/api/pricing/" RequestNavigate="Link_Click">API pricing</Hyperlink>
                                <Run Text=" | "/>
                                <Hyperlink NavigateUri="https://platform.openai.com/docs/guides/your-data" RequestNavigate="Link_Click">Data policy</Hyperlink>
                            </TextBlock>
                            <Label Target="{Binding ElementName=RoleChoice}" Content="_Job to set up"/>
                            <ComboBox x:Name="RoleChoice" SelectionChanged="Role_Changed" MinHeight="30" AutomationProperties.AutomationId="SetupRole">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource JobName}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="JobText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="SetupJobText"/>
                            <TextBlock x:Name="BoundaryText" TextWrapping="Wrap" Margin="0,8" Style="{DynamicResource Muted}"/>
                            <StackPanel x:Name="ProviderPanel">
                                <Label Target="{Binding ElementName=ProviderChoice}" Content="_Provider"/>
                                <ComboBox x:Name="ProviderChoice" SelectionChanged="Provider_Changed" MinHeight="30" AutomationProperties.AutomationId="SetupProvider"/>
                            </StackPanel>
                            <StackPanel x:Name="BaseUrlPanel">
                                <Label Target="{Binding ElementName=BaseUrl}" Content="API _base URL"/>
                                <TextBox x:Name="BaseUrl" MaxLength="2048" TextChanged="Route_Changed" AutomationProperties.AutomationId="SetupBaseUrl"/>
                            </StackPanel>
                            <TextBlock x:Name="ProviderHint" TextWrapping="Wrap" Margin="0,4" AutomationProperties.AutomationId="SetupProviderHint"/>
                            <StackPanel x:Name="CatalogPanel">
                                <Label Target="{Binding ElementName=ModelCatalogChoice}" Content="Available _models"/>
                                <ComboBox x:Name="ModelCatalogChoice" MinHeight="30" AutomationProperties.AutomationId="SetupModelCatalog"/>
                                <Button Content="_Use selected model" Click="UseCatalogModel_Click" Padding="8" Margin="0,4"
                                        AutomationProperties.AutomationId="SetupUseCatalogModel"/>
                            </StackPanel>
                            <Label Target="{Binding ElementName=ModelId}" Content="_Model ID"/>
                            <TextBox x:Name="ModelId" MaxLength="128" TextChanged="Route_Changed" AutomationProperties.AutomationId="SetupModel"/>
                            <StackPanel x:Name="VoicePanel">
                                <Label Target="{Binding ElementName=VoiceId}" Content="_Voice"/>
                                <TextBox x:Name="VoiceId" MaxLength="128" TextChanged="Route_Changed" AutomationProperties.AutomationId="SetupVoice"/>
                                <TextBlock x:Name="VoiceHint" TextWrapping="Wrap" Margin="0,4" Style="{DynamicResource Muted}"/>
                            </StackPanel>
                            <CheckBox x:Name="ConsentChoice" Margin="0,12" Checked="Consent_Changed" Unchecked="Consent_Changed" AutomationProperties.AutomationId="SetupConsent">
                                <TextBlock TextWrapping="Wrap" Text="I understand where this job sends data and what the provider may charge."/>
                            </CheckBox>
                            <Button Content="_Apply this job" Click="ApplyRoute_Click" Padding="8" AutomationProperties.AutomationId="SetupApplyRoute"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,8" Style="{DynamicResource Muted}" Text="Apply each job before saving. If you change where a job sends data, confirm it again."/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="3. _Credentials">
                        <StackPanel Margin="12">
                            <TextBlock x:Name="CredentialScope" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,8" Text="Windows Credential Manager stores keys for this profile and destination. Local servers may not need a key."/>
                            <Label Target="{Binding ElementName=KeyInput}" Content="_API key"/>
                            <PasswordBox x:Name="KeyInput" MaxLength="1024" AutomationProperties.AutomationId="SetupKey"/>
                            <Button Content="_Store key..." Click="StoreKey_Click" Padding="8" Margin="0,8" AutomationProperties.AutomationId="SetupStoreKey"/>
                            <Button Content="_Check saved key" Click="ReadKey_Click" Padding="8" Margin="0,4" AutomationProperties.AutomationId="SetupReadKey"/>
                            <Button Content="_Detach key..." Click="DetachKey_Click" Padding="8" Margin="0,4" AutomationProperties.AutomationId="SetupDetachKey"/>
                            <Label Target="{Binding ElementName=RemovalChoice}" Content="Detached key to _remove"/>
                            <ComboBox x:Name="RemovalChoice" MinHeight="30" AutomationProperties.AutomationId="SetupRemoval"/>
                            <Button Content="_Remove detached key..." Click="RemoveKey_Click" Padding="8" Margin="0,4" AutomationProperties.AutomationId="SetupRemoveKey"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,8" Text="Replacing a key leaves the old one listed for removal. Removing a detached key cannot be undone."/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="4. _Review">
                        <TextBlock Margin="12" TextWrapping="Wrap" Text="Review your setup below. You can save before everything is complete and come back later."/>
                    </TabItem>
                </TabControl>
                <WrapPanel Margin="0,12">
                    <Button Content="_Back" Click="Back_Click" Padding="12,8" Margin="0,0,8,0" AutomationProperties.AutomationId="SetupBack"/>
                    <Button Content="_Next" Click="Next_Click" Padding="12,8" Margin="0,0,8,0" Style="{DynamicResource PrimaryButton}" AutomationProperties.AutomationId="SetupNext"/>
                    <Button Content="_Save setup" Click="Save_Click" Padding="12,8" Margin="0,0,8,0" AutomationProperties.AutomationId="SetupSave"/>
                    <Button Content="Save and e_xit setup" Click="SaveExit_Click" Padding="12,8" AutomationProperties.AutomationId="SetupSaveExit"/>
                </WrapPanel>
            </StackPanel>
            <Label Target="{Binding ElementName=SetupStatus}" Content="Setup _status"/>
            <TextBox x:Name="SetupStatus" IsReadOnly="True" TextWrapping="Wrap" Height="170" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="SetupStatus"/>
            <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="55" Margin="0,8"
                     AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SetupResult"/>
            <TextBlock x:Name="OperationActivity" TextWrapping="Wrap" Margin="0,8"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SetupActivity"/>
            <WrapPanel>
                <Button x:Name="CancelButton" Content="_Cancel action" Click="Cancel_Click" Padding="8"
                        AutomationProperties.AutomationId="SetupCancel"/>
                <Button x:Name="ReloadButton" Content="_Reload saved setup..." Click="Reload_Click" Padding="8"
                        AutomationProperties.AutomationId="SetupReload"/>
                <Button Content="Troubleshooting" Click="Troubleshooting_Click" Padding="8" Margin="8,0" AutomationProperties.AutomationId="SetupTroubleshooting"/>
                <Button Content="Backup and restore" Click="Recovery_Click" Padding="8" Margin="8,0" AutomationProperties.AutomationId="SetupRecovery"/>
                <Button Content="_Close setup" Click="Close_Click" Padding="8" Margin="8,0" AutomationProperties.AutomationId="SetupClose"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</local:ThemedWindow>
