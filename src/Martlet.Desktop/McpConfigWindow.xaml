<local:ThemedWindow x:Class="Martlet.Desktop.McpConfigWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns:presentation="clr-namespace:Martlet.Presentation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}"
        Title="Martlet - MCP servers" Width="880" Height="700" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        AutomationProperties.AutomationId="McpConfigWindow">
    <DockPanel Margin="24,20,24,18">
        <TextBlock DockPanel.Dock="Top" Text="MCP servers" Style="{DynamicResource SectionHeading}"/>
        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"><Run Text="Paste a server's &quot;mcpServers&quot; JSON from its setup guide; Martlet saves it as plain text, so keep secrets in environment variables." /><InlineUIContainer BaselineAlignment="Center"><local:HelpTip
                   Text="You can also install a server with Browse MCP directory on the Tools page, which keeps its secrets in Windows Credential Manager."
                   Wiki="Tools-and-MCP#mcp-servers" Margin="6,0,0,0"
                   AutomationProperties.AutomationId="Help-McpConfigAbout" AutomationProperties.Name="About mcp.json" /></InlineUIContainer></TextBlock>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,10" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="McpConfigStatus"/>
            <WrapPanel>
                <Button x:Name="SaveButton" Content="_Save and start" Style="{DynamicResource PrimaryButton}" Click="Save_Click"
                        Margin="0,0,10,6" AutomationProperties.AutomationId="McpConfigSave"/>
                <Button Content="Insert _example" Click="Example_Click" Margin="0,0,10,6" AutomationProperties.AutomationId="McpConfigExample"/>
                <Button Content="_Open folder" Click="Folder_Click" Margin="0,0,10,6" AutomationProperties.AutomationId="McpConfigFolder"/>
                <Button Content="_Close" Click="Close_Click" IsCancel="True" Margin="0,0,0,6" AutomationProperties.AutomationId="McpConfigClose"/>
            </WrapPanel>
        </StackPanel>
        <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10,8" TextChanged="Editor_TextChanged"
                 AutomationProperties.Name="MCP server JSON" AutomationProperties.AutomationId="McpConfigEditor"
                 presentation:InputHint.Text="Paste a server's &quot;mcpServers&quot; JSON here, or choose Insert example"/>
    </DockPanel>
</local:ThemedWindow>
