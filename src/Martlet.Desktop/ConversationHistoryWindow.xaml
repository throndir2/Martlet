<local:ThemedWindow x:Class="Martlet.Desktop.ConversationHistoryWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        Style="{DynamicResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - Conversation history" Width="980" Height="760" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed"
        AutomationProperties.Name="Conversation history">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Conversation history" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,8" TextWrapping="Wrap"
                       Text="Every conversation Martlet has had on this PC: what you typed or said and Martlet's replies. It stays on this PC, and you can delete a conversation or everything at any time." />
            <Label Target="{Binding ElementName=SearchText}" Content="_Search conversations" Padding="0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ShowAllButton" Content="Show _all" Click="ShowAll_Click"
                        Padding="10,5" Margin="8,0,0,0" AutomationProperties.AutomationId="HistoryShowAll" />
                <Button DockPanel.Dock="Right" x:Name="SearchButton" Content="Searc_h" Click="Search_Click" IsDefault="True"
                        Padding="10,5" Margin="8,0,0,0" AutomationProperties.AutomationId="HistorySearchRun" />
                <TextBox x:Name="SearchText" MaxLength="300" AutomationProperties.AutomationId="HistorySearchText"
                         AutomationProperties.Name="Words to search for" />
            </DockPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8" AutomationProperties.AutomationId="HistoryWindowStatus"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Conversation history status" />
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="_Delete this conversation" Click="Delete_Click" Padding="10,6" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="HistoryDeleteConversation" />
            <Button x:Name="DeleteAllButton" Content="Delete _everything" Click="DeleteAll_Click" Padding="10,6" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="HistoryDeleteAll" />
            <Button Content="_Close" Click="Close_Click" IsCancel="True" Padding="10,6" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="HistoryClose" />
        </WrapPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Label DockPanel.Dock="Top" Target="{Binding ElementName=ConversationsList}" Content="Co_nversations" Padding="0,4" />
                <ListBox x:Name="ConversationsList" SelectionChanged="Conversations_SelectionChanged"
                         AutomationProperties.AutomationId="HistoryConversations" AutomationProperties.Name="Recorded conversations" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <Label DockPanel.Dock="Top" Target="{Binding ElementName=ExchangesText}" Content="What was _said" Padding="0,4" />
                <TextBox x:Name="ExchangesText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.AutomationId="HistoryExchanges" AutomationProperties.Name="What was said in the conversation" />
            </DockPanel>
        </Grid>
    </DockPanel>
</local:ThemedWindow>
