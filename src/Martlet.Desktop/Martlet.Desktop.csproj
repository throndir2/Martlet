<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Martlet.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Martlet.ico" />
    <!-- Resemblyzer GE2E voice encoder (Apache-2.0), converted by scripts\Convert-SpeakerEncoder.py for local Voice ID. -->
    <EmbeddedResource Include="Assets\SpeakerEncoder.bin" LogicalName="Martlet.Desktop.SpeakerEncoder.bin" />
    <!-- Streamed over SSH by Prepare this computer; the Linux computer needs no Martlet checkout. -->
    <EmbeddedResource Include="..\..\deploy\host\martlet-prepare" LogicalName="Martlet.Desktop.martlet-prepare" Link="Assets\martlet-prepare" />
    <InternalsVisibleTo Include="Martlet.Desktop.Tests" />
    <Using Include="Martlet.Logging" />
    <ProjectReference Include="..\Martlet.Conversation\Martlet.Conversation.csproj" />
    <ProjectReference Include="..\Martlet.Participation\Martlet.Participation.csproj" />
    <ProjectReference Include="..\Martlet.Credentials.Windows\Martlet.Credentials.Windows.csproj" />
    <ProjectReference Include="..\Martlet.Diagnostics\Martlet.Diagnostics.csproj" />
    <ProjectReference Include="..\Martlet.Support\Martlet.Support.csproj" />
    <ProjectReference Include="..\Martlet.Audio\Martlet.Audio.csproj" />
    <!-- Reduce echo from my speakers: WebRTC's echo canceller (EchoReducer in Martlet.Audio drives it). Only its managed binding
         and webrtc-apm.dll ship; SoundFlow's own audio engine (miniaudio) is never used, so its native libraries are left out. -->
    <ProjectReference Include="..\Martlet.EchoCancellation\Martlet.EchoCancellation.csproj" />
    <PackageReference Include="SoundFlow" ExcludeAssets="native;contentFiles;build;buildTransitive;analyzers" />
    <ProjectReference Include="..\Martlet.Avatar.Hosting\Martlet.Avatar.Hosting.csproj" />
    <ProjectReference Include="..\Martlet.Avatar.Audio2Face\Martlet.Avatar.Audio2Face.csproj" />
    <ProjectReference Include="..\Martlet.F5\Martlet.F5.csproj" />
    <!-- The renderer is a separate executable, not an assembly loaded by Desktop. -->
    <ProjectReference Include="..\Martlet.Avatar.RendererHost\Martlet.Avatar.RendererHost.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Martlet.Memory\Martlet.Memory.csproj" />
    <!-- MCP client: tools from MCP servers on this PC for user-started replies (McpToolService). -->
    <ProjectReference Include="..\Martlet.Mcp.Client\Martlet.Mcp.Client.csproj" />
    <ProjectReference Include="..\Martlet.Home\Martlet.Home.csproj" />
    <!-- Martlet in messaging apps (Companion › Messaging): Telegram's Bot API. -->
    <ProjectReference Include="..\Martlet.Messaging\Martlet.Messaging.csproj" />
    <!-- Martlet's Discord bot (NetCord), hosted in this process: DiscordService. -->
    <ProjectReference Include="..\Martlet.Discord\Martlet.Discord.csproj" />
    <ProjectReference Include="..\Martlet.Sherpa\Martlet.Sherpa.csproj" />
    <!-- Voice recognition (Martlet.Sherpa) is part of Martlet: the unmodified sherpa-onnx 1.13.8 runtime with ONNX Runtime
         (sherpa-onnx-c-api.dll, onnxruntime.dll) ships beside Martlet.Desktop.exe. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" />
    <!-- In-app SSH to Linux Martlet hosts (HostShell). -->
    <PackageReference Include="SSH.NET" />
  </ItemGroup>
  <Target Name="CopyAvatarRenderer" AfterTargets="Build">
    <MSBuild Projects="..\Martlet.Avatar.RendererHost\Martlet.Avatar.RendererHost.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="AvatarRendererTarget" />
    </MSBuild>
    <PropertyGroup>
      <AvatarRendererOutput>@(AvatarRendererTarget->'%(RootDir)%(Directory)')</AvatarRendererOutput>
    </PropertyGroup>
    <ItemGroup>
      <AvatarRendererFiles Include="$(AvatarRendererOutput)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AvatarRendererFiles)" DestinationFiles="@(AvatarRendererFiles->'$(OutDir)AvatarRenderer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- Voice recognition's models ship in voice-recognition\ beside Martlet.Desktop.exe: WeSpeaker ResNet34-LM (CC BY 4.0) and
       pyannote segmentation 3.0 with its LICENSE (MIT); see ..\Martlet.Sherpa\VOICE-RECOGNITION-NOTICES.txt. The build downloads
       each once into obj, checks its pinned SHA-256 (packaging\windows\toolchain.json pins the same) and only then keeps it. -->
  <PropertyGroup>
    <VoiceModelCache>$(BaseIntermediateOutputPath)voice-recognition\</VoiceModelCache>
  </PropertyGroup>
  <ItemGroup>
    <VoiceModel Include="wespeaker_en_voxceleb_resnet34_LM.onnx" Sha256="e9848563da86f263117134dfd7ad63c92355b37de492b55e325400c9d9c39012"
                Url="https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/wespeaker_en_voxceleb_resnet34_LM.onnx" />
    <VoiceModel Include="pyannote-segmentation-3-0\model.onnx" Sha256="220ad67ca923bef2fa91f2390c786097bf305bceb5e261d4af67b38e938e1079"
                Url="https://huggingface.co/csukuangfj/sherpa-onnx-pyannote-segmentation-3-0/resolve/9403a6902bb58e3d5ae8c7e77c3422de279db2e0/model.onnx" />
    <VoiceModel Include="pyannote-segmentation-3-0\LICENSE" Sha256="14d7016ad68e7394d6e6b78d96cc2ae431c905287b89674cfdf021e79e62b8ba"
                Url="https://huggingface.co/csukuangfj/sherpa-onnx-pyannote-segmentation-3-0/resolve/9403a6902bb58e3d5ae8c7e77c3422de279db2e0/LICENSE" />
    <None Include="$(VoiceModelCache)wespeaker_en_voxceleb_resnet34_LM.onnx" Link="voice-recognition\wespeaker_en_voxceleb_resnet34_LM.onnx"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(VoiceModelCache)pyannote-segmentation-3-0\model.onnx" Link="voice-recognition\pyannote-segmentation-3-0\model.onnx"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(VoiceModelCache)pyannote-segmentation-3-0\LICENSE" Link="voice-recognition\pyannote-segmentation-3-0\LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- The sound digest's CPU sound tagger ships in sound-tagging\ beside Martlet.Desktop.exe: the k2-fsa Zipformer small AudioSet
       tagging model (Apache-2.0) and its AudioSet labels (CC BY-SA 4.0); see ..\Martlet.Sherpa\VOICE-RECOGNITION-NOTICES.txt.
       Downloaded and checked like the voice models (toolchain.json voiceModels pins the same). -->
  <PropertyGroup>
    <SoundModelCache>$(BaseIntermediateOutputPath)sound-tagging\</SoundModelCache>
  </PropertyGroup>
  <ItemGroup>
    <SoundModel Include="model.int8.onnx" Sha256="69304b8a1b96bbe6b7d16c24079f0732c65faf3568a14cb82a8238c709afe76c"
                Url="https://huggingface.co/k2-fsa/sherpa-onnx-zipformer-small-audio-tagging-2024-04-15/resolve/c24f9d0fdf7d0b8c0c4f9733aa0cac51fda10c95/model.int8.onnx" />
    <SoundModel Include="class_labels_indices.csv" Sha256="cdd1049833c4b86127c2773ac0d14a2754b6a6d0d1798002ed5c66e699708429"
                Url="https://huggingface.co/k2-fsa/sherpa-onnx-zipformer-small-audio-tagging-2024-04-15/resolve/c24f9d0fdf7d0b8c0c4f9733aa0cac51fda10c95/class_labels_indices.csv" />
    <None Include="$(SoundModelCache)model.int8.onnx" Link="sound-tagging\model.int8.onnx"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(SoundModelCache)class_labels_indices.csv" Link="sound-tagging\class_labels_indices.csv"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="DownloadVoiceModels" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems"
          Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <DownloadFile Condition="!Exists('$(VoiceModelCache)%(VoiceModel.Identity)')" SourceUrl="%(VoiceModel.Url)"
                  DestinationFolder="$(VoiceModelCache)%(VoiceModel.RelativeDir)"
                  DestinationFileName="%(VoiceModel.Filename)%(VoiceModel.Extension).partial" SkipUnchangedFiles="false" Retries="3" />
    <VerifyFileHash Condition="!Exists('$(VoiceModelCache)%(VoiceModel.Identity)')" File="$(VoiceModelCache)%(VoiceModel.Identity).partial"
                    Algorithm="SHA256" Hash="%(VoiceModel.Sha256)" />
    <Copy Condition="!Exists('$(VoiceModelCache)%(VoiceModel.Identity)')" SourceFiles="$(VoiceModelCache)%(VoiceModel.Identity).partial"
          DestinationFiles="$(VoiceModelCache)%(VoiceModel.Identity)" />
    <Delete Files="@(VoiceModel->'$(VoiceModelCache)%(Identity).partial')" />
    <DownloadFile Condition="!Exists('$(SoundModelCache)%(SoundModel.Identity)')" SourceUrl="%(SoundModel.Url)"
                  DestinationFolder="$(SoundModelCache)" DestinationFileName="%(SoundModel.Filename)%(SoundModel.Extension).partial"
                  SkipUnchangedFiles="false" Retries="3" />
    <VerifyFileHash Condition="!Exists('$(SoundModelCache)%(SoundModel.Identity)')" File="$(SoundModelCache)%(SoundModel.Identity).partial"
                    Algorithm="SHA256" Hash="%(SoundModel.Sha256)" />
    <Copy Condition="!Exists('$(SoundModelCache)%(SoundModel.Identity)')" SourceFiles="$(SoundModelCache)%(SoundModel.Identity).partial"
          DestinationFiles="$(SoundModelCache)%(SoundModel.Identity)" />
    <Delete Files="@(SoundModel->'$(SoundModelCache)%(Identity).partial')" />
  </Target>
  <!-- The end-of-turn judge's model ships in turn-detection\ beside Martlet.Desktop.exe: Pipecat's Smart Turn v3.2 int8 CPU model
       (BSD 2-Clause, Daily; see ..\Martlet.Sherpa\VOICE-RECOGNITION-NOTICES.txt), downloaded once into obj at a pinned revision
       and SHA-256 (packaging\windows\toolchain.json pins the same), like the voice models. -->
  <PropertyGroup>
    <TurnModelCache>$(BaseIntermediateOutputPath)turn-detection\</TurnModelCache>
  </PropertyGroup>
  <ItemGroup>
    <TurnModel Include="smart-turn-v3.2-cpu.onnx" Sha256="2bb026316b14a660486a75b1733cd3fbab8c2fd0314dc9af7be49f8cca967e4f"
               Url="https://huggingface.co/pipecat-ai/smart-turn-v3/resolve/f766f81d3cfdf7737ac64aad813d91bbfd56bf93/smart-turn-v3.2-cpu.onnx" />
    <None Include="$(TurnModelCache)smart-turn-v3.2-cpu.onnx" Link="turn-detection\smart-turn-v3.2-cpu.onnx"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="DownloadTurnModel" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems"
          Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <DownloadFile Condition="!Exists('$(TurnModelCache)%(TurnModel.Identity)')" SourceUrl="%(TurnModel.Url)"
                  DestinationFolder="$(TurnModelCache)" DestinationFileName="%(TurnModel.Identity).partial" SkipUnchangedFiles="false" Retries="3" />
    <VerifyFileHash Condition="!Exists('$(TurnModelCache)%(TurnModel.Identity)')" File="$(TurnModelCache)%(TurnModel.Identity).partial"
                    Algorithm="SHA256" Hash="%(TurnModel.Sha256)" />
    <Copy Condition="!Exists('$(TurnModelCache)%(TurnModel.Identity)')" SourceFiles="$(TurnModelCache)%(TurnModel.Identity).partial"
          DestinationFiles="$(TurnModelCache)%(TurnModel.Identity)" />
    <Delete Files="@(TurnModel->'$(TurnModelCache)%(Identity).partial')" />
  </Target>
  <Target Name="PublishAvatarRenderer" AfterTargets="Publish">
    <MSBuild Projects="..\Martlet.Avatar.RendererHost\Martlet.Avatar.RendererHost.csproj"
             Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)AvatarRenderer\;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
  </Target>
</Project>
