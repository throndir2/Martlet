<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Martlet.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Martlet.ico" />
    <!-- Resemblyzer GE2E voice encoder (Apache-2.0), converted by scripts\Convert-SpeakerEncoder.py for local Voice ID. -->
    <EmbeddedResource Include="Assets\SpeakerEncoder.bin" LogicalName="Martlet.Desktop.SpeakerEncoder.bin" />
    <InternalsVisibleTo Include="Martlet.Desktop.Tests" />
    <ProjectReference Include="..\Martlet.Conversation\Martlet.Conversation.csproj" />
    <ProjectReference Include="..\Martlet.Participation\Martlet.Participation.csproj" />
    <ProjectReference Include="..\Martlet.Credentials.Windows\Martlet.Credentials.Windows.csproj" />
    <ProjectReference Include="..\Martlet.Diagnostics\Martlet.Diagnostics.csproj" />
    <ProjectReference Include="..\Martlet.Support\Martlet.Support.csproj" />
    <ProjectReference Include="..\Martlet.Audio\Martlet.Audio.csproj" />
    <ProjectReference Include="..\Martlet.Avatar.Hosting\Martlet.Avatar.Hosting.csproj" />
    <ProjectReference Include="..\Martlet.Avatar.Audio2Face\Martlet.Avatar.Audio2Face.csproj" />
    <!-- The renderer is a separate executable, not an assembly loaded by Desktop. -->
    <ProjectReference Include="..\Martlet.Avatar.RendererHost\Martlet.Avatar.RendererHost.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Martlet.Memory\Martlet.Memory.csproj" />
  </ItemGroup>
  <Target Name="CopyAvatarRenderer" AfterTargets="Build">
    <MSBuild Projects="..\Martlet.Avatar.RendererHost\Martlet.Avatar.RendererHost.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="AvatarRendererTarget" />
    </MSBuild>
    <PropertyGroup>
      <AvatarRendererOutput>@(AvatarRendererTarget->'%(RootDir)%(Directory)')</AvatarRendererOutput>
    </PropertyGroup>
    <ItemGroup>
      <AvatarRendererFiles Include="$(AvatarRendererOutput)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AvatarRendererFiles)" DestinationFiles="@(AvatarRendererFiles->'$(OutDir)AvatarRenderer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishAvatarRenderer" AfterTargets="Publish">
    <MSBuild Projects="..\Martlet.Avatar.RendererHost\Martlet.Avatar.RendererHost.csproj"
             Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)AvatarRenderer\;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
  </Target>
</Project>
