<local:ThemedWindow x:Class="Martlet.Desktop.CompanionWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns:presentation="clr-namespace:Martlet.Presentation"
        Style="{DynamicResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - Personality" Width="850" Height="820" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        AutomationProperties.AutomationId="CompanionWindow"
        AutomationProperties.Name="Edit companion personas">
    <DockPanel>
        <!-- Always in view: whether every change is saved, and Done. There is no Save button; changes save on their own. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Done" Click="Close_Click" Padding="16,7" Style="{DynamicResource PrimaryButton}"
                        AutomationProperties.AutomationId="CompanionClose"/>
                <TextBlock x:Name="SaveStateText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CompanionSaveState"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="Personality" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Margin="0,8"><Run Text="Choose the persona Martlet uses and edit it."/><InlineUIContainer BaselineAlignment="Center"><local:HelpTip
                               Margin="6,0,0,0" AutomationProperties.AutomationId="Help-CompanionAbout" AutomationProperties.Name="About personas"
                               Wiki="Personality-and-Characters#personas"
                               Text="Changes save as you go, and Martlet's next reply uses them."/></InlineUIContainer></TextBlock>
                <StackPanel x:Name="EditorPanel">
                    <Label Target="{Binding ElementName=PersonaChoice}" Content="_Persona Martlet uses"/>
                    <ComboBox x:Name="PersonaChoice" MinHeight="30" DisplayMemberPath="Name"
                              SelectionChanged="Persona_Changed" AutomationProperties.AutomationId="CompanionPersona"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="_New" Click="New_Click" Padding="10,6" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="CompanionNew"/>
                        <Button Content="Dupli_cate" Click="Duplicate_Click" Padding="10,6" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="CompanionDuplicate"/>
                        <Button Content="De_lete" Click="Delete_Click" Padding="10,6" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="CompanionDelete"/>
                        <Button Content="Ne_w from card..." Click="CardNew_Click" Padding="10,6" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="CompanionCardNew"/>
                        <Button Content="_Update from card..." Click="CardUpdate_Click" Padding="10,6" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="CompanionCardUpdate"/>
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Style="{DynamicResource Muted}"><Run Text="Character cards (PNG, JSON or CHARX) add a persona or update this one."/><InlineUIContainer BaselineAlignment="Center"><local:HelpTip
                               Margin="6,0,0,0" AutomationProperties.AutomationId="Help-CompanionCards" AutomationProperties.Name="About character cards"
                               Wiki="Personality-and-Characters#character-cards"
                               Text="You can also drop a card on this window. Use the original PNG from SillyTavern or Chub: a resaved or converted copy loses the card."/></InlineUIContainer></TextBlock>
                    <Label Target="{Binding ElementName=PersonaName}" Content="Persona na_me" Margin="0,8,0,0"/>
                    <TextBox x:Name="PersonaName" MaxLength="64" TextChanged="Editor_Changed"
                             AutomationProperties.AutomationId="CompanionName" presentation:InputHint.Text="Luna"/>
                    <Label Target="{Binding ElementName=PersonaText}" Content="Persona _instructions"/>
                    <TextBox x:Name="PersonaText" MaxLength="100000" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="220" VerticalScrollBarVisibility="Auto" TextChanged="Editor_Changed"
                             AutomationProperties.AutomationId="CompanionText"
                             presentation:InputHint.Text="You are Luna, a warm and curious companion who keeps replies short and kind."/>
                    <TextBlock TextWrapping="Wrap" Style="{DynamicResource Muted}" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="CompanionTextHelp" AutomationProperties.Name="This is the character's part of the system prompt."><Run Text="This is the character's part of the system prompt."/><InlineUIContainer BaselineAlignment="Center"><local:HelpTip
                               Margin="6,0,0,0" AutomationProperties.AutomationId="Help-CompanionTextHelp" AutomationProperties.Name="About the persona instructions"
                               Wiki="Personality-and-Characters#personas"
                               Text="Martlet adds its own instructions after it (reply length, tools, what it hears) and tells the model to treat your headings and rules as the character's own. You don't need a separate system prompt: see or edit Martlet's part in Companion › Prompts › Persona. Martlet greets you in character when it starts, and Check-ins › Staying in character reminds it when it drifts."/></InlineUIContainer></TextBlock>
                    <WrapPanel Margin="0,8">
                        <Button Content="Import te_xt..." Click="Import_Click" Padding="10,6" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="CompanionImport"/>
                        <Button Content="_Export text..." Click="Export_Click" Padding="10,6"
                                AutomationProperties.AutomationId="CompanionExport"/>
                    </WrapPanel>
                    <TextBlock Text="Where the voice pauses" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <TextBlock TextWrapping="Wrap" Style="{DynamicResource Muted}"><Run Text="Choose which sentence ends this persona's voice may pause at."/><InlineUIContainer BaselineAlignment="Center"><local:HelpTip
                               Margin="6,0,0,0" AutomationProperties.AutomationId="Help-CompanionVoicePauses" AutomationProperties.Name="About where the voice pauses"
                               Wiki="Personality-and-Characters#where-the-voice-pauses"
                               Text="Martlet speaks a reply a piece at a time while it's written, so the voice starts sooner. Each piece is said on its own, so a break in the wrong place can sound awkward; commas, semicolons and dashes never break it."/></InlineUIContainer></TextBlock>
                    <CheckBox x:Name="BreakPeriods" Content="Pe_riods" Margin="0,8,0,0" Checked="Break_Changed" Unchecked="Break_Changed"
                              AutomationProperties.AutomationId="CompanionBreakPeriods"/>
                    <CheckBox x:Name="BreakQuestions" Content="_Question marks" Margin="0,6,0,0" Checked="Break_Changed" Unchecked="Break_Changed"
                              AutomationProperties.AutomationId="CompanionBreakQuestions"/>
                    <CheckBox x:Name="BreakExclamations" Content="Exclamation mar_ks" Margin="0,6,0,0" Checked="Break_Changed" Unchecked="Break_Changed"
                              AutomationProperties.AutomationId="CompanionBreakExclamations"/>
                    <Label Target="{Binding ElementName=ShortEnding}" Content="Say a short endin_g with the words before it" Margin="0,8,0,0"/>
                    <ComboBox x:Name="ShortEnding" MinHeight="30" HorizontalAlignment="Left" MinWidth="220" SelectionChanged="ShortEnding_Changed"
                              AutomationProperties.AutomationId="CompanionShortEnding">
                        <ComboBoxItem Content="Never"/>
                        <ComboBoxItem Content="1 word"/>
                        <ComboBoxItem Content="Up to 2 words"/>
                        <ComboBoxItem Content="Up to 3 words"/>
                        <ComboBoxItem Content="Up to 4 words"/>
                        <ComboBoxItem Content="Up to 5 words"/>
                    </ComboBox>
                    <TextBlock TextWrapping="Wrap" Style="{DynamicResource Muted}" Margin="0,6,0,0"><Run Text="A short ending such as &quot;Cutie!&quot; is then said in one go with the sentence before it."/><InlineUIContainer BaselineAlignment="Center"><local:HelpTip
                               Margin="6,0,0,0" AutomationProperties.AutomationId="Help-CompanionShortEnding" AutomationProperties.Name="About short endings"
                               Wiki="Personality-and-Characters#where-the-voice-pauses"
                               Text="A piece that has grown long still breaks at the next sentence end, so the voice can say it."/></InlineUIContainer></TextBlock>
                </StackPanel>
                <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" Margin="0,14,0,0"
                         AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CompanionResult"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:ThemedWindow>
