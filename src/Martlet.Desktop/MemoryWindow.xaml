<local:ThemedWindow x:Class="Martlet.Desktop.MemoryWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        Style="{DynamicResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - Memory" Width="900" Height="850" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing"
        AutomationProperties.Name="Memory settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Memory" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,8" TextWrapping="Wrap"
                       Text="Martlet can remember lasting facts from your conversations and use them later. Everything is stored on this PC, and you can edit or delete it anytime." />
            <WrapPanel>
                <Button x:Name="ReloadButton" Content="_Reload" Click="Reload_Click"
                        Padding="10,6" Margin="0,4,8,4" AutomationProperties.AutomationId="MemoryReload" />
                <Button x:Name="RetryCleanupButton" Content="Retry _cleanup" Click="RetryCleanup_Click"
                        Padding="10,6" Margin="0,4,8,4" AutomationProperties.AutomationId="MemoryRetryCleanup" />
                <Button Content="_Close" Click="Close_Click" Padding="10,6" Margin="0,4,8,4"
                        AutomationProperties.AutomationId="MemoryClose" />
            </WrapPanel>

            <TextBlock Text="Storage" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4" />
            <RadioButton x:Name="AppLocalChoice" GroupName="Storage" Content="Use Martlet folder"
                         Checked="Configuration_Changed" AutomationProperties.AutomationId="MemoryAppLocal" />
            <RadioButton x:Name="CustomChoice" GroupName="Storage" Content="Use custom folder"
                         Checked="Configuration_Changed" Margin="0,4" AutomationProperties.AutomationId="MemoryCustom" />
            <Label Target="{Binding ElementName=CustomDirectory}" Content="Custom _folder" />
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BrowseDirectoryButton" Content="_Browse" Click="BrowseDirectory_Click"
                        Padding="10,5" Margin="8,0,0,0" AutomationProperties.AutomationId="MemoryBrowseDirectory" />
                <TextBox x:Name="CustomDirectory" TextChanged="ConfigurationText_Changed"
                         AutomationProperties.AutomationId="MemoryCustomDirectory" />
            </DockPanel>
            <TextBlock x:Name="ResolvedDirectoryText" Margin="0,5" TextWrapping="Wrap"
                       AutomationProperties.Name="Memory folder" />
            <CheckBox x:Name="EnableChoice" Content="Remember facts from conversations"
                      Checked="Configuration_Changed" Unchecked="Configuration_Changed" Margin="0,8,0,4"
                      AutomationProperties.AutomationId="MemoryEnable" />
            <Button x:Name="SaveConfigurationButton" Content="_Save settings" Click="SaveConfiguration_Click"
                    Padding="10,7" Margin="0,6,0,6" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="MemorySaveConfiguration" />
            <TextBox x:Name="ConfigurationStatus" IsReadOnly="True" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="MemoryStatus" AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="Memory configuration status" />

            <TextBlock Text="Remembered facts" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="Add, edit or delete facts Martlet can remember." TextWrapping="Wrap" />
            <WrapPanel>
                <Button x:Name="RefreshFactsButton" Content="_Refresh facts" Click="RefreshFacts_Click"
                        Padding="10,6" Margin="0,6,8,6" AutomationProperties.AutomationId="MemoryRefreshFacts" />
                <Button x:Name="PurgeExpiredButton" Content="_Delete expired facts" Click="PurgeExpired_Click"
                        Padding="10,6" Margin="0,6,8,6" AutomationProperties.AutomationId="MemoryPurgeExpired" />
            </WrapPanel>
            <Label Target="{Binding ElementName=FactContent}" Content="_Fact" />
            <TextBox x:Name="FactContent" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096" Height="90"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="MemoryFactContent" />
            <Label Target="{Binding ElementName=RetentionChoice}" Content="_Retention" />
            <ComboBox x:Name="RetentionChoice" MinHeight="30" AutomationProperties.AutomationId="MemoryRetention" />
            <WrapPanel>
                <Button x:Name="SaveFactButton" Content="_Save new fact" Click="SaveFact_Click"
                        Padding="10,6" Margin="0,6,8,6" AutomationProperties.AutomationId="MemorySaveFact" />
                <Button x:Name="EditFactButton" Content="_Edit selected fact" Click="EditFact_Click"
                        Padding="10,6" Margin="0,6,8,6" AutomationProperties.AutomationId="MemoryEditFact" />
                <Button x:Name="DeleteFactButton" Content="_Delete selected fact" Click="DeleteFact_Click"
                        Padding="10,6" Margin="0,6,8,6" AutomationProperties.AutomationId="MemoryDeleteFact" />
            </WrapPanel>
            <Label Target="{Binding ElementName=FactsList}" Content="Remembered _facts" />
            <ListBox x:Name="FactsList" Height="150" DisplayMemberPath="Content" SelectionChanged="FactsList_SelectionChanged"
                     AutomationProperties.AutomationId="MemoryFacts" AutomationProperties.Name="Saved local facts" />
            <Label Target="{Binding ElementName=FactDetails}" Content="Selected fact _details" />
            <TextBox x:Name="FactDetails" IsReadOnly="True" TextWrapping="Wrap" Height="100"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="MemoryFactDetails" />
            <TextBlock x:Name="FactStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Memory fact action status" />

            <TextBlock Text="Export memory" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock TextWrapping="Wrap"
                       Text="Preview the JSON before creating a local export. Martlet won't upload it or overwrite files." />
            <Button x:Name="CreateExportPreviewButton" Content="_Preview export" Click="CreateExportPreview_Click"
                    Padding="10,6" Margin="0,6,0,6" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="MemoryCreateExportPreview" />
            <TextBlock x:Name="ExportSummary" TextWrapping="Wrap" AutomationProperties.Name="Export summary" />
            <TextBox x:Name="ExportPreviewText" IsReadOnly="True" TextWrapping="NoWrap" Height="180"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="MemoryExportPreview" AutomationProperties.Name="Memory export preview" />
            <Label Target="{Binding ElementName=ExportDestination}" Content="Save export _as" />
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BrowseExportButton" Content="B_rowse" Click="BrowseExport_Click"
                        Padding="10,5" Margin="8,0,0,0" AutomationProperties.AutomationId="MemoryBrowseExport" />
                <TextBox x:Name="ExportDestination" TextChanged="ExportDestination_Changed"
                         AutomationProperties.AutomationId="MemoryExportDestination" />
            </DockPanel>
            <CheckBox x:Name="AcceptExport" Margin="0,8,0,4"
                      Content="Create this local export"
                      Checked="ExportConsent_Changed" Unchecked="ExportConsent_Changed"
                      AutomationProperties.AutomationId="MemoryAcceptExport" />
            <TextBlock Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                       Text="Martlet writes the reviewed JSON to your selected file and doesn't upload it." />
            <Button x:Name="ExportButton" Content="_Create export" Click="Export_Click"
                    Padding="10,7" Margin="0,6,0,6" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="MemoryExport" />
            <TextBlock x:Name="ExportStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Memory export status" />
        </StackPanel>
    </ScrollViewer>
</local:ThemedWindow>
