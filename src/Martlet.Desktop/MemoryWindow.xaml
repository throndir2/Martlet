<local:ThemedWindow x:Class="Martlet.Desktop.MemoryWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        Style="{DynamicResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - Memory" Width="980" Height="860" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing"
        AutomationProperties.Name="Memory settings">
    <DockPanel>
        <!-- Always in view: Refresh, Retry cleanup (only while cleanup is pending) and Close. Choices save as they change. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Close" Click="Close_Click" Padding="16,7" Style="{DynamicResource PrimaryButton}"
                        AutomationProperties.AutomationId="MemoryClose" />
                <Button DockPanel.Dock="Right" x:Name="ReloadButton" Content="_Refresh" Click="Reload_Click"
                        Padding="12,7" Margin="0,0,8,0" AutomationProperties.AutomationId="MemoryReload" />
                <Button DockPanel.Dock="Right" x:Name="RetryCleanupButton" Content="Retry clean_up" Click="RetryCleanup_Click"
                        Padding="12,7" Margin="0,0,8,0" Visibility="Collapsed" AutomationProperties.AutomationId="MemoryRetryCleanup" />
                <!-- No accessible name: a text block's name is its text, which screen readers announce and MCP reads (fixed text, never a fact or a path). -->
                <TextBlock x:Name="ConfigurationStatus" Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.AutomationId="MemoryStatus" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="Memory" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Style="{DynamicResource Muted}" Margin="0,4,0,10"
                           Text="Lasting facts Martlet remembers about you and the people it knows by voice. They stay on your computers, and you can search, change or delete them here, or just ask Martlet to." />
                <CheckBox x:Name="EnableChoice" Content="Remember facts from conversations"
                          Checked="Configuration_Changed" Unchecked="Configuration_Changed" Margin="0,0,0,12"
                          AutomationProperties.AutomationId="MemoryEnable" />
                <!-- Shown with accounts: new facts about you go to the household's memories, which every character reads. -->
                <CheckBox x:Name="ShareAboutMeChoice" Content="Share new memories about me with the household" Visibility="Collapsed"
                          Checked="ShareAboutMe_Changed" Unchecked="ShareAboutMe_Changed" Margin="0,-6,0,12"
                          AutomationProperties.AutomationId="MemoryShareAboutMe"
                          ToolTip="New facts Martlet learns about you go to the household's memories. Every character in the household remembers them." />

                <Border Style="{DynamicResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <!-- Find and pick facts. -->
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" MinWidth="170" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Target="{Binding ElementName=SearchBox}" Content="_Search" Padding="0,0,0,3" />
                                    <TextBox x:Name="SearchBox" Height="35" Padding="8,0" VerticalContentAlignment="Center" TextWrapping="NoWrap" TextChanged="Search_Changed"
                                             AutomationProperties.AutomationId="MemorySearch" AutomationProperties.Name="Search remembered facts"
                                             ToolTip="Words in a fact or the name of whose it is" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Target="{Binding ElementName=PersonFilter}" Content="Sho_w" Padding="0,0,0,3" />
                                    <ComboBox x:Name="PersonFilter" MinHeight="30" SelectionChanged="PersonFilter_SelectionChanged"
                                              AutomationProperties.AutomationId="MemoryPersonFilter" AutomationProperties.Name="Whose facts to show" />
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="FactsList" Height="340" Margin="0,8,0,6" SelectionMode="Extended"
                                     SelectionChanged="FactsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="MemoryFacts" AutomationProperties.Name="Remembered facts">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Fact.Content}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Caption}" Style="{DynamicResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- No accessible name: a text block's name is its text, which screen readers announce and MCP reads (counts only). -->
                            <TextBlock x:Name="FactStatus" Style="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="MemoryFactStatus" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="DeleteFactButton" Content="_Delete selected" Click="DeleteFact_Click"
                                        Padding="10,6" Margin="0,0,8,6" AutomationProperties.AutomationId="MemoryDeleteFact" />
                                <Button x:Name="DeleteShownButton" Content="Delete all _shown" Click="DeleteShown_Click"
                                        Padding="10,6" Margin="0,0,8,6" AutomationProperties.AutomationId="MemoryDeleteShown" />
                                <Button x:Name="DeleteAllButton" Content="Delete _everything" Click="DeleteAll_Click"
                                        Padding="10,6" Margin="0,0,8,6" AutomationProperties.AutomationId="MemoryDeleteAll" />
                            </WrapPanel>
                            <!-- Shown with accounts: copy or move the selected facts to the household or to another person. -->
                            <StackPanel x:Name="SharePanel" Margin="0,4,0,0" Visibility="Collapsed">
                                <Label Target="{Binding ElementName=ShareTarget}" Content="S_hare selected with" Padding="0,0,0,3" />
                                <WrapPanel>
                                    <ComboBox x:Name="ShareTarget" MinHeight="30" MinWidth="220" Margin="0,0,8,6"
                                              AutomationProperties.AutomationId="MemoryShareTarget" AutomationProperties.Name="Where to share the selected facts" />
                                    <Button x:Name="ShareCopyButton" Content="Cop_y" Click="ShareCopy_Click" Padding="10,6" Margin="0,0,8,6"
                                            AutomationProperties.AutomationId="MemoryShareCopy" />
                                    <Button x:Name="ShareMoveButton" Content="_Move" Click="ShareMove_Click" Padding="10,6" Margin="0,0,8,6"
                                            AutomationProperties.AutomationId="MemoryShareMove" />
                                </WrapPanel>
                                <!-- No accessible name: a text block's name is its text, which MCP reads (counts and fixed text only). -->
                                <TextBlock x:Name="ShareStatus" Style="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.AutomationId="MemoryShareStatus" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Write a new fact, or change the one selected. -->
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="EditorHeading" Text="New fact" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Label Target="{Binding ElementName=FactContent}" Content="_Fact" Padding="0,0,0,3" />
                            <TextBox x:Name="FactContent" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096" Height="110"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="MemoryFactContent" />
                            <Label Target="{Binding ElementName=PersonChoice}" Content="Belongs _to" Padding="0,8,0,3" />
                            <ComboBox x:Name="PersonChoice" MinHeight="30" AutomationProperties.AutomationId="MemoryPerson"
                                      AutomationProperties.Name="Whose fact it is" />
                            <Label Target="{Binding ElementName=RetentionChoice}" Content="_Keep it" Padding="0,8,0,3" />
                            <ComboBox x:Name="RetentionChoice" MinHeight="30" AutomationProperties.AutomationId="MemoryRetention" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="EditFactButton" Content="Save _changes" Click="EditFact_Click" Style="{DynamicResource PrimaryButton}"
                                        Padding="10,6" Margin="0,0,8,6" AutomationProperties.AutomationId="MemoryEditFact" />
                                <Button x:Name="SaveFactButton" Content="_Add fact" Click="SaveFact_Click"
                                        Padding="10,6" Margin="0,0,8,6" AutomationProperties.AutomationId="MemorySaveFact" />
                                <Button x:Name="NewFactButton" Content="_New" Click="NewFact_Click"
                                        Padding="10,6" Margin="0,0,8,6" AutomationProperties.AutomationId="MemoryNewFact" />
                            </WrapPanel>
                            <TextBlock x:Name="FactDetails" Style="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="MemoryFactDetails" AutomationProperties.Name="Selected fact details" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Header="Where memory is stored" Margin="0,0,0,10" AutomationProperties.AutomationId="MemoryStorageSection">
                    <StackPanel Margin="4,8,0,0">
                        <RadioButton x:Name="AppLocalChoice" GroupName="Storage" Content="Use Martlet folder"
                                     Checked="Configuration_Changed" AutomationProperties.AutomationId="MemoryAppLocal" />
                        <RadioButton x:Name="CustomChoice" GroupName="Storage" Content="Use custom folder"
                                     Checked="Configuration_Changed" Margin="0,4" AutomationProperties.AutomationId="MemoryCustom" />
                        <Label Target="{Binding ElementName=CustomDirectory}" Content="Custom _folder" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="BrowseDirectoryButton" Content="_Browse" Click="BrowseDirectory_Click"
                                    Padding="10,5" Margin="8,0,0,0" AutomationProperties.AutomationId="MemoryBrowseDirectory" />
                            <TextBox x:Name="CustomDirectory" TextChanged="ConfigurationText_Changed" LostKeyboardFocus="CustomDirectory_LostFocus"
                                     KeyDown="CustomDirectory_KeyDown" AutomationProperties.AutomationId="MemoryCustomDirectory" />
                        </DockPanel>
                        <!-- No Save button: these choices save as soon as they change (a typed folder when you leave the field or press Enter). -->
                        <TextBlock x:Name="ResolvedDirectoryText" Style="{DynamicResource Muted}" Margin="0,5"
                                   AutomationProperties.Name="Memory folder" />
                    </StackPanel>
                </Expander>

                <Expander Header="Export to a file" AutomationProperties.AutomationId="MemoryExportSection">
                    <StackPanel Margin="4,8,0,0">
                        <TextBlock Style="{DynamicResource Muted}"
                                   Text="Preview the JSON before creating a local export. Martlet won't upload it or overwrite files." />
                        <Button x:Name="CreateExportPreviewButton" Content="_Preview export" Click="CreateExportPreview_Click"
                                Padding="10,6" Margin="0,6,0,6" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="MemoryCreateExportPreview" />
                        <TextBlock x:Name="ExportSummary" AutomationProperties.Name="Export summary" />
                        <TextBox x:Name="ExportPreviewText" IsReadOnly="True" TextWrapping="NoWrap" Height="180"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="MemoryExportPreview" AutomationProperties.Name="Memory export preview" />
                        <Label Target="{Binding ElementName=ExportDestination}" Content="Save export _as" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="BrowseExportButton" Content="B_rowse" Click="BrowseExport_Click"
                                    Padding="10,5" Margin="8,0,0,0" AutomationProperties.AutomationId="MemoryBrowseExport" />
                            <TextBox x:Name="ExportDestination" TextChanged="ExportDestination_Changed"
                                     AutomationProperties.AutomationId="MemoryExportDestination" />
                        </DockPanel>
                        <CheckBox x:Name="AcceptExport" Margin="0,8,0,4"
                                  Content="Create this local export"
                                  Checked="ExportConsent_Changed" Unchecked="ExportConsent_Changed"
                                  AutomationProperties.AutomationId="MemoryAcceptExport" />
                        <Button x:Name="ExportButton" Content="Create e_xport" Click="Export_Click"
                                Padding="10,7" Margin="0,6,0,6" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="MemoryExport" />
                        <TextBlock x:Name="ExportStatus" AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Memory export status" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:ThemedWindow>
