<local:ThemedWindow x:Class="Martlet.Desktop.HostsWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}"
        Title="Martlet - Add a computer" Width="1000" Height="780" MinWidth="720" MinHeight="520"
        Loaded="Window_Loaded" Closed="Window_Closed" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="HostsWindow">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource SoftBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="_Back" Click="Back_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="HostsBack"/>
                    <Button x:Name="NextButton" Content="_Next" Click="Next_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="HostsNext"/>
                    <Button Content="_Close" IsCancel="True" Click="Close_Click" AutomationProperties.AutomationId="HostsClose"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="HostStatus"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="232" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" Padding="14,24">
            <StackPanel>
                <TextBlock Text="Add a computer" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,4"/>
                <TextBlock Style="{DynamicResource Muted}" FontSize="12" Margin="10,0,0,20" TextWrapping="Wrap"
                           Text="Use another PC to run heavy Martlet jobs."/>
                <RadioButton x:Name="Rail0" GroupName="Rail" Style="{DynamicResource RailStep}" Tag="1" Content="Connect" Checked="Rail_Checked"
                             AutomationProperties.AutomationId="HostsStepConnect"/>
                <RadioButton x:Name="Rail1" GroupName="Rail" Style="{DynamicResource RailStep}" Tag="2" Content="Roles" Checked="Rail_Checked"
                             AutomationProperties.AutomationId="HostsStepRoles"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,28" MaxWidth="760" HorizontalAlignment="Left">
                <StackPanel x:Name="ConnectStep">
                    <TextBlock Text="Connect a computer" Style="{DynamicResource PageTitle}"/>
                    <TextBlock Style="{DynamicResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap"
                               Text="Pick a Martlet host on your network, or set up a new one. Then choose which jobs it runs."/>

                    <Border x:Name="NearbyCard" Style="{DynamicResource CardStyle}" AutomationProperties.AutomationId="NearbyCard">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="NearbyFindButton" DockPanel.Dock="Right" Content="_Find again" Click="NearbyFind_Click" VerticalAlignment="Top"
                                        Margin="16,0,0,0" AutomationProperties.AutomationId="NearbyFind"/>
                                <StackPanel>
                                    <TextBlock Text="Martlet on your network" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Pick a computer, then press Allow on it when both show the same check number. Nothing to type."/>
                                </StackPanel>
                            </DockPanel>
                            <!-- One row per Martlet that answered, built in code (NearbyItem-n, NearbyConnect-n). -->
                            <StackPanel x:Name="NearbyList" Margin="0,8,0,0"/>
                            <TextBlock x:Name="NearbyStatusText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="NearbyStatus" AutomationProperties.LiveSetting="Polite"/>
                            <Border x:Name="NearbyCheckPanel" Visibility="Collapsed" Background="{DynamicResource SoftBrush}" CornerRadius="12"
                                    Padding="16,12" Margin="0,12,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="_Stop asking" Click="NearbyCancel_Click" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="NearbyCancel"/>
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Muted}" Text="Check number (the other computer shows the same)"/>
                                        <TextBlock x:Name="NearbyNumberText" FontSize="36" FontWeight="Bold" FontFamily="Consolas"
                                                   AutomationProperties.AutomationId="NearbyNumber"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="0,14,0,0">
                                <Button x:Name="EnterCodeButton" DockPanel.Dock="Right" Content="_Enter a pairing code" Click="EnterCode_Click"
                                        VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.AutomationId="HostsEnterCode"/>
                                <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Not listed? Guest Wi-Fi, a VPN, another subnet or a firewall can hide it. Enter the address and pairing code it shows instead."/>
                            </DockPanel>
                            <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Margin="0,12,0,0" AutomationProperties.AutomationId="ManualPanel">
                                <TextBlock x:Name="PairCodeHelp" Style="{DynamicResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="PairCodeHelp"
                                           Text="On the other computer, choose Show a pairing code in Martlet (or run martlet-host pair on a Linux host), then enter the address and code it shows. The code works until it's used or canceled there."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Target="{Binding ElementName=PairAddressText}" Content="Host _address" Padding="0,0,0,4"/>
                                        <TextBox x:Name="PairAddressText" FontSize="16" AutomationProperties.AutomationId="PairAddress"
                                                 AutomationProperties.Name="Host address shown with the code"
                                                 ToolTip="The address shown on the host, like 192.168.1.20"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Target="{Binding ElementName=PairingCodeBox}" Content="C_ode" Padding="0,0,0,4"/>
                                        <TextBox x:Name="PairingCodeBox" FontSize="16" FontFamily="Consolas" MaxLength="2048" KeyDown="PairingCode_KeyDown"
                                                 AutomationProperties.AutomationId="PairingCode" AutomationProperties.Name="Pairing code from the host"
                                                 ToolTip="The code shown on the host, like K7QM-4XPA"/>
                                    </StackPanel>
                                    <Button x:Name="PairHostButton" Grid.Column="3" Content="_Pair with host" Click="Pair_Click" Style="{DynamicResource PrimaryButton}"
                                            VerticalAlignment="Bottom" Margin="12,0,0,0" AutomationProperties.AutomationId="PairHost"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Or set up a new host" FontWeight="SemiBold" FontSize="16" Margin="0,22,0,10"/>
                    <Border Style="{DynamicResource CardStyle}" AutomationProperties.AutomationId="NewHostThisPc">
                        <DockPanel>
                            <Button x:Name="SetupThisPcButton" DockPanel.Dock="Right" Content="Set up _this PC" Click="SetupThisPc_Click"
                                    VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.AutomationId="SetupThisPc"/>
                            <StackPanel>
                                <TextBlock Text="This PC" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="DockerStateText" Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="DockerState"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource CardStyle}" AutomationProperties.AutomationId="NewHostSsh">
                        <StackPanel>
                            <TextBlock Text="A Linux computer over SSH" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                                       Text="Martlet signs in once, runs the host in Docker when the computer has it (or installs it natively on Ubuntu 24.04), then connects automatically."/>
                            <Label Target="{Binding ElementName=SshTargetText}" Content="SSH _target (user@computer)" Padding="0,0,0,4"/>
                            <DockPanel>
                                <Button x:Name="SetupButton" DockPanel.Dock="Right" Content="Set up over _SSH" Click="Setup_Click"
                                        Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" AutomationProperties.AutomationId="SetupHost"/>
                                <Button DockPanel.Dock="Right" Content="Reset SSH _trust" Click="ResetSshTrust_Click" Margin="8,0,0,0"
                                        ToolTip="Reset saved SSH trust for this computer"
                                        AutomationProperties.AutomationId="ResetSshTrust"/>
                                <TextBox x:Name="SshTargetText" LostFocus="SshTarget_LostFocus" KeyDown="SshTarget_KeyDown"
                                         AutomationProperties.AutomationId="SshTarget"/>
                            </DockPanel>
                            <Expander Header="Its private network address" Margin="0,10,0,0" AutomationProperties.AutomationId="HostAddressSection">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Filled in automatically from the computer. Change it only if your other computers reach it at a different address."/>
                                    <TextBox x:Name="AddressText" AutomationProperties.AutomationId="HostAddress"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Another Windows PC? Install Martlet there and choose Use as a Martlet host on its Home page. It then appears under Martlet on your network."/>
                </StackPanel>

                <StackPanel x:Name="RolesStep" Visibility="Collapsed">
                    <TextBlock Text="Choose jobs for this host" Style="{DynamicResource PageTitle}"/>
                    <TextBlock x:Name="RolesSummaryText" Style="{DynamicResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="RolesSummaryText"/>
                    <Border Style="{DynamicResource CardStyle}" Background="{DynamicResource SoftBrush}">
                        <StackPanel>
                            <DockPanel>
                                <ComboBox x:Name="HostChoice" DockPanel.Dock="Right" MinWidth="200" SelectionChanged="HostChoice_Changed"
                                          AutomationProperties.AutomationId="HostChoice" AutomationProperties.Name="Host to configure"/>
                                <TextBlock Text="Host" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="PairedText" Style="{DynamicResource Muted}" Margin="0,8,0,10" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="PairedHost"/>
                            <WrapPanel x:Name="HostButtons">
                                <Button Content="Chec_k host" Click="Check_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="CheckHost"/>
                                <Button Content="_Update host" Click="UpdateHost_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="UpdateHost"
                                        ToolTip="Update the host. Pairings and jobs stay"/>
                                <Button Content="_Forget host" Click="Forget_Click" AutomationProperties.AutomationId="ForgetHost"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- One card per role in HostRoles.All, built in code. -->
                    <StackPanel x:Name="RoleCards"/>
                    <Expander Header="This PC's device ID" Margin="0,4,0,0" AutomationProperties.AutomationId="DeviceIdSection">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="How this PC appears on the host. Martlet sends it automatically when connecting."/>
                            <DockPanel>
                                <Button Content="Cop_y" Click="CopyDeviceId_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                <TextBox x:Name="DeviceIdText" AutomationProperties.AutomationId="DeviceId" AutomationProperties.Name="This PC's device ID"/>
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:ThemedWindow>
