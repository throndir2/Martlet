<local:ThemedWindow x:Class="Martlet.Desktop.AccountUnlockWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}" Title="Martlet - Unlock"
        Width="440" MinWidth="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        AutomationProperties.AutomationId="UnlockWindow">
    <StackPanel Margin="26,24">
        <TextBlock x:Name="AccountText" Style="{DynamicResource SectionHeading}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="UnlockAccountName"/>
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,6,0,14" Style="{DynamicResource Muted}"/>
        <StackPanel x:Name="PinPanel" Visibility="Collapsed">
            <TextBlock Text="PIN"/>
            <PasswordBox x:Name="PinText" MaxLength="12" FontSize="18" Margin="0,4,0,8" KeyDown="Secret_KeyDown"
                         AutomationProperties.AutomationId="UnlockPin" AutomationProperties.Name="PIN"/>
        </StackPanel>
        <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
            <TextBlock x:Name="PasswordLabel" Text="Martlet password"/>
            <PasswordBox x:Name="PasswordText" MaxLength="256" Margin="0,4,0,8" KeyDown="Secret_KeyDown"
                         AutomationProperties.AutomationId="UnlockPassword" AutomationProperties.Name="Martlet password"/>
        </StackPanel>
        <WrapPanel Margin="0,4,0,0">
            <Button x:Name="UnlockButton" Content="_Unlock" Click="Unlock_Click" Style="{DynamicResource PrimaryButton}" MinWidth="110"
                    Margin="0,0,8,0" IsDefault="True" AutomationProperties.AutomationId="UnlockSubmit"/>
            <Button x:Name="HelloButton" Content="Use _Windows Hello" Click="Hello_Click" MinWidth="150" Visibility="Collapsed"
                    AutomationProperties.AutomationId="UnlockHello"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="UnlockStatus"/>
        <WrapPanel Margin="0,18,0,0">
            <Button x:Name="OtherButton" Content="_Choose another account" Click="Other_Click" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="UnlockOther"/>
            <Button x:Name="SignInButton" Content="_Sign in as someone else" Click="SignIn_Click"
                    AutomationProperties.AutomationId="UnlockSignIn"/>
        </WrapPanel>
    </StackPanel>
</local:ThemedWindow>
