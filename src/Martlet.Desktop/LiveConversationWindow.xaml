<local:ThemedWindow x:Class="Martlet.Desktop.LiveConversationWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        Style="{DynamicResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Martlet - talk" Width="1080" Height="840" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Real API conversation, explicit actions only">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StopButton" Content="S_top (Esc)" Click="Stop_Click" IsEnabled="False" Padding="16,9"
                            AutomationProperties.AutomationId="LiveStop" AutomationProperties.AcceleratorKey="Esc"
                            AutomationProperties.HelpText="Discard recording and revoke this action or unused permissions. Escape works anywhere in this conversation window. Does not close the window or send audio." />
                    <Button Content="_Close" Click="Close_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="CloseLive" />
                </StackPanel>
                <Grid x:Name="TalkMark" DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,14,0" IsHitTestVisible="False">
                    <Ellipse Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}"/>
                    <Viewbox Margin="10" x:Name="TalkHeart" RenderTransformOrigin="0.5,0.5">
                        <Path Data="M 39 66 C 33 59 14 48 19 34 C 23 23 35 26 39 33 C 45 23 58 24 62 34 C 68 47 48 61 39 66 Z" Fill="{DynamicResource AccentBrush}"/>
                    </Viewbox>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Talk with Martlet" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Style="{DynamicResource Muted}" FontSize="12"
                               Text="Real API conversation. Nothing is sent until you approve; hands-free listening continues only while you keep it on. Stop or Esc discards and revokes permission."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <WrapPanel DockPanel.Dock="Top" Margin="22,8,22,0">
            <Button x:Name="ReloadButton" Style="{DynamicResource LinkButton}" Content="_Reload saved choices" Click="Reload_Click" AutomationProperties.AutomationId="ReloadLive" />
            <Button x:Name="SetupButton" Style="{DynamicResource LinkButton}" Content="Set_up / credentials" Click="Setup_Click" AutomationProperties.AutomationId="LiveOpenSetup" />
            <Button x:Name="AudioButton" Style="{DynamicResource LinkButton}" Content="_Audio setup" Click="Audio_Click" />
            <Button Style="{DynamicResource LinkButton}" Content="Character / STOP avatar" Click="Avatar_Click" AutomationProperties.AutomationId="ConversationAvatar" />
            <Button Style="{DynamicResource LinkButton}" Content="Troubleshooting" Click="Troubleshooting_Click" AutomationProperties.AutomationId="LiveTroubleshooting" />
        </WrapPanel>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,12,22,18">
                    <Border Style="{DynamicResource Chip}" HorizontalAlignment="Stretch" Padding="14,8" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Icon}" Text="&#xE946;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ResultText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Live action result and remedy" />
                        </DockPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Right" MinWidth="240" MaxWidth="520" Margin="48,0,0,14">
                        <Label Target="{Binding ElementName=TranscriptText}" Content="You said (push-to-talk _transcript and evidence)" Padding="0,0,0,4"
                               HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                        <TextBox x:Name="TranscriptText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource GlowBrush}" BorderThickness="0" Padding="14,10" AutomationProperties.AutomationId="LiveTranscript" />
                    </StackPanel>

                    <DockPanel Margin="0,0,32,14">
                        <Grid DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Top" Margin="0,22,10,0" IsHitTestVisible="False">
                            <Ellipse Fill="{DynamicResource AccentBrush}"/>
                            <Viewbox Margin="8">
                                <Path Data="M 39 66 C 33 59 14 48 19 34 C 23 23 35 26 39 33 C 45 23 58 24 62 34 C 68 47 48 61 39 66 Z" Fill="{DynamicResource OnAccentBrush}"/>
                            </Viewbox>
                        </Grid>
                        <StackPanel>
                            <Label Target="{Binding ElementName=AnswerText}" Content="Martlet's reply (response _text, kept even if audio fails)" Padding="0,0,0,4"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            <TextBox x:Name="AnswerText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="440" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource SoftBrush}" BorderThickness="0" Padding="14,10" FontSize="15"
                                     AutomationProperties.AutomationId="LiveAnswer" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="44,0,32,14">
                        <Label Target="{Binding ElementName=RefusalText}" Content="Separate _refusal (never spoken as ordinary speech)" Padding="0,0,0,4"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                        <TextBox x:Name="RefusalText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="1" Padding="12,8" AutomationProperties.AutomationId="LiveRefusal" />
                    </StackPanel>

                    <Expander Header="Details: configuration and timeline" AutomationProperties.AutomationId="LiveDetails">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,6"
                                       Text="Retry is a NEW explicit Send/PTT with fresh consent and limits. Earlier speech may already have played; no queue is replayed. Microphone/STT failures allow typed fallback. Output failure leaves response text visible."/>
                            <Label Target="{Binding ElementName=ConfigurationText}" Content="Selected _configuration and supported adapter IDs" Padding="0,4,0,4" FontSize="12"/>
                            <TextBox x:Name="ConfigurationText" IsReadOnly="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" FontSize="12"
                                     AutomationProperties.AutomationId="LiveConfiguration" AutomationProperties.Name="Configuration only, not live readiness" />
                            <Label Target="{Binding ElementName=StatusText}" Content="Same-engine stages / bounded time_line" Padding="0,8,0,4" FontSize="12"/>
                            <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" FontSize="12"
                                     AutomationProperties.AutomationId="LiveStatus" AutomationProperties.Name="Mic STT policy LLM TTS playback and actual ownership" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Your next message: approvals scroll above a composer that is always in view -->
            <Border Grid.Column="1" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12,18,14">
                        <StackPanel>
                            <Label Target="{Binding ElementName=InputText}" Content="_Message (at most 4096 characters)" Padding="0,0,0,6" FontWeight="SemiBold"/>
                            <TextBox x:Name="InputText" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096" MinHeight="64" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto" TextChanged="Input_Changed" AutomationProperties.AutomationId="LiveInput" />
                            <Button x:Name="SendButton" Content="_Send (one paid action)" Click="Send_Click" IsEnabled="False" Padding="18,10" Margin="0,10,0,6"
                                    Style="{DynamicResource PrimaryButton}" AutomationProperties.AutomationId="LiveSend" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="PttButton" Content="Hold to _talk (Space)" Click="Ptt_Click" IsEnabled="False" Padding="10,9"
                                        PreviewMouseLeftButtonDown="Ptt_Down" PreviewMouseLeftButtonUp="Ptt_Up" LostMouseCapture="Ptt_LostCapture"
                                        PreviewKeyDown="Ptt_KeyDown" PreviewKeyUp="Ptt_KeyUp" LostKeyboardFocus="Ptt_LostFocus"
                                        AutomationProperties.AutomationId="LivePtt" AutomationProperties.Name="Hold PTT (Space key), release to send"
                                        AutomationProperties.HelpText="Hold mouse or Space to record, release to send. Accessible Invoke starts a bounded recording; use Finish recording to send or Stop to discard. Never records automatically." />
                                <Button x:Name="ListenButton" Content="Start _listening" Click="Listen_Click" IsEnabled="False" Padding="10,9" Visibility="Collapsed"
                                        AutomationProperties.AutomationId="LiveListen" AutomationProperties.Name="Start or stop hands-free listening"
                                        AutomationProperties.HelpText="Hands-free: keeps the microphone open and sends each utterance when you pause. Click again, Stop or Esc to end listening." />
                                <Button x:Name="ReleaseButton" Grid.Column="2" Content="_Finish and send" Click="Release_Click" IsEnabled="False" Padding="10,9"
                                        AutomationProperties.AutomationId="LiveRelease" AutomationProperties.Name="Finish recording and send" />
                            </Grid>
                            <ProgressBar x:Name="LevelMeter" Height="5" Minimum="0" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed"
                                         AutomationProperties.Name="Microphone level while listening" AutomationProperties.AutomationId="LiveLevel" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,14,18,18">
                            <TextBlock Text="Before your next message" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Style="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,10"
                                       Text="Review what is sent and approve it, then type or hold to talk below. Approvals clear after every action."/>
                            <CheckBox x:Name="VoiceChoice" Content="Speak the reply with the AI-generated _voice (OFF by default)" Checked="Output_Changed" Unchecked="Output_Changed" Margin="0,0,0,10"
                                      AutomationProperties.AutomationId="LiveVoice" />
                            <Border Style="{DynamicResource Chip}" HorizontalAlignment="Stretch" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="How you talk" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="PushToTalkMode" GroupName="TalkMode" IsChecked="True" Checked="Mode_Changed"
                                                 Content="_Push-to-talk: hold Space or the button" AutomationProperties.AutomationId="LiveModePtt" />
                                    <RadioButton x:Name="VoiceActivityMode" GroupName="TalkMode" Checked="Mode_Changed" Margin="0,4,0,0"
                                                 Content="Voice activit_y: hands-free, replies when you pause" AutomationProperties.AutomationId="LiveModeVoiceActivity" />
                                    <StackPanel x:Name="VoiceActivityPanel" Margin="20,8,0,0" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock Text="Sensitivity" Width="92" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock DockPanel.Dock="Right" Text="High" Style="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Left" Text="Low" Style="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" LargeChange="0.1"
                                                    ValueChanged="Activity_Changed" AutomationProperties.Name="Voice activity sensitivity" AutomationProperties.AutomationId="LiveSensitivity"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock Text="Reply after" Width="92" VerticalAlignment="Center" FontSize="12"/>
                                            <ComboBox x:Name="PauseChoiceBox" SelectedIndex="1" SelectionChanged="Activity_Changed"
                                                      AutomationProperties.Name="Pause length before replying" AutomationProperties.AutomationId="LivePauseLength">
                                                <ComboBoxItem Content="a short pause (0.5 s)"/>
                                                <ComboBoxItem Content="a normal pause (0.8 s)"/>
                                                <ComboBoxItem Content="a long pause (1.2 s)"/>
                                            </ComboBox>
                                        </DockPanel>
                                        <TextBlock Style="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Listening stays on (even in the background) until you click Stop listening, Stop, Esc, pause, mute, lock or close. It waits for each reply to finish before listening again. Each utterance is one action within the envelope below."/>
                                    </StackPanel>
                                    <CheckBox x:Name="VoiceIdChoice" Margin="0,10,0,0" Checked="VoiceId_Changed" Unchecked="VoiceId_Changed"
                                              Content="O_nly respond to my voice (Voice ID)" AutomationProperties.AutomationId="LiveVoiceId"
                                              AutomationProperties.HelpText="Recognizes your enrolled voice on this PC before anything is uploaded. Other voices, TV and too-short sounds are ignored." />
                                    <TextBlock x:Name="VoiceIdStatus" Style="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="20,2,0,0" />
                                    <Button Style="{DynamicResource LinkButton}" Content="Set up Voice _ID" Click="VoiceIdSetup_Click" HorizontalAlignment="Left"
                                            Margin="16,2,0,0" AutomationProperties.AutomationId="LiveVoiceIdSetup" />
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource Chip}" HorizontalAlignment="Stretch" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Ellipse x:Name="WatchDot" DockPanel.Dock="Right" Width="10" Height="10" Fill="#D64545" Visibility="Collapsed"
                                                 VerticalAlignment="Center" AutomationProperties.Name="Watching" />
                                        <TextBlock Text="Watch my screen or a camera" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Style="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Martlet glances at what you're playing or doing (on screen, or through a webcam, capture card or your phone's camera) and now and then says something, like a friend in the room. Most glances end in silence."/>
                                    <TextBlock x:Name="VisionStatus" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="LiveVisionStatus" />
                                    <DockPanel>
                                        <TextBlock Text="Look at" Width="92" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox x:Name="ScreenScopeBox" SelectedIndex="0" SelectionChanged="Screen_Changed"
                                                  AutomationProperties.Name="What Martlet looks at" AutomationProperties.AutomationId="LiveScreenScope">
                                            <ComboBoxItem Content="my active window"/>
                                            <ComboBoxItem Content="my whole screen"/>
                                            <ComboBoxItem Content="a camera (webcam, capture card, phone as webcam)"/>
                                            <ComboBoxItem Content="a phone or network camera address"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel x:Name="CameraPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Camera" Width="92" VerticalAlignment="Center" FontSize="12"/>
                                        <Button x:Name="FindCamerasButton" DockPanel.Dock="Right" Content="_Find cameras" Click="FindCameras_Click" Padding="8,2" Margin="6,0,0,0"
                                                AutomationProperties.AutomationId="LiveFindCameras"
                                                AutomationProperties.HelpText="Lists the cameras Windows offers to desktop apps. Nothing is opened until you start watching." />
                                        <ComboBox x:Name="CameraBox" DisplayMemberPath="Name" SelectionChanged="Screen_Changed"
                                                  AutomationProperties.Name="Which camera Martlet looks through" AutomationProperties.AutomationId="LiveCamera" />
                                    </DockPanel>
                                    <StackPanel x:Name="AddressPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock Text="Address" Width="92" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox x:Name="AddressBox" TextChanged="Address_Changed" LostFocus="Address_LostFocus"
                                                     AutomationProperties.Name="Phone or network camera address" AutomationProperties.AutomationId="LiveVideoAddress" />
                                        </DockPanel>
                                        <TextBlock Style="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="92,2,0,0"
                                                   Text="A snapshot or MJPEG address from a phone camera app on your Wi-Fi (for example http://192.168.1.20:8080/shot.jpg), an rtsp:// camera stream or a video file. A password in the address is used but never saved."/>
                                    </StackPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock Text="How chatty" Width="92" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox x:Name="ChattinessBox" SelectedIndex="1" SelectionChanged="Screen_Changed"
                                                  AutomationProperties.Name="How often Martlet comments" AutomationProperties.AutomationId="LiveChattiness">
                                            <ComboBoxItem Content="Quiet: only the big moments"/>
                                            <ComboBoxItem Content="Normal"/>
                                            <ComboBoxItem Content="Chatty"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <CheckBox x:Name="AcceptScreen" Margin="0,10,0,6" Checked="Consent_Changed" Unchecked="Consent_Changed"
                                              AutomationProperties.AutomationId="LiveAcceptScreen"
                                              Content="While watching is on, I let Martlet capture my screen or the chosen camera on this PC and send an occasional picture (with the window or camera name) to the Thinking model named in the envelope below, including potential API charges and the selected voice output."/>
                                    <Button x:Name="WatchButton" Content="Start _watching" Click="Watch_Click" IsEnabled="False" Padding="10,8" Margin="0,4,0,0"
                                            AutomationProperties.AutomationId="LiveWatch" AutomationProperties.Name="Start or stop watching"
                                            AutomationProperties.HelpText="Keeps watching in the background until you click again, Stop, Esc, pause, mute, lock or close." />
                                    <TextBlock x:Name="WatchStatus" Style="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LiveWatchStatus" />
                                </StackPanel>
                            </Border>
                            <Label Target="{Binding ElementName=EnvelopeText}" Content="What it sends, where, and what it may _cost" Padding="0,0,0,4" FontSize="12"/>
                            <TextBox x:Name="EnvelopeText" IsReadOnly="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" FontSize="12"
                                     AutomationProperties.AutomationId="LiveEnvelope" AutomationProperties.Name="Exact action bounds and data destinations" />
                            <CheckBox x:Name="AcceptAction" Margin="0,12,0,6" Checked="Consent_Changed" Unchecked="Consent_Changed" AutomationProperties.AutomationId="LiveAcceptAction"
                                      Content="I authorize my next Send / PTT action (or, while hands-free listening is on, each detected utterance) within this displayed envelope, including potential API charges and the selected generated-voice output."/>
                            <CheckBox x:Name="AcceptMemory" Margin="0,6"
                                      Content="Optional, next Send / PTT only: I separately authorize bounded lexical retrieval from my enabled local memory and disclosure of only fitting top facts (at most three) with provenance to the selected LLM. This is fresh permission, not provider permission, and is cleared after use."
                                      Checked="Consent_Changed" Unchecked="Consent_Changed" AutomationProperties.AutomationId="LiveAcceptMemory"
                                      AutomationProperties.HelpText="OFF for every action by default. Does not save this conversation or upload the complete memory store." />
                            <CheckBox x:Name="AcceptCapture" Content="For microphone input: I permit bounded LOCAL microphone capture, including other people only with their permission." Margin="0,6"
                                      Checked="Consent_Changed" Unchecked="Consent_Changed" AutomationProperties.AutomationId="LiveAcceptCapture" />
                            <CheckBox x:Name="AcceptUpload" Content="For microphone input: I separately permit uploading this audio to the named STT destination with potential charges, even if policy later suppresses it." Margin="0,6"
                                      Checked="Consent_Changed" Unchecked="Consent_Changed" AutomationProperties.AutomationId="LiveAcceptUpload" />
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox x:Name="PauseChoice" Content="Pause all live work" Checked="Controls_Changed" Unchecked="Controls_Changed" Margin="0,4,16,4" AutomationProperties.AutomationId="LivePause" />
                                <CheckBox x:Name="MuteChoice" Content="Mute / stop live work" Checked="Controls_Changed" Unchecked="Controls_Changed" Margin="0,4,16,4" AutomationProperties.AutomationId="LiveMute" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</local:ThemedWindow>
