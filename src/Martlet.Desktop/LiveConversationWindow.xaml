<local:ThemedWindow x:Class="Martlet.Desktop.LiveConversationWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        Style="{DynamicResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talk with Martlet" Width="760" Height="820" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Talk with Martlet">
    <!-- The talk window is only the conversation: its history and the message box. It doesn't block the rest of Martlet.
         How Martlet listens, speaks and sees is chosen in Companion; Start listening and Start watching turn always listening and
         watching on here (both are off when the window opens), and each stops from its own button. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Background tasks (thinking longer, a song...): how many Martlet is running or has ready, shown once it starts
                         one. It opens the task list over the conversation (TasksPanel). -->
                    <Button x:Name="TasksChip" Click="TasksChip_Click" Padding="12,6" MinHeight="34" Margin="0,0,8,0" Visibility="Collapsed"
                            ToolTip="Background tasks. Martlet keeps working on these while you talk."
                            AutomationProperties.AutomationId="LiveTasks">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse x:Name="TasksTrack" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"/>
                                <Path x:Name="TasksSpinner" Data="M 7,1 A 6,6 0 0 1 13,7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse x:Name="TasksDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TasksGlyph" Style="{DynamicResource Icon}" FontSize="12" Text="&#xE73E;"
                                           Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="TasksText" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MicChip" Click="Mic_Click" Padding="14,6" MinHeight="34" Margin="0,0,8,0" Visibility="Collapsed"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="LiveMic">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MicDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"
                                     Visibility="Collapsed"/>
                            <TextBlock x:Name="MicText" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="VisionChip" Click="Vision_Click" Padding="12,6" MinHeight="34" Margin="0,0,8,0" Visibility="Collapsed"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="LiveVision">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="VisionDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="VisionText" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Content="S_top (Esc)" Click="Stop_Click" IsEnabled="False" Padding="14,6" MinHeight="34"
                            AutomationProperties.AutomationId="LiveStop" AutomationProperties.AcceleratorKey="Esc"
                            AutomationProperties.HelpText="Stops the reply, recording and watching. Listening stays on." />
                </StackPanel>
                <Image x:Name="TalkMascot" Style="{DynamicResource Mascot}" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Martlet" FontSize="19" FontWeight="SemiBold"/>
                    <!-- No fixed accessible name: the status text itself is what screen readers announce (and MCP reads). -->
                    <TextBlock x:Name="ResultText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LiveStatus"/>
                    <!-- While vision is on: what Martlet is watching, a look in progress or why it is holding off; its tooltip
                         (help in MCP) says how the last look went. -->
                    <TextBlock x:Name="VisionStatusText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed" AutomationProperties.AutomationId="LiveVisionStatus"/>
                    <!-- While Martlet decides where the character looks (Companion › Vision): what its eyes are on now. -->
                    <TextBlock x:Name="GazeStatusText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed" AutomationProperties.AutomationId="LiveGaze"/>
                    <!-- While the screen summary over time runs (Companion › Vision): pictures kept and the last summary's age and
                         time taken; its tooltip (help in MCP) is the last summary. -->
                    <TextBlock x:Name="ScreenSummaryText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed" AutomationProperties.AutomationId="LiveScreenSummary"/>
                    <!-- While Hear what this PC plays is on: whether Martlet hears the PC now, or why it can't; its tooltip says how. -->
                    <TextBlock x:Name="PcAudioText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed" AutomationProperties.AutomationId="LivePcAudio"/>
                    <!-- While Martlet decides how chatty it is and vision or hearing this PC is on: the level it picked. -->
                    <TextBlock x:Name="ChattinessText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed" AutomationProperties.AutomationId="LiveChattiness"/>
                    <!-- What Martlet's last reply took together (your words, what this PC played, the picture, finished work);
                         never what was said, seen or found. -->
                    <TextBlock x:Name="TurnInputsText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed" AutomationProperties.AutomationId="LiveTurnInputs"/>
                    <!-- The last time you talked over Martlet: whether it paused, stopped or played on, and what decided
                         (never what you said). -->
                    <TextBlock x:Name="BargeInText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed" AutomationProperties.AutomationId="LiveBargeIn"/>
                    <!-- How many recent exchanges the next reply sees as context (kept across settings changes); its tooltip has
                         the tokens. Refresh context forgets those exchanges so the next reply starts fresh; the messages stay on screen. -->
                    <WrapPanel x:Name="ContextRow" Margin="0,2,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ContextText" Style="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,10,0" AutomationProperties.AutomationId="LiveContext"/>
                        <Button x:Name="RefreshContextButton" Content="_Refresh context" Click="RefreshContext_Click" Style="{DynamicResource LinkButton}"
                                FontSize="12" Padding="0" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Forget the earlier exchanges so Martlet's next reply starts fresh. The messages stay on screen."
                                AutomationProperties.AutomationId="LiveRefreshContext"
                                AutomationProperties.HelpText="Forgets the earlier exchanges so the next reply starts fresh. The messages stay on screen."/>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The message box stays in view below the history. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
            <StackPanel>
                <!-- The song Martlet sings (sing_song, play_song): where it is, the line being sung, and Stop singing. Only Martlet
                     performs songs (asked in conversation); nothing here plays one. It keeps going while you talk; Stop (Esc) ends
                     it with a quick fade, Stop singing musically. -->
                <Border x:Name="SongPanel" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.AutomationId="LiveSongPanel">
                    <DockPanel>
                        <Button x:Name="SongStopButton" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Stop singing" Click="SongStop_Click"
                                Padding="12,3" Margin="10,0,0,0" Visibility="Collapsed"
                                ToolTip="Martlet finishes the word and the band rings out on the beat. Martlet hears where it stopped."
                                AutomationProperties.AutomationId="LiveSongStop"/>
                        <StackPanel>
                            <TextBlock x:Name="SongText" Style="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LiveSong"/>
                            <TextBlock x:Name="SongLineText" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="LiveSongLine"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- A tool call waiting for your answer: inline, so answering never leaves (or revokes) the conversation. -->
                <Border x:Name="ToolApprovalPanel" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.AutomationId="LiveToolApproval">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="De_ny" Click="ToolDeny_Click" MinWidth="80" Margin="12,0,8,0" AutomationProperties.AutomationId="LiveToolDeny"/>
                                <Button x:Name="ToolAlwaysButton" Content="Always allo_w" Click="ToolAlways_Click" MinWidth="104" Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="LiveToolAlways"/>
                                <Button Content="Allow _once" Click="ToolAllow_Click" MinWidth="104" Style="{DynamicResource PrimaryButton}"
                                        AutomationProperties.AutomationId="LiveToolAllow"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ToolApprovalTitle" Text="Allow this tool?" FontWeight="SemiBold" AutomationProperties.AutomationId="LiveToolApprovalTitle"/>
                                <TextBlock x:Name="ToolApprovalText" TextWrapping="Wrap" Margin="0,2,0,0"
                                           AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="LiveToolApprovalText"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBox x:Name="ToolApprovalArguments" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" Margin="0,8,0,0"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                 AutomationProperties.Name="Tool details" AutomationProperties.AutomationId="LiveToolApprovalArguments"/>
                    </StackPanel>
                </Border>
                <!-- Smart home confirmation: inline, so answering never leaves the conversation. -->
                <Border x:Name="HomeQuestionPanel" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.AutomationId="LiveHomeQuestion">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="HomeNoButton" Content="Don't send" Click="HomeNo_Click" MinWidth="104" Margin="12,0,8,0"
                                    AutomationProperties.AutomationId="LiveHomeNo"/>
                            <Button x:Name="HomeYesButton" Content="Send request" Click="HomeYes_Click" MinWidth="104"
                                    Style="{DynamicResource PrimaryButton}" AutomationProperties.AutomationId="LiveHomeYes"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Review smart home request" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HomeQuestionText" TextWrapping="Wrap" Margin="0,2,0,0"
                                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="LiveHomeQuestionText"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ProgressBar x:Name="LevelMeter" Height="3" Minimum="0" Maximum="1" Margin="0,0,0,10" Visibility="Collapsed"
                             AutomationProperties.Name="Microphone level while listening" AutomationProperties.AutomationId="LiveLevel" />
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="PttButton" Content="Hold to _talk" Click="Ptt_Click" Visibility="Collapsed" Padding="14,10" Margin="8,0,0,0"
                                PreviewMouseLeftButtonDown="Ptt_Down" PreviewMouseLeftButtonUp="Ptt_Up" LostMouseCapture="Ptt_LostCapture"
                                PreviewKeyDown="Ptt_KeyDown" PreviewKeyUp="Ptt_KeyUp" LostKeyboardFocus="Ptt_LostFocus"
                                AutomationProperties.AutomationId="LivePtt" AutomationProperties.Name="Hold to talk (Space), release to send"
                                AutomationProperties.HelpText="Hold the mouse button or Space, then release to send. Esc discards." />
                        <Button x:Name="SendButton" Content="_Send" Click="Send_Click" IsEnabled="False" Padding="20,10" Margin="8,0,0,0"
                                Style="{DynamicResource PrimaryButton}" AutomationProperties.AutomationId="LiveSend" />
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="InputText" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096" MinHeight="42" MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Input_Changed" PreviewKeyDown="Input_KeyDown"
                                 SizeChanged="Input_SizeChanged"
                                 AutomationProperties.AutomationId="LiveInput" AutomationProperties.Name="Message Martlet"
                                 AutomationProperties.HelpText="Press Enter to send. Press Shift+Enter for a new line." />
                        <!-- Its margin is set from where the box's caret starts, so the hint sits exactly where typing begins. -->
                        <TextBlock x:Name="Placeholder" Text="Message Martlet" Style="{DynamicResource Muted}" IsHitTestVisible="False"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="NoWrap"
                                   AutomationProperties.AutomationId="LivePlaceholder"/>
                    </Grid>
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid>
            <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" Padding="18,16,18,6" ScrollChanged="History_ScrollChanged" PreviewMouseDown="History_PreviewMouseDown" Focusable="False">
                <ItemsControl x:Name="History" Focusable="False" AutomationProperties.AutomationId="LiveHistory" AutomationProperties.Name="Conversation">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel x:Name="Row" HorizontalAlignment="Left" MaxWidth="580" Margin="0,0,56,14">
                                <TextBlock x:Name="Caption" Text="{Binding Caption}" Style="{DynamicResource Muted}" FontSize="11" Margin="6,0,6,3"/>
                                <!-- As wide as its words: a longer caption or note doesn't stretch it. -->
                                <Border x:Name="Bubble" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="16" Padding="13,8" HorizontalAlignment="Left">
                                    <!-- Its automation ID says whose message it is (LiveMessage-You, -Martlet, -Note, -PcAudio), never its words. -->
                                    <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" FontSize="14"
                                             Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                             AutomationProperties.Name="{Binding Caption}" AutomationProperties.AutomationId="LiveMessage-Martlet">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Border>
                                <!-- A picture Martlet shows (draw_picture or perform_creation). Click to open it full size. -->
                                <Border x:Name="PictureFrame" Visibility="Collapsed" CornerRadius="12" Margin="0,6,0,0" ClipToBounds="True"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                    <Image Source="{Binding Picture}" MaxWidth="420" MaxHeight="420" Stretch="Uniform" Cursor="Hand"
                                           RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonUp="Picture_Click"
                                           AutomationProperties.AutomationId="LivePicture" AutomationProperties.Name="{Binding Text}"/>
                                </Border>
                                <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{DynamicResource Muted}" FontSize="12" Margin="6,4,6,0"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Row" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Row" Property="Margin" Value="56,0,0,14"/>
                                    <Setter TargetName="Caption" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="NoteText" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                    <Setter TargetName="Body" Property="AutomationProperties.AutomationId" Value="LiveMessage-You"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                    <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="Row" Property="Margin" Value="24,0,24,14"/>
                                    <Setter TargetName="Caption" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter TargetName="Body" Property="FontSize" Value="12"/>
                                    <Setter TargetName="Body" Property="TextAlignment" Value="Center"/>
                                    <Setter TargetName="Body" Property="AutomationProperties.AutomationId" Value="LiveMessage-Note"/>
                                </DataTrigger>
                                <!-- What Martlet heard playing on the PC: marked as the PC's, quieter than what you say. -->
                                <DataTrigger Binding="{Binding IsPcAudio}" Value="True">
                                    <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="Row" Property="Margin" Value="32,0,32,14"/>
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource SoftBrush}"/>
                                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter TargetName="Body" Property="FontStyle" Value="Italic"/>
                                    <Setter TargetName="Body" Property="FontSize" Value="13"/>
                                    <Setter TargetName="Body" Property="AutomationProperties.AutomationId" Value="LiveMessage-PcAudio"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNote}" Value="False">
                                    <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                    <Setter TargetName="PictureFrame" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="380" Margin="24">
                <Image Style="{DynamicResource Mascot}" Width="72" Height="72" Margin="0,0,0,12"/>
                <TextBlock Text="Say hi to Martlet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="EmptyDetail" Style="{DynamicResource Muted}" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- Background tasks (the header's LiveTasks opens it): every task Martlet runs or ran in this conversation, newest
                 work first: what it is about, where it is, how long it took and what it found; Cancel stops one still running.
                 They keep going while you talk; Stop (Esc) never stops them. The shadow sits on its own layer so text stays crisp. -->
            <Grid x:Name="TasksPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="380" Margin="14,10,14,10"
                  Visibility="Collapsed" AutomationProperties.AutomationId="LiveTasksPanel" AutomationProperties.Name="Background tasks">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,10,8,0">
                            <Button x:Name="TasksCloseButton" DockPanel.Dock="Right" Click="TasksClose_Click" Padding="7" MinHeight="0"
                                    Background="Transparent" BorderThickness="0" ToolTip="Close (Esc)"
                                    AutomationProperties.Name="Close background tasks" AutomationProperties.AutomationId="LiveTasksClose">
                                <TextBlock Style="{DynamicResource Icon}" FontSize="11" Text="&#xE711;"/>
                            </Button>
                            <TextBlock Text="Background tasks" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="JobsText" DockPanel.Dock="Top" Style="{DynamicResource Muted}" FontSize="12" Margin="16,2,16,10"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LiveJobs"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="JobCards" Margin="8,0,8,8"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</local:ThemedWindow>
