<local:ThemedWindow x:Class="Martlet.Desktop.SignInJoinWindow"
        xmlns:local="clr-namespace:Martlet.Desktop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindowStyle}" Title="Martlet - Join from outside home"
        Width="600" MinWidth="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="SignInJoinWindow">
    <StackPanel Margin="26,24">
        <TextBlock Style="{DynamicResource SectionHeading}" Text="Join your Martlet from outside home" AutomationProperties.AutomationId="SignInJoinTitle"/>
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,14" Style="{DynamicResource Muted}"
                   Text="Paste the invite you made at home (Devices › your host › Sign-in from outside). Martlet checks the host's key before it sends anything, then you sign in. This PC is then paired with that host and joins your network by itself."/>
        <TextBlock Text="Invite" FontWeight="SemiBold"/>
        <TextBox x:Name="InviteText" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="54" MaxLength="4096" Margin="0,4,0,8"
                 AutomationProperties.AutomationId="SignInInvite" AutomationProperties.Name="Invite from home"/>
        <Button x:Name="ConnectButton" Content="_Connect" Click="Connect_Click" HorizontalAlignment="Left" MinWidth="110"
                AutomationProperties.AutomationId="SignInConnect"/>
        <StackPanel x:Name="SignInPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="HostText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" AutomationProperties.AutomationId="SignInHost"/>
            <TextBlock Text="Sign in with" Style="{DynamicResource Muted}" Margin="0,8,0,4"/>
            <StackPanel x:Name="ProviderList" AutomationProperties.AutomationId="SignInProviderList"/>
            <StackPanel x:Name="OwnerPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Account name"/>
                <TextBox x:Name="UserText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInUser"/>
                <TextBlock Text="Password"/>
                <PasswordBox x:Name="PasswordText" Margin="0,4,0,8" AutomationProperties.AutomationId="SignInPassword"/>
                <TextBlock Text="Authenticator code (or a recovery code)"/>
                <TextBox x:Name="CodeText" FontFamily="Consolas" FontSize="16" Margin="0,4,0,8" MaxLength="16"
                         AutomationProperties.AutomationId="SignInCode"/>
            </StackPanel>
            <Button x:Name="SignInButton" Content="_Sign in" Click="SignIn_Click" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"
                    MinWidth="110" Margin="0,6,0,0" AutomationProperties.AutomationId="SignInSubmit"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="SignInJoinStatus"/>
        <Button Content="_Close" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" MinWidth="100" Margin="0,16,0,0"
                AutomationProperties.AutomationId="SignInJoinClose"/>
    </StackPanel>
</local:ThemedWindow>
