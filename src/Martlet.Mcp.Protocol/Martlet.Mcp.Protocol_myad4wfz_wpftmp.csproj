    <Compile Include="..\Martlet.Desktop\HostSupplies.cs" Link="Hosts\HostSupplies.cs" />
    <!-- straight_voice_check: the desktop's own words of a recording sent straight to Thinking and the conversation it keeps. -->
    <Compile Include="..\Martlet.Desktop\SpokenWords.cs" Link="Shared\SpokenWords.cs" />
    <Compile Include="..\Martlet.Desktop\ConversationContextBuffer.cs" Link="Shared\ConversationContextBuffer.cs" />
    <Compile Include="..\Martlet.Desktop\VisionHistory.cs" Link="Shared\VisionHistory.cs" />
  </ItemGroup>
