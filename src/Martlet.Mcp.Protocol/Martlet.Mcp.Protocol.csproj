<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Martlet.Mcp" />
    <InternalsVisibleTo Include="Martlet.Desktop.Tests" />
    <ProjectReference Include="..\Martlet.Doctor\Martlet.Doctor.csproj" />
    <ProjectReference Include="..\Martlet.F5\Martlet.F5.csproj" />
    <ProjectReference Include="..\Martlet.Home\Martlet.Home.csproj" />
    <ProjectReference Include="..\Martlet.Mcp.Client\Martlet.Mcp.Client.csproj" />
    <ProjectReference Include="..\Martlet.Sherpa\Martlet.Sherpa.csproj" />
    <!-- network_status reads the desktop's network.json (NetworkLocalState). network_selftest runs Martlet.NodeLinkCheck, like
         node_link_check, so this server needs no ASP.NET Core runtime. -->
    <ProjectReference Include="..\Martlet.Avatar.Audio2Face\Martlet.Avatar.Audio2Face.csproj" />
    <!-- hearing_check rehearses the production Chat Completions adapter against a loopback fixture. -->
    <ProjectReference Include="..\Martlet.Providers\Martlet.Providers.csproj" />
    <ProjectReference Include="..\Martlet.Conversation\Martlet.Conversation.csproj" />
    <!-- discord_text_check runs the production Discord text pipeline with a fake transport; discord_voice_check rehearses Discord voice the same way; discord_companion_check rehearses the companion against an in-memory Discord. discord_reply_check rehearses the Discord reply side (DiscordReplier) against a loopback fixture. -->
    <ProjectReference Include="..\Martlet.Discord\Martlet.Discord.csproj" />
    <!-- echo_check rehearses the production echo reduction (EchoReducer and the WebRTC canceller) with fixture devices. -->
    <ProjectReference Include="..\Martlet.EchoCancellation\Martlet.EchoCancellation.csproj" />
    <!-- utterance_filter_check synthesizes its spoken fixtures with a Windows voice (nothing is played). -->
    <PackageReference Include="System.Speech" />
    <!-- character_models reads the desktop's shared character list and copies (SharedCharacterModels). -->
    <ProjectReference Include="..\Martlet.Avatar.Hosting\Martlet.Avatar.Hosting.csproj" />
    <!-- discord_status and discord_check read Companion › Discord's setup and whether its bot token is saved, and connect it once. -->
    <ProjectReference Include="..\Martlet.Credentials.Windows\Martlet.Credentials.Windows.csproj" />
  </ItemGroup>
  <!-- character_theme uses the desktop's own texture decoding and window sample with Martlet's real styles. The
       linked error log (which Controls.xaml's copy buttons use) gets its own namespace, like the renderer's copy. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);MARTLET_MCP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Martlet.Desktop\AppearancePalette.cs" Link="Theme\AppearancePalette.cs" />
    <Compile Include="..\Martlet.Desktop\CharacterThemeImages.cs" Link="Theme\CharacterThemeImages.cs" />
    <Compile Include="..\Martlet.Desktop\ThemeSample.cs" Link="Theme\ThemeSample.cs" />
    <Compile Include="..\Martlet.Desktop\CopyText.cs" Link="Theme\CopyText.cs" />
    <Compile Include="..\Martlet.Desktop\ErrorLog.cs" Link="Theme\ErrorLog.cs" />
    <!-- host_supply_check downloads with the desktop's own client for hosts without internet access. -->
    <Compile Include="..\Martlet.Desktop\HostSupplies.cs" Link="Hosts\HostSupplies.cs" />
    <!-- straight_voice_check: the desktop's own words of a recording sent straight to Thinking and the conversation it keeps. -->
    <Compile Include="..\Martlet.Desktop\SpokenWords.cs" Link="Shared\SpokenWords.cs" />
    <!-- audio_model_check: the desktop's own words of the audio model about your voice (the job, the note and the consent rule). -->
    <Compile Include="..\Martlet.Desktop\VoiceNote.cs" Link="Shared\VoiceNote.cs" />
    <Compile Include="..\Martlet.Desktop\ConversationContextBuffer.cs" Link="Shared\ConversationContextBuffer.cs" />
    <Compile Include="..\Martlet.Desktop\VisionHistory.cs" Link="Shared\VisionHistory.cs" />
    <!-- active_app_check: the desktop's own reading of the program in front and whether it fills its monitor. -->
    <Compile Include="..\Martlet.Desktop\ActiveApp.cs" Link="Shared\ActiveApp.cs" />
    <!-- screen_digest_check: the desktop's own screen summary over time on fixture frames. -->
    <Compile Include="..\Martlet.Desktop\ScreenDigest.cs" Link="Shared\ScreenDigest.cs" />
    <Compile Include="..\Martlet.Desktop\PictureDescriptions.cs" Link="Shared\PictureDescriptions.cs" />
    <!-- sound_digest_check: the desktop's own CPU sound judge (the bundled sound tagger and SoundDigest.Line). -->
    <Compile Include="..\Martlet.Desktop\CpuSoundJudge.cs" Link="Shared\CpuSoundJudge.cs" />
    <!-- helper_jobs_check: the desktop's own router for memory, emote naming and touch zones (Thinking pool or fallback). -->
    <Compile Include="..\Martlet.Desktop\HelperJobs.cs" Link="Shared\HelperJobs.cs" />
    <!-- character_touch_zones detect: the desktop's own snapshot decoding and the pictures the vision model is sent. -->
    <Compile Include="..\Martlet.Desktop\TouchZoneImages.cs" Link="Shared\TouchZoneImages.cs" />
    <!-- model_ability_check and model_lab: the desktop's own Test vision picture (one word drawn on this PC). -->
    <Compile Include="..\Martlet.Desktop\VisionTestPicture.cs" Link="Shared\VisionTestPicture.cs" />
    <!-- recommended_setup_status: the desktop's own request builder for Home's Recommended setup and its decline memory. -->
    <Compile Include="..\Martlet.Desktop\RecommendedSetupInputs.cs" Link="Shared\RecommendedSetupInputs.cs" />
    <Compile Include="..\Martlet.Desktop\RecommendedSetupMemory.cs" Link="Shared\RecommendedSetupMemory.cs" />
    <!-- network_status: the desktop's own reading of the Windows login (its kind and whether it has an e-mail hint only). -->
    <Compile Include="..\Martlet.Desktop\WindowsLogin.cs" Link="Shared\WindowsLogin.cs" />
    <Compile Include="..\Martlet.Desktop\AccountLocks.cs" Link="Shared\AccountLocks.cs" />
    <Compile Include="..\Martlet.Desktop\AccountProtection.cs" Link="Shared\AccountProtection.cs" />
    <Compile Include="..\Martlet.Desktop\AccountVault.cs" Link="Shared\AccountVault.cs" />
    <Page Include="..\Martlet.Desktop\Themes\Controls.xaml" Link="Themes\Controls.xaml" />
    <Page Include="..\Martlet.Desktop\Themes\Motion.xaml" Link="Themes\Motion.xaml" />
  </ItemGroup>
</Project>
