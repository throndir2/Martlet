<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Martlet.Mcp" />
    <InternalsVisibleTo Include="Martlet.Desktop.Tests" />
    <ProjectReference Include="..\Martlet.Doctor\Martlet.Doctor.csproj" />
    <ProjectReference Include="..\Martlet.F5\Martlet.F5.csproj" />
    <ProjectReference Include="..\Martlet.Home\Martlet.Home.csproj" />
    <ProjectReference Include="..\Martlet.Mcp.Client\Martlet.Mcp.Client.csproj" />
    <ProjectReference Include="..\Martlet.Sherpa\Martlet.Sherpa.csproj" />
    <!-- network_status reads the desktop's network.json (NetworkLocalState). network_selftest runs Martlet.NodeLinkCheck, like
         node_link_check, so this server needs no ASP.NET Core runtime. -->
    <ProjectReference Include="..\Martlet.Avatar.Audio2Face\Martlet.Avatar.Audio2Face.csproj" />
    <!-- hearing_check rehearses the production Chat Completions adapter against a loopback fixture. -->
    <ProjectReference Include="..\Martlet.Providers\Martlet.Providers.csproj" />
    <ProjectReference Include="..\Martlet.Conversation\Martlet.Conversation.csproj" />
    <!-- echo_check rehearses the production echo reduction (EchoReducer and the WebRTC canceller) with fixture devices. -->
    <ProjectReference Include="..\Martlet.EchoCancellation\Martlet.EchoCancellation.csproj" />
    <!-- utterance_filter_check synthesizes its spoken fixtures with a Windows voice (nothing is played). -->
    <PackageReference Include="System.Speech" />
    <!-- character_models reads the desktop's shared character list and copies (SharedCharacterModels). -->
    <ProjectReference Include="..\Martlet.Avatar.Hosting\Martlet.Avatar.Hosting.csproj" />
  </ItemGroup>
  <!-- character_theme uses the desktop's own texture decoding and window sample with Martlet's real styles. The
       linked error log (which Controls.xaml's copy buttons use) gets its own namespace, like the renderer's copy. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);MARTLET_MCP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Martlet.Desktop\AppearancePalette.cs" Link="Theme\AppearancePalette.cs" />
    <Compile Include="..\Martlet.Desktop\CharacterThemeImages.cs" Link="Theme\CharacterThemeImages.cs" />
    <Compile Include="..\Martlet.Desktop\ThemeSample.cs" Link="Theme\ThemeSample.cs" />
    <Compile Include="..\Martlet.Desktop\CopyText.cs" Link="Theme\CopyText.cs" />
    <Compile Include="..\Martlet.Desktop\ErrorLog.cs" Link="Theme\ErrorLog.cs" />
    <!-- host_supply_check downloads with the desktop's own client for hosts without internet access. -->
    <Compile Include="..\Martlet.Desktop\HostSupplies.cs" Link="Hosts\HostSupplies.cs" />
    <!-- straight_voice_check: the desktop's own words of a recording sent straight to Thinking and the conversation it keeps. -->
    <Compile Include="..\Martlet.Desktop\SpokenWords.cs" Link="Shared\SpokenWords.cs" />
    <Compile Include="..\Martlet.Desktop\ConversationContextBuffer.cs" Link="Shared\ConversationContextBuffer.cs" />
    <Page Include="..\Martlet.Desktop\Themes\Controls.xaml" Link="Themes\Controls.xaml" />
    <Page Include="..\Martlet.Desktop\Themes\Motion.xaml" Link="Themes\Motion.xaml" />
  </ItemGroup>
</Project>
