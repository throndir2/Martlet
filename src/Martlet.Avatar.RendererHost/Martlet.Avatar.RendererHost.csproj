<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <NodeExecutable Condition="'$(NodeExecutable)' == ''">node</NodeExecutable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Martlet.Desktop\AppearancePalette.cs" Link="AppearancePalette.cs" />
    <Page Include="..\Martlet.Desktop\Themes\Controls.xaml" Link="Themes\Controls.xaml" />
    <InternalsVisibleTo Include="Martlet.Desktop.Tests" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <ProjectReference Include="..\Martlet.Avatar.Hosting\Martlet.Avatar.Hosting.csproj" />
    <Content Include="web\dist\app.js" Link="web\app.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="web\dist\app.js.LEGAL.txt" Link="web\app.js.LEGAL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="web\dist\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="web\dist\THIRD-PARTY-NOTICES.txt" Link="web\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildAvatarBrowser" BeforeTargets="PrepareForBuild">
    <Exec Command="&quot;$(NodeExecutable)&quot; &quot;$(MSBuildProjectDirectory)\web\build.mjs&quot; &quot;$(IntermediateOutputPath).&quot;" />
  </Target>
  <!-- Generated by build.mjs from the pinned official Live2D SDK download; evaluated after the script runs. -->
  <Target Name="IncludeBundledLive2D" AfterTargets="BuildAvatarBrowser">
    <ItemGroup>
      <_BundledLive2D Include="web\live2d-dist\**\*" />
      <Content Include="@(_BundledLive2D)" Link="live2d\%(_BundledLive2D.RecursiveDir)%(_BundledLive2D.Filename)%(_BundledLive2D.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
