<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure-logic tests for Martlet.Platform.Linux (probe parsing, portal messages, SPA pods, key mapping, autostart file,
       JPEG encoding). They run on any OS; the native X11/PipeWire/D-Bus paths are exercised on a Linux desktop. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Martlet.Platform.Linux\Martlet.Platform.Linux.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
