#!/usr/bin/env bash
# martlet-host: the single engine for every Martlet host role, in every installation method.
#
#   martlet-host setup          set up this host's Martlet gateway (the only network entry point)
#   martlet-host roles          list the roles this host can run
#   martlet-host describe <role> print a role's terms, secrets and choices (machine-readable, no secret values)
#   martlet-host add <role>     install a role service and publish it through the gateway (or report a route-less feature);
#                               a voice engine replaces the one already installed (role.conf exclusive=voice)
#   martlet-host remove <role>  turn a role off: stop it and unpublish it (keeps its downloads and data, so adding it again
#                               downloads nothing; the machine report lists the kept downloads)
#   martlet-host pair           pair a Martlet desktop: shows this host's address and a one-use code (like K7QM-4XPA) to
#                               type in Martlet (Devices > Add a computer > Enter a pairing code); the code has no
#                               deadline: it waits until a desktop uses it, you type cancel (or Ctrl+C) or stdin ends
#   martlet-host pair --device-id <id> --name <name> [--roles voice]
#                               pair that desktop without a console: prints one "pairing-code: martlet-pair-v1..."
#                               line, waits up to five minutes for the desktop to redeem it, then restarts the gateway
#   martlet-host console        the gateway console: list paired desktops and revoke one
#   martlet-host network-reset  leave this host's Martlet network (pairings stay); the next desktop that pairs adds it to its own
#   martlet-host exposure [--outside <name:port>]... [--clear-outside] [--allow-pairing-outside-home yes|no]
#                         [--treat-all-as-outside yes|no] [--front-door <port>|off]
#                               how this host is reached from outside home (docs/NETWORK.md): outside addresses (overlay or
#                               port forward), typed pairing codes from outside, and treating every connection as outside
#                               (Docker-published gateways can't see where connections come from); no options prints it.
#                               With outside addresses the gateway also listens on this host's Tailscale address (native),
#                               or the Docker method publishes its port on every address of the Docker host. --front-door opens
#                               this host's front door: Martlet's web page and the OpenAI-compatible API only, on that port, for
#                               a reverse proxy or Tailscale Funnel (docs/OPENAI_ENDPOINT.md)
#   martlet-host status         show the gateway and every installed role
#   martlet-host machine        report this machine's hardware (GPUs, CPU, memory) to paired desktops
#   martlet-host update         update the gateway to this engine's Martlet version (keeps identity, pairings and roles)
#   martlet-host warm           start the gateway and every installed role that isn't running and load their models
#                               (role.conf warm=...), so the first request after Docker or the computer started is fast
#   martlet-host config         print the gateway configuration
#   martlet-host home           Docker method on Docker Desktop: publish the gateway on this computer's new home address
#                               (MARTLET_HOST_ADDRESS) after the network gave it another one; Martlet there runs it by itself.
#                               On a Linux Docker engine the keeper (martlet-host-keeper) does this by itself, and a native
#                               gateway listens on the new address by itself; the gateway's name, key and pairings stay
#
# --yes (or MARTLET_ASSUME_YES=1) before the command runs it without questions: the owner already confirmed it
# (Martlet desktop shows what will happen and the owner's click, over the owner's own SSH session, is the
# confirmation). Answers then come from stdin as KEY=VALUE lines ended by a line "end": secret.<name>=<value> for
# role secrets and choice.<VAR>=<value> for role choices; values never appear in arguments, environment or logs.
# Without --yes, a human on the host confirms each change by typing "yes".
#
# Changes side by side: several changes run on this host at once (other roles install alongside each other); a change
# waits only for one it truly collides with (the same role, setup or update, the gateway's own restart), whoever started
# it, and Martlet's automatic updates (no terminal, no --yes) stop with exit 75 and "MARTLET-BUSY ..." instead (see below).
#
# Methods (same commands, same roles; see README.md):
#   native  any x86_64 or arm64 (aarch64) Linux with systemd: ./deploy/host/martlet-host <command> (locally or over SSH)
#   docker  any Docker host, including Windows (Docker Desktop) and remote Docker over SSH:
#           docker run --rm -it -u 0 -v /var/run/docker.sock:/var/run/docker.sock \
#             -e MARTLET_HOST_ADDRESS=<host LAN IPv4> martlet-host <command>
#           (this launcher starts the engine as the unprivileged martlet user inside the gateway's network)
#
# Every role goes through the same steps, driven only by roles/<role>/role.conf and compose.yaml:
# requirements (including docker-engine for Linux-only host networking) -> the choices that pick a variant -> GPU or CPU ->
# the other choices -> terms -> secrets -> registry login -> pinned assets -> prepare steps (prepare=<service>, while the
# running service keeps serving) -> stop the previous variant or the roles it replaces (exclusive=<group>) -> compose
# service (loopback behind the gateway, or network=host for route-less LAN features) -> readiness -> post-start steps ->
# warm steps (warm=<service>|<command>, run again by "warm") -> gateway route or machine feature -> retire the replaced
# model (retire=<service>|<command>). role.conf entries between
# "[VAR=value]" and "[end]" apply only when that choice is made (a role's variants, such as the stt or Audio2Face engine,
# with their own GPU option, choices, terms, secrets, assets and prepare steps).
# Adding a role that is already installed reuses what is there: images, downloads and data volumes are kept, unchanged
# containers keep running, and the gateway keeps running unless what it serves changed (gateway_current). Only what is
# answered changes: unanswered choices and GPU or CPU stay as the role runs now (describe reports them, role.*_current).
# Each system change is confirmed first (typed "yes", or --yes when Martlet desktop already asked the owner).
set -euo pipefail

# macOS: not a Linux host (and its bash 3.2 can't run this script). The Mac host is Martlet's gateway under launchd.
if [ "$(uname -s)" = Darwin ] && [ "${MARTLET_HOST_MODE:-native}" != docker ]; then
  printf '%s\n' "This is a Mac: use the Mac host instead (docs/MACOS.md, \"The Mac host\"):" \
    "  /Applications/Martlet.app/Contents/Resources/host/Martlet.Gateway.Host.Linux macos-setup" \
    "or the Docker method in Docker Desktop (CPU only)." >&2
  exit 1
fi

if [[ "${1:-}" == --yes ]]; then shift; export MARTLET_ASSUME_YES=1; fi

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROLES_DIR="${MARTLET_HOST_ROLES_DIR:-${HERE}/roles}"
MODE="${MARTLET_HOST_MODE:-native}"
SERVICE="martlet-host-gateway"
NET="martlet-host-net"
KEEPER="martlet-host-keeper"
HOLD_READY="Network holder ready."
HELPER_IMAGE="busybox:1.36.1"
DOTNET_SDK="10.0.401"
# A computer without internet access: the files Martlet downloaded on the desktop and sent over SSH (see "Computers
# without internet" in README.md): dotnet-sdk-<version>-linux-<x64|arm64>.tar.gz and the gateway's NuGet packages in nuget/.
# Empty when this computer downloads them itself.
SUPPLY="${MARTLET_SUPPLY:-}"

if [[ "${MODE}" == docker ]]; then
  CONF=/var/lib/martlet/config
  GW_STATE=/var/lib/martlet/private/state
  GW_APP=/opt/martlet/gateway
  PROJECTS="${CONF}/projects"
  IMAGE="${MARTLET_HOST_IMAGE:-martlet-host:latest}"
  DOTNET=dotnet
  REPO=""
  SOURCE=/opt/martlet/source
else
  REPO="$(cd "${HERE}/../.." && pwd)"
  SOURCE="${REPO}"
  DATA="${MARTLET_HOST_DATA:-${HOME}/.local/share/martlet/host}"
  CONF="${MARTLET_HOST_CONFIG:-${HOME}/.config/martlet/host}"
  GW_STATE="${DATA}/private/state"
  GW_APP="${DATA}/gateway"
  PROJECTS="${DATA}/roles"
  DOTNET="${HOME}/.dotnet/dotnet"
  # .NET reads culture data from ICU. A minimal Linux without libicu (and without internet access to install it) builds
  # and runs the gateway in invariant globalization mode; the gateway uses no culture-specific behavior.
  if ! { PATH="${PATH}:/usr/sbin:/sbin" ldconfig -p 2>/dev/null | grep -q 'libicuuc\.so' || compgen -G '/usr/lib/*/libicuuc.so.*' >/dev/null; }; then
    export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
  fi
fi
GW_CONF_DIR="${CONF}/gateway"
GW_CONFIG="${GW_CONF_DIR}/host.json"

# The engine's functions are in modules next to this file (lib/*.sh). HERE follows the ~/.local/bin/martlet-host
# symlink to the real file, so a checkout and the host image (/opt/martlet/host) both find them.
if [[ ! -f "${HERE}/lib/common.sh" ]]; then
  printf '%s\n' "martlet-host: its modules (${HERE}/lib/*.sh) are missing. Run it from a Martlet checkout" \
    "(deploy/host/martlet-host) or the martlet-host image, not as a copy of this one file." >&2
  exit 1
fi
# shellcheck source=lib/common.sh
source "${HERE}/lib/common.sh"
# shellcheck source=lib/roles.sh
source "${HERE}/lib/roles.sh"
# shellcheck source=lib/requirements.sh
source "${HERE}/lib/requirements.sh"
# shellcheck source=lib/service.sh
source "${HERE}/lib/service.sh"
# shellcheck source=lib/machine.sh
source "${HERE}/lib/machine.sh"
# shellcheck source=lib/docker.sh
source "${HERE}/lib/docker.sh"
# shellcheck source=lib/pairing.sh
source "${HERE}/lib/pairing.sh"
# shellcheck source=lib/role-changes.sh
source "${HERE}/lib/role-changes.sh"
# shellcheck source=lib/upkeep.sh
source "${HERE}/lib/upkeep.sh"

if [[ "${MODE}" == docker && "${MARTLET_ENGINE:-launcher}" != inner ]]; then
  case "${1:-help}" in
    setup|roles|describe|add|remove|pair|console|network-reset|exposure|status|config|machine|update|warm|home) docker_launch "$@" ;;
  esac
fi

case "${1:-help}" in
  setup|add|remove|pair|console|network-reset|exposure|machine|update|warm)
    JOURNAL_ON=1
    if [[ "${MODE}" == docker ]]; then JOURNAL_SESSION="${MARTLET_ENGINE_NAME:-engine} ${IMAGE}"
    else JOURNAL_SESSION="native/$$ $(git -C "${REPO}" describe --tags --always 2>/dev/null || printf 'source')"; fi
    journal "started: $*"
    trap 'code=$?; finish_change; journal "exit ${code}"' EXIT
    hold_engine_locks "$@"
    ! engine_stranded || fail "$(stranded_text) Nothing was changed; run the command again." ;;
esac

case "${1:-help}" in
  setup) cmd_setup ;;
  roles) cmd_roles ;;
  describe) shift; cmd_describe "$@" ;;
  add) shift; cmd_add "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  pair) shift; cmd_pair "$@" ;;
  console) cmd_console ;;
  network-reset) cmd_network_reset ;;
  exposure) shift; cmd_exposure "$@" ;;
  status) cmd_status ;;
  machine) cmd_machine ;;
  update) cmd_update ;;
  warm) cmd_warm ;;
  config) require_setup; render_config ;;
  hold) cmd_hold ;;
  keep) cmd_keep ;;
  home) cmd_home ;;
  serve) cmd_serve ;;
  help|-h|--help) sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) fail "Unknown command '$1'. Try: martlet-host help" ;;
esac
