#!/usr/bin/env bash
# martlet-prepare: gets a Linux GPU computer ready to be a Martlet node, so you never have to log in to it.
#
# It runs directly on the computer as your SSH user (with sudo), not inside the martlet-host container, so it works
# for Docker-method and native hosts alike. Martlet streams it over SSH, so the computer needs no Martlet checkout:
#   ssh user@computer 'bash -s -- status --json' < martlet-prepare
# Nothing changes unless you name it: the desktop's "Prepare this computer" checklist passes only the items you tick.
#
#   martlet-prepare status [--json]     what is installed and configured (read-only, no sudo)
#   martlet-prepare ITEM... [options]   apply the named items (always in this order):
#     updates          apt update + upgrade, noninteractive
#     docker           Docker Engine + Compose plugin, started at boot, you in the docker group
#     nvidia-driver    install/update the recommended NVIDIA driver (ubuntu-drivers); needs a restart
#     nvidia-toolkit   NVIDIA Container Toolkit for Docker, checked with a --gpus all nvidia-smi container
#     headless         SSH server on at boot; sleep/suspend/hibernate off; --boot text|graphical
#     virtual-display  a virtual monitor for a GPU with no screen attached; --resolution WxH | --virtual-display-off
#     gpu-power        persistence mode and per-GPU power limits reapplied at boot; --power GPU=WATTS | --power-reset
#     tools            --tools cuda,python,node,git,build,htop,nvtop,curl,tmux (default: all of them)
#     wol              Wake-on-LAN on the wired network card, kept across restarts; reports its MAC
#     reboot | shutdown
#
# Output: "==> item: ..." progress lines, one "MARTLET-ITEM <item> <ok|changed|skipped|failed> <message>" line per
# item, and a final machine-readable line "MARTLET-RESULT {json}" (ok, reboot_required, reboot_reasons, items).
# With --status, the status JSON line follows, so the caller sees the new state without signing in again.
# Supports Ubuntu 22.04 and 24.04 on x86_64; anything else is refused.
set -uo pipefail
export LC_ALL=C

PREPARE_VERSION=1
CONF_DIR=/etc/martlet
POWER_CONF="${CONF_DIR}/gpu-power.conf"
POWER_HELPER=/usr/local/sbin/martlet-gpu-power
POWER_UNIT=/etc/systemd/system/martlet-gpu-power.service
WOL_UNIT=/etc/systemd/system/martlet-wol.service
XORG_CONF=/etc/X11/xorg.conf.d/90-martlet-virtual-display.conf
DISPLAY_STATE="${CONF_DIR}/virtual-display.conf"
CUDA_PROFILE=/etc/profile.d/martlet-cuda.sh
CUDA_PIN=/etc/apt/preferences.d/martlet-cuda
NODE_LIST=/etc/apt/sources.list.d/nodesource.list
NODE_KEY=/etc/apt/keyrings/nodesource.gpg
TOOLKIT_LIST=/etc/apt/sources.list.d/nvidia-container-toolkit.list
TOOLKIT_KEY=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
GDM_CONF=/etc/gdm3/custom.conf
SLEEP_TARGETS=(sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target)
ITEM_ORDER=(updates docker nvidia-driver nvidia-toolkit headless virtual-display gpu-power tools wol reboot shutdown)
TOOL_NAMES=(cuda python node git build htop nvtop curl tmux)
NODE_FALLBACK_MAJOR=24

if [[ ${EUID} -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi
TARGET_USER="${SUDO_USER:-$(id -un)}"

# ------------------------------------------------------------------ small helpers
CURRENT=prepare
step() { printf '==> %s: %s\n' "${CURRENT}" "$*"; }
warn() { printf '==> %s: warning: %s\n' "${CURRENT}" "$*"; }
as_root() { "${SUDO[@]}" "$@"; }
# Runs as root only when that needs no password (status stays read-only and never prompts).
try_root() { if [[ ${EUID} -eq 0 ]]; then "$@"; else sudo -n "$@" 2>/dev/null; fi; }
have() { command -v "$1" >/dev/null 2>&1; }
installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }
have_systemd() { [[ -d /run/systemd/system ]] && have systemctl; }
unit_enabled() { have systemctl && systemctl is-enabled "$1" 2>/dev/null; return 0; }
unit_active() { have systemctl && systemctl is-active "$1" 2>/dev/null; return 0; }
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
# First dotted version number in a command's first output line (for example "Python 3.12.3" -> 3.12.3).
version_of() { "$@" 2>/dev/null | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1; return 0; }
value_in() { local file="$1" key="$2"; [[ -r "${file}" ]] && sed -n "s/^${key}=//p" "${file}" | head -n1; return 0; }

# JSON output: strings (null when empty), numbers (null unless numeric), booleans.
jstr() {
  if [[ -z "${1:-}" ]]; then printf 'null'; return; fi
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//[$'\x01'-$'\x1f']/ }"
  printf '"%s"' "${s}"
}
jnum() { if [[ "${1:-}" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then printf '%s' "$1"; else printf 'null'; fi; }
jbool() { case "${1:-}" in 1|true|yes|enabled|Enabled|active) printf 'true' ;; *) printf 'false' ;; esac; }
jarr() { local out="" x; for x in "$@"; do out+="${out:+,}$(jstr "${x}")"; done; printf '[%s]' "${out}"; }

# ------------------------------------------------------------------ what this computer is
detect_os() {
  OS_ID=""; OS_VERSION=""; OS_NAME="Linux"; OS_CODENAME=""
  if [[ -r /etc/os-release ]]; then
    local lines=()
    mapfile -t lines < <(. /etc/os-release; printf '%s\n' "${ID:-}" "${VERSION_ID:-}" "${PRETTY_NAME:-Linux}" "${VERSION_CODENAME:-}")
    OS_ID="${lines[0]:-}"; OS_VERSION="${lines[1]:-}"; OS_NAME="${lines[2]:-Linux}"; OS_CODENAME="${lines[3]:-}"
  fi
  ARCH="$(uname -m)"; KERNEL="$(uname -r)"; HOST_NAME="$(uname -n)"
  SUPPORTED=0; REASON=""
  if [[ "${OS_ID}" != ubuntu ]]; then
    REASON="This computer runs ${OS_NAME}. Martlet prepares Ubuntu 22.04 or 24.04 only; set it up by hand or reinstall with Ubuntu."
  elif [[ "${OS_VERSION}" != 22.04 && "${OS_VERSION}" != 24.04 ]]; then
    REASON="This computer runs ${OS_NAME}. Martlet prepares Ubuntu 22.04 and 24.04 LTS only."
  elif [[ "${ARCH}" != x86_64 ]]; then
    REASON="This computer is ${ARCH}. Martlet prepares x86_64 (64-bit Intel/AMD) computers only."
  else
    SUPPORTED=1
  fi
}

sudo_mode() {
  if [[ ${EUID} -eq 0 ]]; then printf 'root'
  elif ! have sudo; then printf 'none'
  elif sudo -n true 2>/dev/null; then printf 'passwordless'
  elif id -nG "${TARGET_USER}" 2>/dev/null | grep -qwE 'sudo|admin|wheel'; then printf 'password'
  else printf 'none'; fi
}

nvidia_present() {
  local dev
  for dev in /sys/bus/pci/devices/*; do
    [[ "$(cat "${dev}/vendor" 2>/dev/null)" == 0x10de && "$(cat "${dev}/class" 2>/dev/null)" == 0x03* ]] && return 0
  done
  return 1
}

# The first NVIDIA display controller as an Xorg BusID (PCI:bus:device:function, decimal).
nvidia_bus_id() {
  local dev name
  for dev in /sys/bus/pci/devices/*; do
    [[ "$(cat "${dev}/vendor" 2>/dev/null)" == 0x10de && "$(cat "${dev}/class" 2>/dev/null)" == 0x03* ]] || continue
    name="$(basename "${dev}")"   # 0000:01:00.0
    if [[ "${name}" =~ ^[0-9a-f]{4}:([0-9a-f]{2}):([0-9a-f]{2})\.([0-7])$ ]]; then
      printf 'PCI:%d:%d:%d' "0x${BASH_REMATCH[1]}" "0x${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
      return 0
    fi
  done
  return 1
}

smi_ok() { have nvidia-smi && timeout 30 nvidia-smi -L >/dev/null 2>&1; }
loaded_driver() { [[ -r /proc/driver/nvidia/version ]] && grep -oE 'Kernel Module( for [a-z0-9_]+)? +[0-9]+(\.[0-9]+)+' /proc/driver/nvidia/version | grep -oE '[0-9]+(\.[0-9]+)+$' | head -n1; return 0; }
built_driver() { have modinfo && modinfo -F version nvidia 2>/dev/null | head -n1; return 0; }
driver_package() { dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'nvidia-driver-*' 2>/dev/null | awk '$1 == "ii" { print $2; exit }'; return 0; }
recommended_driver() {
  have ubuntu-drivers || return 0
  timeout 120 ubuntu-drivers devices 2>/dev/null | awk '$1 == "driver" && /recommended/ { print $3; exit }'
  return 0
}
# A newer NVIDIA kernel module is installed than the one running: restart to use it.
driver_pending() {
  local built loaded
  built="$(built_driver)"; loaded="$(loaded_driver)"
  [[ -n "${built}" && "${built}" != "${loaded}" ]]
}

# Every NVIDIA GPU as parallel arrays G_* (index, uuid, name, memory MiB, persistence, power limits in W, bus).
read_gpus() {
  G_COUNT=0; G_INDEX=(); G_UUID=(); G_NAME=(); G_MEM=(); G_PM=(); G_PL=(); G_PDEF=(); G_PMIN=(); G_PMAX=(); G_DRAW=()
  smi_ok || return 0
  local idx uuid name mem pm pl pdef pmin pmax draw
  while IFS=, read -r idx uuid name mem pm pl pdef pmin pmax draw; do
    uuid="$(trim "${uuid}")"; [[ -n "${uuid}" ]] || continue
    G_INDEX[G_COUNT]="$(trim "${idx}")"; G_UUID[G_COUNT]="${uuid}"; G_NAME[G_COUNT]="$(trim "${name}")"
    G_MEM[G_COUNT]="$(trim "${mem}")"; G_PM[G_COUNT]="$(trim "${pm}")"; G_PL[G_COUNT]="$(trim "${pl}")"
    G_PDEF[G_COUNT]="$(trim "${pdef}")"; G_PMIN[G_COUNT]="$(trim "${pmin}")"; G_PMAX[G_COUNT]="$(trim "${pmax}")"
    G_DRAW[G_COUNT]="$(trim "${draw}")"
    G_COUNT=$((G_COUNT + 1))
  done < <(timeout 30 nvidia-smi --query-gpu=index,uuid,name,memory.total,persistence_mode,power.limit,power.default_limit,power.min_limit,power.max_limit,power.draw \
             --format=csv,noheader,nounits 2>/dev/null)
}

# The wired network card that carries the default route (a bridge's first member when it is a bridge).
wol_interface() {
  local iface member
  iface="$(awk '$2 == "00000000" && $1 != "Iface" { print $1; exit }' /proc/net/route 2>/dev/null)"
  [[ -n "${iface}" ]] || return 0
  if [[ -d "/sys/class/net/${iface}/brif" ]]; then
    for member in /sys/class/net/"${iface}"/brif/*; do
      [[ -e "${member}" ]] && { iface="$(basename "${member}")"; break; }
    done
  fi
  printf '%s' "${iface}"
}
ethtool_field() { # interface, field ("Supports Wake-on" or "Wake-on")
  have ethtool || return 0
  { try_root ethtool "$1" || ethtool "$1" 2>/dev/null; } | awk -F: -v f="$2" '{ k=$1; gsub(/^[ \t]+/, "", k) } k == f { v=$2; gsub(/[ \t]/, "", v); print v; exit }'
  return 0
}

# ------------------------------------------------------------------ status
collect() {
  detect_os
  SUDO_MODE="$(sudo_mode)"
  SYSTEMD=0; have_systemd && SYSTEMD=1

  # Updates waiting in the local package lists (not refreshed here; the updates item does that).
  UPGRADABLE=""
  have apt-get && UPGRADABLE="$(apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null | grep -c '^Inst ' || true)"

  DOCKER_VERSION=""; COMPOSE_VERSION=""; DOCKER_RUNNING=""; DOCKER_ENABLED=""; DOCKER_GROUP=0
  if have docker; then
    DOCKER_VERSION="$(version_of docker --version)"
    COMPOSE_VERSION="$(docker compose version --short 2>/dev/null | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1 || true)"
    DOCKER_RUNNING="$(unit_active docker)"; DOCKER_ENABLED="$(unit_enabled docker)"
  fi
  id -nG "${TARGET_USER}" 2>/dev/null | grep -qw docker && DOCKER_GROUP=1

  NV_PRESENT=0; NV_SMI=0; NV_DRIVER=""; NV_PACKAGE=""; NV_RECOMMENDED=""; NV_CUDA=""; NV_TOOLKIT=""; NV_TOOLKIT_CONFIGURED=0
  NV_SECURE_BOOT=""; NV_PERSISTENCED=""
  nvidia_present && NV_PRESENT=1
  NV_PACKAGE="$(driver_package)"
  if smi_ok; then
    NV_SMI=1
    NV_DRIVER="$(timeout 30 nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1 | tr -d ' ')"
    NV_CUDA="$(timeout 30 nvidia-smi 2>/dev/null | grep -oE 'CUDA Version: *[0-9]+(\.[0-9]+)+' | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)"
  else
    NV_DRIVER="$(built_driver)"
  fi
  [[ ${NV_PRESENT} == 1 ]] && NV_RECOMMENDED="$(recommended_driver)"
  have nvidia-ctk && NV_TOOLKIT="$(version_of nvidia-ctk --version)"
  [[ -n "${NV_TOOLKIT}" ]] || { have nvidia-ctk && NV_TOOLKIT="installed"; }
  grep -q '"nvidia"' /etc/docker/daemon.json 2>/dev/null && NV_TOOLKIT_CONFIGURED=1
  if have mokutil; then
    case "$(mokutil --sb-state 2>/dev/null)" in *"SecureBoot enabled"*) NV_SECURE_BOOT=1 ;; *"SecureBoot disabled"*) NV_SECURE_BOOT=0 ;; esac
  fi
  NV_PERSISTENCED="$(unit_active nvidia-persistenced)"
  read_gpus

  SSH_SERVER=0; SSH_ENABLED=0; SLEEP_MASKED=1; DEFAULT_TARGET=""; GRAPHICAL_ACTIVE=""; DISPLAY_MANAGER=""
  installed openssh-server && SSH_SERVER=1
  [[ "$(unit_enabled ssh.service)" == enabled || "$(unit_enabled ssh.socket)" == enabled || "$(unit_enabled sshd.service)" == enabled ]] && SSH_ENABLED=1
  local target
  for target in sleep.target suspend.target hibernate.target hybrid-sleep.target; do
    [[ "$(unit_enabled "${target}")" == masked ]] || SLEEP_MASKED=0
  done
  if have systemctl; then DEFAULT_TARGET="$(systemctl get-default 2>/dev/null || true)"; fi
  GRAPHICAL_ACTIVE="$(unit_active graphical.target)"
  [[ -r /etc/X11/default-display-manager ]] && DISPLAY_MANAGER="$(basename "$(cat /etc/X11/default-display-manager)")"

  DISPLAY_CONFIGURED=0; DISPLAY_KIND=""; DISPLAY_RESOLUTION=""
  if [[ -f "${XORG_CONF}" ]]; then
    DISPLAY_CONFIGURED=1; DISPLAY_KIND="$(value_in "${DISPLAY_STATE}" kind)"; DISPLAY_RESOLUTION="$(value_in "${DISPLAY_STATE}" resolution)"
  fi

  POWER_SERVICE="$(unit_enabled martlet-gpu-power.service)"

  local nvcc=nvcc
  have nvcc || nvcc=/usr/local/cuda/bin/nvcc
  T_CUDA="$(version_of "${nvcc}" --version | tail -n1)"
  [[ -n "${T_CUDA}" ]] || T_CUDA="$("${nvcc}" --version 2>/dev/null | grep -oE 'release [0-9]+(\.[0-9]+)+' | grep -oE '[0-9.]+$' || true)"
  T_PYTHON="$(version_of python3 --version)"
  T_PIP="$(version_of python3 -m pip --version)"
  T_VENV=0; { installed python3-venv || python3 -c 'import ensurepip, venv' >/dev/null 2>&1; } && T_VENV=1
  T_NODE="$(version_of node --version)"
  T_NPM="$(version_of npm --version)"
  T_GIT="$(version_of git --version)"
  T_BUILD=0; installed build-essential && T_BUILD=1
  T_HTOP="$(version_of htop --version)"
  T_NVTOP="$(version_of nvtop --version)"
  [[ -z "${T_NVTOP}" ]] && installed nvtop && T_NVTOP="installed"
  T_CURL="$(version_of curl --version)"
  T_TMUX="$(tmux -V 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+[a-z]?' | head -n1 || true)"

  WOL_IFACE="$(wol_interface)"; WOL_MAC=""; WOL_WIRELESS=0; WOL_SUPPORTS=""; WOL_STATE=""
  if [[ -n "${WOL_IFACE}" ]]; then
    WOL_MAC="$(cat "/sys/class/net/${WOL_IFACE}/address" 2>/dev/null || true)"
    [[ -d "/sys/class/net/${WOL_IFACE}/wireless" || -d "/sys/class/net/${WOL_IFACE}/phy80211" ]] && WOL_WIRELESS=1
    WOL_SUPPORTS="$(ethtool_field "${WOL_IFACE}" 'Supports Wake-on')"
    WOL_STATE="$(ethtool_field "${WOL_IFACE}" 'Wake-on')"
  fi
  WOL_PERSISTENT="$(unit_enabled martlet-wol.service)"

  REBOOT_REASONS=()
  [[ -f /var/run/reboot-required ]] && REBOOT_REASONS+=("system updates")
  driver_pending && REBOOT_REASONS+=("NVIDIA driver")
  if [[ "${DEFAULT_TARGET}" == multi-user.target && "${GRAPHICAL_ACTIVE}" == active ]]; then REBOOT_REASONS+=("start in text mode")
  elif [[ "${DEFAULT_TARGET}" == graphical.target && -n "${GRAPHICAL_ACTIVE}" && "${GRAPHICAL_ACTIVE}" != active ]]; then REBOOT_REASONS+=("start the desktop"); fi
  if [[ -f "${DISPLAY_STATE}" ]]; then
    local since; since="$(value_in "${DISPLAY_STATE}" boot)"
    [[ -n "${since}" && "${since}" == "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" ]] && REBOOT_REASONS+=("virtual display")
  fi
}

status_json() {
  local gpus="" i saved
  for ((i = 0; i < G_COUNT; i++)); do
    saved="$(value_in "${POWER_CONF}" "${G_UUID[i]}")"
    gpus+="${gpus:+,}{\"index\":$(jnum "${G_INDEX[i]}"),\"uuid\":$(jstr "${G_UUID[i]}"),\"name\":$(jstr "${G_NAME[i]}"),\"memory_mb\":$(jnum "${G_MEM[i]}"),"
    gpus+="\"persistence\":$(jbool "${G_PM[i]}"),\"power\":{\"current\":$(jnum "${G_PL[i]}"),\"default\":$(jnum "${G_PDEF[i]}"),"
    gpus+="\"min\":$(jnum "${G_PMIN[i]}"),\"max\":$(jnum "${G_PMAX[i]}"),\"draw\":$(jnum "${G_DRAW[i]}"),\"saved\":$(jnum "${saved}")}}"
  done
  printf '{"martlet_prepare":%s,"supported":%s,"reason":%s,"hostname":%s,"user":%s,"sudo":%s,"systemd":%s,' \
    "${PREPARE_VERSION}" "$(jbool "${SUPPORTED}")" "$(jstr "${REASON}")" "$(jstr "${HOST_NAME}")" "$(jstr "${TARGET_USER}")" \
    "$(jstr "${SUDO_MODE}")" "$(jbool "${SYSTEMD}")"
  printf '"os":{"id":%s,"version":%s,"name":%s,"codename":%s,"kernel":%s,"arch":%s},' \
    "$(jstr "${OS_ID}")" "$(jstr "${OS_VERSION}")" "$(jstr "${OS_NAME}")" "$(jstr "${OS_CODENAME}")" "$(jstr "${KERNEL}")" "$(jstr "${ARCH}")"
  printf '"reboot_required":%s,"reboot_reasons":%s,"updates":{"upgradable":%s},' \
    "$(jbool "$([[ ${#REBOOT_REASONS[@]} -gt 0 ]] && echo 1)")" "$(jarr "${REBOOT_REASONS[@]}")" "$(jnum "${UPGRADABLE}")"
  printf '"docker":{"installed":%s,"version":%s,"compose":%s,"running":%s,"enabled":%s,"user_in_group":%s},' \
    "$(jbool "$([[ -n "${DOCKER_VERSION}" ]] && echo 1)")" "$(jstr "${DOCKER_VERSION}")" "$(jstr "${COMPOSE_VERSION}")" \
    "$(jbool "${DOCKER_RUNNING}")" "$(jbool "${DOCKER_ENABLED}")" "$(jbool "${DOCKER_GROUP}")"
  printf '"nvidia":{"present":%s,"working":%s,"driver":%s,"driver_package":%s,"recommended":%s,"cuda":%s,"secure_boot":%s,' \
    "$(jbool "${NV_PRESENT}")" "$(jbool "${NV_SMI}")" "$(jstr "${NV_DRIVER}")" "$(jstr "${NV_PACKAGE}")" "$(jstr "${NV_RECOMMENDED}")" \
    "$(jstr "${NV_CUDA}")" "$(if [[ -n "${NV_SECURE_BOOT}" ]]; then jbool "${NV_SECURE_BOOT}"; else printf null; fi)"
  printf '"toolkit":%s,"toolkit_configured":%s,"persistenced":%s},"gpus":[%s],"gpu_power":{"service":%s},' \
    "$(jstr "${NV_TOOLKIT}")" "$(jbool "${NV_TOOLKIT_CONFIGURED}")" "$(jbool "${NV_PERSISTENCED}")" "${gpus}" "$(jbool "${POWER_SERVICE}")"
  printf '"headless":{"ssh_server":%s,"ssh_enabled":%s,"sleep_masked":%s,"default_target":%s,"graphical_active":%s,"display_manager":%s},' \
    "$(jbool "${SSH_SERVER}")" "$(jbool "${SSH_ENABLED}")" "$(jbool "${SLEEP_MASKED}")" "$(jstr "${DEFAULT_TARGET}")" \
    "$(jbool "${GRAPHICAL_ACTIVE}")" "$(jstr "${DISPLAY_MANAGER}")"
  printf '"virtual_display":{"configured":%s,"kind":%s,"resolution":%s},' \
    "$(jbool "${DISPLAY_CONFIGURED}")" "$(jstr "${DISPLAY_KIND}")" "$(jstr "${DISPLAY_RESOLUTION}")"
  printf '"tools":{"cuda":%s,"python":%s,"pip":%s,"venv":%s,"node":%s,"npm":%s,"git":%s,"build":%s,"htop":%s,"nvtop":%s,"curl":%s,"tmux":%s},' \
    "$(jstr "${T_CUDA}")" "$(jstr "${T_PYTHON}")" "$(jstr "${T_PIP}")" "$(jbool "${T_VENV}")" "$(jstr "${T_NODE}")" "$(jstr "${T_NPM}")" \
    "$(jstr "${T_GIT}")" "$(jbool "${T_BUILD}")" "$(jstr "${T_HTOP}")" "$(jstr "${T_NVTOP}")" "$(jstr "${T_CURL}")" "$(jstr "${T_TMUX}")"
  printf '"wol":{"interface":%s,"mac":%s,"wireless":%s,"supports":%s,"wake_on":%s,"supported":%s,"enabled":%s,"persistent":%s}}\n' \
    "$(jstr "${WOL_IFACE}")" "$(jstr "${WOL_MAC}")" "$(jbool "${WOL_WIRELESS}")" "$(jstr "${WOL_SUPPORTS}")" "$(jstr "${WOL_STATE}")" \
    "$(if [[ -n "${WOL_SUPPORTS}" ]]; then jbool "$([[ "${WOL_SUPPORTS}" == *g* ]] && echo 1)"; else printf null; fi)" \
    "$(jbool "$([[ "${WOL_STATE}" == *g* ]] && echo 1)")" "$(jbool "${WOL_PERSISTENT}")"
}

status_text() {
  local i
  or_none() { printf '%s' "${1:-${2:-not installed}}"; }
  printf '%s (%s), kernel %s, %s\n' "${HOST_NAME}" "${OS_NAME}" "${KERNEL}" "${ARCH}"
  [[ ${SUPPORTED} == 1 ]] || printf 'Not supported: %s\n' "${REASON}"
  printf 'sudo: %s   updates waiting: %s\n' "${SUDO_MODE}" "${UPGRADABLE:-unknown}"
  printf 'Docker: %s, Compose %s, running %s, %s in docker group: %s\n' "$(or_none "${DOCKER_VERSION}")" "$(or_none "${COMPOSE_VERSION}")" \
    "${DOCKER_RUNNING:-no}" "${TARGET_USER}" "$(jbool "${DOCKER_GROUP}")"
  printf 'NVIDIA: GPU %s, driver %s (%s; recommended %s), CUDA %s, container toolkit %s (configured %s)\n' \
    "$(jbool "${NV_PRESENT}")" "$(or_none "${NV_DRIVER}")" "$(or_none "${NV_PACKAGE}" none)" "$(or_none "${NV_RECOMMENDED}" unknown)" \
    "$(or_none "${NV_CUDA}" none)" "$(or_none "${NV_TOOLKIT}")" "$(jbool "${NV_TOOLKIT_CONFIGURED}")"
  for ((i = 0; i < G_COUNT; i++)); do
    printf '  GPU %s %s: %s MiB, persistence %s, power limit %s W (default %s, range %s-%s)\n' "${G_INDEX[i]}" "${G_NAME[i]}" \
      "${G_MEM[i]}" "${G_PM[i]}" "${G_PL[i]}" "${G_PDEF[i]}" "${G_PMIN[i]}" "${G_PMAX[i]}"
  done
  printf 'Headless: SSH server %s (enabled %s), sleep masked %s, boots to %s\n' "$(jbool "${SSH_SERVER}")" "$(jbool "${SSH_ENABLED}")" \
    "$(jbool "${SLEEP_MASKED}")" "${DEFAULT_TARGET:-unknown}"
  printf 'Virtual display: %s\n' "$([[ ${DISPLAY_CONFIGURED} == 1 ]] && printf '%s %s' "${DISPLAY_KIND}" "${DISPLAY_RESOLUTION}" || printf 'off')"
  printf 'Tools: CUDA %s, Python %s (pip %s), Node.js %s, git %s, build-essential %s, htop %s, nvtop %s, curl %s, tmux %s\n' \
    "$(or_none "${T_CUDA}")" "$(or_none "${T_PYTHON}")" "$(or_none "${T_PIP}")" "$(or_none "${T_NODE}")" "$(or_none "${T_GIT}")" \
    "$(jbool "${T_BUILD}")" "$(or_none "${T_HTOP}")" "$(or_none "${T_NVTOP}")" "$(or_none "${T_CURL}")" "$(or_none "${T_TMUX}")"
  printf 'Wake-on-LAN: %s %s, supports %s, now %s, kept at boot %s\n' "${WOL_IFACE:-no wired card}" "${WOL_MAC}" \
    "${WOL_SUPPORTS:-unknown}" "${WOL_STATE:-unknown}" "$(jbool "${WOL_PERSISTENT}")"
  if [[ ${#REBOOT_REASONS[@]} -gt 0 ]]; then printf 'Restart needed for: %s\n' "$(IFS=,; printf '%s' "${REBOOT_REASONS[*]}")"; fi
}

cmd_status() {
  collect
  if [[ "${1:-}" == --json ]]; then status_json; else status_text; fi
}

# ------------------------------------------------------------------ applying items
OK=1; RESULTS=(); REBOOT_REASONS=(); RESTARTING=""; WOL_RESULT_MAC=""
ITEM_STATE=ok; ITEM_MSG=""
changed() { ITEM_STATE=changed; ITEM_MSG="$*"; }
okay() { ITEM_MSG="$*"; }
skipped() { ITEM_STATE=skipped; ITEM_MSG="$*"; }
fail_item() { ITEM_MSG="$*"; printf '==> %s: FAILED: %s\n' "${CURRENT}" "$*"; return 1; }
needs_restart() { local r; for r in "${REBOOT_REASONS[@]}"; do [[ "${r}" == "$1" ]] && return 0; done; REBOOT_REASONS+=("$1"); }

APT_READY=0
APT_ENV=(env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a NEEDRESTART_SUSPEND=1)
APT_OPTS=(-y -q -o DPkg::Lock::Timeout=600 -o Dpkg::Progress-Fancy=0 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
apt_update() {
  [[ ${APT_READY} == 1 && "${1:-}" != again ]] && return 0
  step "refreshing package lists (apt-get update)"
  as_root "${APT_ENV[@]}" apt-get -q -o DPkg::Lock::Timeout=600 update || return 1
  APT_READY=1
}
apt_install() {
  apt_update || return 1
  step "installing: $*"
  as_root "${APT_ENV[@]}" apt-get "${APT_OPTS[@]}" install "$@"
}
need_packages() { # installs whichever of the packages are missing
  local missing=() p
  for p in "$@"; do installed "${p}" || missing+=("${p}"); done
  [[ ${#missing[@]} -eq 0 ]] || apt_install "${missing[@]}"
}

# Writes content (plus a newline) to a root-owned file. Returns 0 when written, 1 when already identical, 2 on failure.
put_file() {
  local path="$1" content="$2" mode="${3:-0644}"
  if [[ -f "${path}" && "$(cat "${path}" 2>/dev/null)" == "${content}" ]]; then return 1; fi
  as_root install -d -m 0755 "$(dirname "${path}")" || return 2
  printf '%s\n' "${content}" | as_root tee "${path}" >/dev/null || return 2
  as_root chmod "${mode}" "${path}" || return 2
  return 0
}
need_systemd() { have_systemd || fail_item "systemd is not running here, so services cannot be set up."; }

# ---- updates
item_updates() {
  apt_update again || { fail_item "apt-get update failed; check the network and the messages above."; return 1; }
  step "upgrading installed packages (this can take a while)"
  local log; log="$(mktemp)"
  as_root "${APT_ENV[@]}" apt-get "${APT_OPTS[@]}" upgrade --with-new-pkgs 2>&1 | tee "${log}"
  local status=${PIPESTATUS[0]}
  if [[ ${status} -ne 0 ]]; then rm -f "${log}"; fail_item "apt-get upgrade failed (exit ${status})."; return 1; fi
  if grep -qE '^0 upgraded, 0 newly installed' "${log}"; then okay "Everything was already up to date."
  else changed "Installed the available updates."; fi
  rm -f "${log}"
  [[ -f /var/run/reboot-required ]] && needs_restart "system updates"
  return 0
}

# ---- docker
item_docker() {
  local did=0
  if ! have docker; then
    step "installing Docker Engine and Compose (Ubuntu packages docker.io, docker-compose-v2)"
    apt_install docker.io docker-compose-v2 || { fail_item "Docker could not be installed."; return 1; }
    did=1
  elif ! docker compose version >/dev/null 2>&1; then
    if installed docker-ce; then apt_install docker-compose-plugin; else apt_install docker-compose-v2; fi ||
      { fail_item "The Docker Compose plugin could not be installed."; return 1; }
    did=1
  fi
  need_systemd || return 1
  if [[ "$(unit_enabled docker.service)" != enabled || "$(unit_active docker.service)" != active ]]; then
    step "starting Docker and turning it on at boot"
    as_root systemctl enable --now docker.service || { fail_item "Docker did not start (see: journalctl -u docker)."; return 1; }
    did=1
  fi
  if [[ "${TARGET_USER}" != root ]] && ! id -nG "${TARGET_USER}" | grep -qw docker; then
    step "adding ${TARGET_USER} to the docker group (takes effect at the next sign-in)"
    as_root usermod -aG docker "${TARGET_USER}" || { fail_item "Could not add ${TARGET_USER} to the docker group."; return 1; }
    did=1
  fi
  local version compose
  version="$(as_root docker version --format '{{.Server.Version}}' 2>/dev/null)" || { fail_item "Docker is installed but does not answer."; return 1; }
  compose="$(docker compose version --short 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)"
  if [[ ${did} == 1 ]]; then changed "Docker ${version} with Compose ${compose} is running and starts at boot."
  else okay "Docker ${version} with Compose ${compose} was already running."; fi
}

# ---- NVIDIA driver
item_nvidia_driver() {
  nvidia_present || { fail_item "No NVIDIA graphics card was found in this computer."; return 1; }
  need_packages ubuntu-drivers-common || { fail_item "Could not install ubuntu-drivers-common."; return 1; }
  apt_update
  local recommended current
  recommended="$(recommended_driver)"
  [[ -n "${recommended}" ]] || { fail_item "ubuntu-drivers found no recommended NVIDIA driver for this card."; return 1; }
  current="$(driver_package)"
  if [[ "${current}" == "${recommended}" ]] && smi_ok && ! driver_pending; then
    okay "${recommended} is installed and running (driver $(loaded_driver))."
    return 0
  fi
  if have mokutil && mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'; then
    warn "Secure Boot is on. Ubuntu's signed NVIDIA modules normally load; if the driver does not load after the restart, turn Secure Boot off in the firmware settings."
  fi
  step "installing ${recommended} with ubuntu-drivers (this can take several minutes)"
  as_root "${APT_ENV[@]}" ubuntu-drivers install || { fail_item "ubuntu-drivers install failed."; return 1; }
  if [[ "${current}" == "${recommended}" ]]; then changed "${recommended} was repaired."; else changed "Installed ${recommended}${current:+ (was ${current})}."; fi
  if driver_pending || ! smi_ok; then
    needs_restart "NVIDIA driver"
    ITEM_MSG+=" Restart the computer to use it."
  fi
}

# ---- NVIDIA Container Toolkit
item_nvidia_toolkit() {
  have docker || { fail_item "Install Docker first (tick Docker as well)."; return 1; }
  nvidia_present || { fail_item "No NVIDIA graphics card was found in this computer."; return 1; }
  local did=0
  if ! have nvidia-ctk; then
    need_packages curl gpg ca-certificates || { fail_item "Could not install curl and gpg."; return 1; }
    step "adding NVIDIA's container toolkit package repository"
    curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | as_root gpg --dearmor --yes -o "${TOOLKIT_KEY}" ||
      { fail_item "Could not download NVIDIA's signing key."; return 1; }
    curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list |
      sed "s#deb https://#deb [signed-by=${TOOLKIT_KEY}] https://#g" | as_root tee "${TOOLKIT_LIST}" >/dev/null ||
      { fail_item "Could not add NVIDIA's package repository."; return 1; }
    apt_update again && apt_install nvidia-container-toolkit || { fail_item "Could not install nvidia-container-toolkit."; return 1; }
    did=1
  fi
  if ! grep -q '"nvidia"' /etc/docker/daemon.json 2>/dev/null; then
    step "configuring Docker to use NVIDIA GPUs (nvidia-ctk runtime configure --runtime=docker)"
    as_root nvidia-ctk runtime configure --runtime=docker || { fail_item "nvidia-ctk could not configure Docker."; return 1; }
    did=1
  fi
  if [[ ${did} == 1 ]] && have_systemd; then step "restarting Docker"; as_root systemctl restart docker.service; fi
  if driver_pending || ! smi_ok; then
    [[ ${did} == 1 ]] && changed "Installed and configured." || okay "Installed and configured."
    ITEM_MSG+=" The GPU check runs after the NVIDIA driver works (restart first)."
    return 0
  fi
  step "checking that containers can use the GPU: docker run --rm --gpus all ubuntu:24.04 nvidia-smi"
  as_root docker run --rm --gpus all ubuntu:24.04 nvidia-smi || { fail_item "A --gpus all container could not run nvidia-smi."; return 1; }
  if [[ ${did} == 1 ]]; then changed "Containers can use the GPU (checked with nvidia-smi in a container)."
  else okay "Containers can use the GPU (checked with nvidia-smi in a container)."; fi
}

# ---- headless
BOOT=""
item_headless() {
  need_systemd || return 1
  local did=0 notes=()
  if ! installed openssh-server; then apt_install openssh-server || { fail_item "Could not install openssh-server."; return 1; }; did=1; fi
  if [[ "$(unit_enabled ssh.socket)" == enabled ]]; then :
  elif [[ "$(unit_enabled ssh.service)" != enabled ]]; then
    step "turning the SSH server on at boot"
    as_root systemctl enable --now ssh.service || { fail_item "Could not enable the SSH server."; return 1; }
    did=1
  fi
  local target masked=1
  for target in "${SLEEP_TARGETS[@]}"; do [[ "$(unit_enabled "${target}")" == masked ]] || masked=0; done
  if [[ ${masked} == 0 ]]; then
    step "turning off sleep, suspend and hibernate (systemctl mask ${SLEEP_TARGETS[*]})"
    as_root systemctl mask "${SLEEP_TARGETS[@]}" || { fail_item "Could not turn off sleep."; return 1; }
    did=1
  fi
  local want="" now; now="$(systemctl get-default 2>/dev/null)"
  case "${BOOT}" in
    text) want=multi-user.target ;;
    graphical) want=graphical.target ;;
  esac
  if [[ -n "${want}" && "${now}" != "${want}" ]]; then
    step "starting in ${BOOT} mode from the next boot (systemctl set-default ${want})"
    as_root systemctl set-default "${want}" || { fail_item "Could not change the boot target."; return 1; }
    did=1
    local graphical; graphical="$(unit_active graphical.target)"
    if [[ "${BOOT}" == text && "${graphical}" == active ]]; then needs_restart "start in text mode"; notes+=("Starts in text mode after a restart.")
    elif [[ "${BOOT}" == graphical && "${graphical}" != active ]]; then needs_restart "start the desktop"; notes+=("Starts the desktop after a restart.")
    else notes+=("Starts in ${BOOT} mode."); fi
  fi
  if [[ ${did} == 1 ]]; then changed "SSH is on, sleep is off. ${notes[*]:-}"; else okay "SSH was on and sleep was already off."; fi
}

# ---- virtual display
RESOLUTION=1920x1080; DISPLAY_OFF=0
# A reduced-blanking 60 Hz modeline for W x H (close to CVT-RB; any valid timing works for a virtual screen).
modeline() {
  awk -v w="$1" -v h="$2" 'BEGIN { ht = w + 160; vt = h + 35
    printf "Modeline \"%dx%d\" %.2f %d %d %d %d %d %d %d %d +hsync -vsync", w, h, ht * vt * 60 / 1000000, w, w + 48, w + 80, ht, h, h + 3, h + 8, vt }'
}

display_conf() { # kind, width, height, bus id
  local kind="$1" w="$2" h="$3" bus="${4:-}"
  printf '%s\n' "# Written by martlet-prepare (virtual-display): a virtual ${w}x${h} monitor so this computer has a desktop" \
    "# without a screen attached. Remove it with: martlet-prepare virtual-display --virtual-display-off" ""
  if [[ "${kind}" == nvidia ]]; then
    printf '%s\n' 'Section "Monitor"' '    Identifier "MartletVirtualMonitor"' '    HorizSync 28.0-160.0' '    VertRefresh 48.0-75.0' \
      "    $(modeline "${w}" "${h}")" '    Option "DPMS" "false"' 'EndSection' '' \
      'Section "Device"' '    Identifier "MartletNvidia"' '    Driver "nvidia"' "    BusID \"${bus}\"" \
      '    Option "AllowEmptyInitialConfiguration" "true"' '    Option "ConnectedMonitor" "DFP-0"' \
      '    Option "ModeValidation" "AllowNonEdidModes, NoEdidMaxPClkCheck, NoMaxPClkCheck, NoHorizSyncCheck, NoVertRefreshCheck"' \
      'EndSection' '' \
      'Section "Screen"' '    Identifier "MartletVirtualScreen"' '    Device "MartletNvidia"' '    Monitor "MartletVirtualMonitor"' \
      '    DefaultDepth 24' '    Option "AllowEmptyInitialConfiguration" "true"' "    Option \"MetaModes\" \"${w}x${h}\"" \
      '    SubSection "Display"' '        Depth 24' "        Virtual ${w} ${h}" "        Modes \"${w}x${h}\"" '    EndSubSection' 'EndSection'
  else
    printf '%s\n' 'Section "Device"' '    Identifier "MartletDummy"' '    Driver "dummy"' '    VideoRam 256000' 'EndSection' '' \
      'Section "Monitor"' '    Identifier "MartletVirtualMonitor"' '    HorizSync 5.0-1000.0' '    VertRefresh 5.0-200.0' \
      "    $(modeline "${w}" "${h}")" 'EndSection' '' \
      'Section "Screen"' '    Identifier "MartletVirtualScreen"' '    Device "MartletDummy"' '    Monitor "MartletVirtualMonitor"' \
      '    DefaultDepth 24' '    SubSection "Display"' '        Depth 24' "        Virtual ${w} ${h}" "        Modes \"${w}x${h}\"" \
      '    EndSubSection' 'EndSection'
  fi
}

item_virtual_display() {
  if [[ ${DISPLAY_OFF} == 1 ]]; then
    if [[ ! -f "${XORG_CONF}" && ! -f "${DISPLAY_STATE}" ]]; then okay "There was no virtual display."; return 0; fi
    step "removing the virtual display"
    if [[ "$(value_in "${DISPLAY_STATE}" gdm_wayland)" == changed && -f "${GDM_CONF}" ]]; then
      as_root sed -i 's/^WaylandEnable=false$/#WaylandEnable=false/' "${GDM_CONF}"
    fi
    as_root rm -f "${XORG_CONF}" "${DISPLAY_STATE}" || { fail_item "Could not remove ${XORG_CONF}."; return 1; }
    needs_restart "virtual display"
    changed "Removed the virtual display. Restart to go back to the attached screen."
    return 0
  fi
  [[ "${RESOLUTION}" =~ ^([0-9]{3,4})x([0-9]{3,4})$ ]] || { fail_item "Resolution must look like 1920x1080."; return 1; }
  local w="${BASH_REMATCH[1]}" h="${BASH_REMATCH[2]}" kind bus=""
  (( w >= 640 && w <= 7680 && h >= 480 && h <= 4320 )) || { fail_item "Resolution must be between 640x480 and 7680x4320."; return 1; }
  if nvidia_present; then
    kind=nvidia
    [[ -n "$(driver_package)" ]] || smi_ok || { fail_item "Install the NVIDIA driver first (tick NVIDIA driver as well)."; return 1; }
    bus="$(nvidia_bus_id)"
  else
    kind=dummy
    need_packages xserver-xorg-video-dummy || { fail_item "Could not install xserver-xorg-video-dummy."; return 1; }
  fi
  local did=0 content
  content="$(display_conf "${kind}" "${w}" "${h}" "${bus}")"
  put_file "${XORG_CONF}" "${content}"
  case $? in 0) did=1 ;; 2) fail_item "Could not write ${XORG_CONF}."; return 1 ;; esac
  local wayland; wayland="$(value_in "${DISPLAY_STATE}" gdm_wayland)"
  if [[ -f "${GDM_CONF}" ]] && ! grep -qE '^[[:space:]]*WaylandEnable[[:space:]]*=[[:space:]]*false' "${GDM_CONF}"; then
    step "switching the login screen to Xorg (WaylandEnable=false in ${GDM_CONF}) so it uses the virtual display"
    if grep -qE '^#[[:space:]]*WaylandEnable=false' "${GDM_CONF}"; then
      as_root sed -i -E 's/^#[[:space:]]*WaylandEnable=false/WaylandEnable=false/' "${GDM_CONF}"
    elif grep -q '^\[daemon\]' "${GDM_CONF}"; then
      as_root sed -i '/^\[daemon\]/a WaylandEnable=false' "${GDM_CONF}"
    else
      printf '[daemon]\nWaylandEnable=false\n' | as_root tee -a "${GDM_CONF}" >/dev/null
    fi
    wayland=changed; did=1
  fi
  if [[ ${did} == 0 ]]; then okay "A ${w}x${h} virtual display (${kind}) was already set up."; return 0; fi
  put_file "${DISPLAY_STATE}" "$(printf 'kind=%s\nresolution=%sx%s\ngdm_wayland=%s\nboot=%s' "${kind}" "${w}" "${h}" "${wayland:-unchanged}" \
    "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)")"
  have Xorg || warn "No X server is installed yet; the virtual display is used when a desktop or streaming app starts Xorg."
  [[ "$(systemctl get-default 2>/dev/null)" == multi-user.target ]] &&
    warn "This computer starts in text mode, so no desktop uses the virtual display until it starts graphically."
  needs_restart "virtual display"
  changed "Set up a ${w}x${h} virtual display (${kind}). Restart to use it."
}

# ---- GPU power
POWER_SPECS=(); POWER_RESET=0
POWER_HELPER_TEXT='#!/bin/sh
# Written by martlet-prepare (gpu-power): turns on NVIDIA persistence mode and reapplies the power limits saved in
# /etc/martlet/gpu-power.conf (GPU UUID=watts) at every boot. Undo with: martlet-prepare gpu-power --power-reset
nvidia-smi -pm 1 >/dev/null 2>&1 || true
[ -r /etc/martlet/gpu-power.conf ] || exit 0
status=0
while IFS="=" read -r gpu watts; do
  case "$gpu" in ""|"#"*) continue ;; esac
  nvidia-smi -i "$gpu" -pl "$watts" || status=1
done < /etc/martlet/gpu-power.conf
exit $status'
POWER_UNIT_TEXT="[Unit]
Description=Martlet: NVIDIA persistence mode and GPU power limits
After=systemd-modules-load.service nvidia-persistenced.service

[Service]
Type=oneshot
ExecStart=${POWER_HELPER}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target"

item_gpu_power() {
  smi_ok || { fail_item "Needs a working NVIDIA driver (install it and restart first)."; return 1; }
  need_systemd || return 1
  read_gpus
  [[ ${G_COUNT} -gt 0 ]] || { fail_item "nvidia-smi lists no GPUs."; return 1; }
  local i did=0 notes=()
  if [[ ${POWER_RESET} == 1 ]]; then
    for ((i = 0; i < G_COUNT; i++)); do
      [[ "${G_PDEF[i]}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || continue
      step "GPU ${G_INDEX[i]} (${G_NAME[i]}): power limit back to its default ${G_PDEF[i]} W"
      as_root nvidia-smi -i "${G_UUID[i]}" -pl "${G_PDEF[i]%%.*}" || warn "GPU ${G_INDEX[i]} did not accept its default limit."
    done
    as_root systemctl disable --now martlet-gpu-power.service >/dev/null 2>&1
    as_root rm -f "${POWER_UNIT}" "${POWER_HELPER}" "${POWER_CONF}"
    as_root systemctl daemon-reload
    changed "Every GPU is back to its default power limit; nothing is reapplied at boot. Persistence mode stays on until the next restart."
    return 0
  fi
  for ((i = 0; i < G_COUNT; i++)); do
    if [[ "${G_PM[i]}" != Enabled ]]; then
      step "turning on persistence mode (keeps the driver loaded so settings stick and GPU jobs start faster)"
      as_root nvidia-smi -pm 1 || { fail_item "nvidia-smi could not turn on persistence mode."; return 1; }
      did=1; break
    fi
  done
  declare -A saved=()
  local key value spec gpu watts found
  if [[ -r "${POWER_CONF}" ]]; then
    while IFS='=' read -r key value; do [[ -n "${key}" && "${key}" != \#* ]] && saved["${key}"]="${value}"; done < "${POWER_CONF}"
  fi
  for spec in "${POWER_SPECS[@]}"; do
    gpu="${spec%%=*}"; watts="${spec#*=}"; found=-1
    [[ "${watts}" =~ ^[0-9]{1,4}$ ]] || { fail_item "Power limit '${watts}' must be whole watts."; return 1; }
    for ((i = 0; i < G_COUNT; i++)); do [[ "${G_UUID[i]}" == "${gpu}" || "${G_INDEX[i]}" == "${gpu}" ]] && found=${i}; done
    [[ ${found} -ge 0 ]] || { fail_item "There is no GPU '${gpu}' on this computer."; return 1; }
    i=${found}
    if [[ ! "${G_PMIN[i]}" =~ ^[0-9] || ! "${G_PMAX[i]}" =~ ^[0-9] ]]; then
      fail_item "GPU ${G_INDEX[i]} (${G_NAME[i]}) does not allow changing its power limit."; return 1
    fi
    awk -v w="${watts}" -v lo="${G_PMIN[i]}" -v hi="${G_PMAX[i]}" 'BEGIN { exit !(w + 0.5 >= lo && w - 0.5 <= hi) }' ||
      { fail_item "GPU ${G_INDEX[i]} accepts ${G_PMIN[i]}-${G_PMAX[i]} W, not ${watts} W."; return 1; }
    if [[ "${saved[${G_UUID[i]}]:-}" == "${watts}" && "${G_PL[i]%%.*}" == "${watts}" ]]; then continue; fi
    step "GPU ${G_INDEX[i]} (${G_NAME[i]}): power limit ${G_PL[i]} W -> ${watts} W (default ${G_PDEF[i]} W)"
    as_root nvidia-smi -i "${G_UUID[i]}" -pl "${watts}" || { fail_item "nvidia-smi did not accept ${watts} W for GPU ${G_INDEX[i]}."; return 1; }
    saved["${G_UUID[i]}"]="${watts}"; notes+=("GPU ${G_INDEX[i]} ${watts} W"); did=1
  done
  local conf="# Written by martlet-prepare (gpu-power): GPU UUID=power limit in watts, reapplied at boot by ${POWER_HELPER}."
  for key in "${!saved[@]}"; do conf+=$'\n'"${key}=${saved[${key}]}"; done
  put_file "${POWER_CONF}" "${conf}" 0644; [[ $? == 2 ]] && { fail_item "Could not write ${POWER_CONF}."; return 1; }
  put_file "${POWER_HELPER}" "${POWER_HELPER_TEXT}" 0755; [[ $? == 2 ]] && { fail_item "Could not write ${POWER_HELPER}."; return 1; }
  put_file "${POWER_UNIT}" "${POWER_UNIT_TEXT}" 0644; case $? in 0) as_root systemctl daemon-reload ;; 2) fail_item "Could not write ${POWER_UNIT}."; return 1 ;; esac
  if [[ "$(unit_enabled martlet-gpu-power.service)" != enabled ]]; then
    as_root systemctl enable martlet-gpu-power.service || { fail_item "Could not enable martlet-gpu-power.service."; return 1; }
    did=1
  fi
  if [[ ${did} == 1 ]]; then changed "Persistence mode on${notes[*]:+; }$(IFS=,; printf '%s' "${notes[*]:-}"). Reapplied at every boot by martlet-gpu-power.service."
  else okay "Persistence mode and the saved power limits were already in place."; fi
}

# ---- tools
TOOLS=""
TOOL_DONE=(); TOOL_HAD=(); TOOL_FAILED=()

cuda_nvcc() { if have nvcc; then command -v nvcc; elif [[ -x /usr/local/cuda/bin/nvcc ]]; then printf '/usr/local/cuda/bin/nvcc'; fi; }
cuda_version() { local n; n="$(cuda_nvcc)"; [[ -n "${n}" ]] && "${n}" --version 2>/dev/null | grep -oE 'release [0-9]+(\.[0-9]+)+' | grep -oE '[0-9.]+$'; return 0; }

tool_cuda() {
  if [[ -n "$(cuda_nvcc)" ]]; then TOOL_HAD+=("CUDA $(cuda_version)"); return 0; fi
  nvidia_present || { TOOL_HAD+=("CUDA skipped (no NVIDIA GPU)"); return 0; }
  need_packages curl ca-certificates || return 1
  local repo="ubuntu${OS_VERSION//./}"
  if ! installed cuda-keyring; then
    local deb; deb="$(mktemp --suffix=.deb)"
    step "adding NVIDIA's CUDA package repository (${repo})"
    curl -fsSL -o "${deb}" "https://developer.download.nvidia.com/compute/cuda/repos/${repo}/x86_64/cuda-keyring_1.1-1_all.deb" &&
      as_root dpkg -i "${deb}" || { rm -f "${deb}"; return 1; }
    rm -f "${deb}"
    APT_READY=0
  fi
  # Take only what exists nowhere else (the CUDA toolkit) from NVIDIA's repository, never its driver packages, so the
  # Ubuntu NVIDIA driver chosen by ubuntu-drivers stays in charge.
  put_file "${CUDA_PIN}" "$(printf '%s\n' '# Written by martlet-prepare (tools: cuda): keep the Ubuntu NVIDIA driver; use this repository only for CUDA.' \
    'Package: *' 'Pin: origin developer.download.nvidia.com' 'Pin-Priority: 100')"
  apt_update || return 1
  local package=cuda-toolkit driver_cuda
  driver_cuda="$(timeout 30 nvidia-smi 2>/dev/null | grep -oE 'CUDA Version: *[0-9]+\.[0-9]+' | grep -oE '[0-9]+\.[0-9]+$')"
  # Match the toolkit to the newest CUDA the installed driver supports, when NVIDIA publishes that exact version.
  if [[ "${driver_cuda}" =~ ^([0-9]+)\.([0-9]+)$ ]] && apt-cache show "cuda-toolkit-${BASH_REMATCH[1]}-${BASH_REMATCH[2]}" >/dev/null 2>&1; then
    package="cuda-toolkit-${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
  fi
  apt_install "${package}" || return 1
  put_file "${CUDA_PROFILE}" '# Written by martlet-prepare (tools: cuda): put nvcc and the CUDA tools on PATH for login shells.
case ":${PATH}:" in *:/usr/local/cuda/bin:*) ;; *) PATH="/usr/local/cuda/bin:${PATH}" ;; esac'
  TOOL_DONE+=("CUDA $(cuda_version)")
}

node_lts_major() {
  local major
  major="$(curl -fsSL --max-time 20 https://nodejs.org/dist/index.json 2>/dev/null | tr '{' '\n' | grep -m1 '"lts":"' |
    sed -n 's/.*"version":"v\([0-9]*\)\..*/\1/p')"
  if [[ "${major}" =~ ^[0-9]+$ ]]; then printf '%s' "${major}"; else printf '%s' "${NODE_FALLBACK_MAJOR}"; fi
}

tool_node() {
  need_packages curl gpg ca-certificates || return 1
  local major current
  major="$(node_lts_major)"
  current="$(node --version 2>/dev/null | grep -oE '^v[0-9]+' | tr -d v)"
  if [[ -n "${current}" && "${current}" -ge "${major}" ]]; then TOOL_HAD+=("Node.js $(node --version | tr -d v)"); return 0; fi
  step "adding the NodeSource repository for Node.js ${major} (current LTS)"
  as_root install -d -m 0755 "$(dirname "${NODE_KEY}")" &&
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | as_root gpg --dearmor --yes -o "${NODE_KEY}" || return 1
  put_file "${NODE_LIST}" "deb [signed-by=${NODE_KEY}] https://deb.nodesource.com/node_${major}.x nodistro main"
  [[ $? == 2 ]] && return 1
  apt_update again && apt_install nodejs || return 1
  TOOL_DONE+=("Node.js $(node --version 2>/dev/null | tr -d v)")
}

item_tools() {
  local list=() tool packages=() labels=() p
  if [[ -n "${TOOLS}" ]]; then IFS=, read -ra list <<< "${TOOLS}"; else list=("${TOOL_NAMES[@]}"); fi
  for tool in "${list[@]}"; do
    case " ${TOOL_NAMES[*]} " in *" ${tool} "*) ;; *) fail_item "Unknown tool '${tool}' (choose from ${TOOL_NAMES[*]})."; return 1 ;; esac
  done
  for tool in "${list[@]}"; do
    case "${tool}" in
      python) packages+=(python3 python3-pip python3-venv); labels+=(Python) ;;
      build) packages+=(build-essential); labels+=(build-essential) ;;
      git|htop|nvtop|curl|tmux) packages+=("${tool}"); labels+=("${tool}") ;;
    esac
  done
  if [[ ${#packages[@]} -gt 0 ]]; then
    local missing=()
    for p in "${packages[@]}"; do installed "${p}" || missing+=("${p}"); done
    if [[ ${#missing[@]} -eq 0 ]]; then TOOL_HAD+=("${labels[@]}")
    elif apt_install "${missing[@]}"; then TOOL_DONE+=("${missing[@]}")
    else TOOL_FAILED+=("${missing[@]}"); fi
  fi
  for tool in "${list[@]}"; do
    case "${tool}" in
      cuda) step "CUDA toolkit"; tool_cuda || TOOL_FAILED+=(CUDA) ;;
      node) step "Node.js LTS"; tool_node || TOOL_FAILED+=(Node.js) ;;
    esac
  done
  local summary=""
  [[ ${#TOOL_DONE[@]} -gt 0 ]] && summary+="Installed: $(IFS=,; printf '%s' "${TOOL_DONE[*]}"). "
  [[ ${#TOOL_HAD[@]} -gt 0 ]] && summary+="Already there: $(IFS=,; printf '%s' "${TOOL_HAD[*]}"). "
  if [[ ${#TOOL_FAILED[@]} -gt 0 ]]; then fail_item "${summary}Failed: $(IFS=,; printf '%s' "${TOOL_FAILED[*]}")."; return 1; fi
  if [[ ${#TOOL_DONE[@]} -gt 0 ]]; then changed "${summary% }"; else okay "${summary% }"; fi
}

# ---- Wake-on-LAN
item_wol() {
  need_systemd || return 1
  local iface mac supports state did=0
  iface="$(wol_interface)"
  [[ -n "${iface}" ]] || { fail_item "No network card carries the default route."; return 1; }
  mac="$(cat "/sys/class/net/${iface}/address" 2>/dev/null)"
  WOL_RESULT_MAC="${mac}"
  if [[ -d "/sys/class/net/${iface}/wireless" || -d "/sys/class/net/${iface}/phy80211" ]]; then
    fail_item "${iface} is Wi-Fi; Wake-on-LAN needs the computer on a network cable."; return 1
  fi
  need_packages ethtool || { fail_item "Could not install ethtool."; return 1; }
  supports="$(ethtool_field "${iface}" 'Supports Wake-on')"
  [[ "${supports}" == *g* ]] ||
    { fail_item "${iface} does not offer magic-packet wake (Supports Wake-on: ${supports:-unknown}). Turn on Wake-on-LAN in the BIOS/UEFI settings, then try again."; return 1; }
  state="$(ethtool_field "${iface}" 'Wake-on')"
  if [[ "${state}" != *g* ]]; then
    step "turning on Wake-on-LAN for ${iface} (ethtool -s ${iface} wol g)"
    as_root ethtool -s "${iface}" wol g || { fail_item "ethtool could not turn on Wake-on-LAN."; return 1; }
    did=1
  fi
  local unit
  unit="[Unit]
Description=Martlet: Wake-on-LAN (magic packet) for ${iface}
BindsTo=sys-subsystem-net-devices-${iface}.device
After=sys-subsystem-net-devices-${iface}.device

[Service]
Type=oneshot
ExecStart=$(command -v ethtool) -s ${iface} wol g
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target"
  put_file "${WOL_UNIT}" "${unit}"
  case $? in 0) as_root systemctl daemon-reload; did=1 ;; 2) fail_item "Could not write ${WOL_UNIT}."; return 1 ;; esac
  if [[ "$(unit_enabled martlet-wol.service)" != enabled ]]; then
    as_root systemctl enable martlet-wol.service || { fail_item "Could not enable martlet-wol.service."; return 1; }
    did=1
  fi
  if have nmcli && [[ "$(unit_active NetworkManager)" == active ]]; then
    local connection
    connection="$(nmcli -g GENERAL.CONNECTION device show "${iface}" 2>/dev/null | head -n1)"
    if [[ -n "${connection}" && "$(nmcli -g 802-3-ethernet.wake-on-lan connection show "${connection}" 2>/dev/null)" != magic ]]; then
      as_root nmcli connection modify "${connection}" 802-3-ethernet.wake-on-lan magic && did=1
    fi
  fi
  printf 'MARTLET-WOL %s %s\n' "${iface}" "${mac}"
  local hint="If it does not wake, also turn on Wake-on-LAN (or Power On by PCI-E) in the BIOS/UEFI settings."
  if [[ ${did} == 1 ]]; then changed "Wake-on-LAN is on for ${iface} (MAC ${mac}) and kept across restarts. ${hint}"
  else okay "Wake-on-LAN was already on for ${iface} (MAC ${mac}). ${hint}"; fi
}

# ---- power
power_off() { # reboot | poweroff
  need_systemd || return 1
  step "$([[ $1 == reboot ]] && echo restarting || echo 'shutting down') in a few seconds"
  as_root systemd-run --quiet --on-active=3 --timer-property=AccuracySec=100ms "$(command -v systemctl)" "$1" ||
    as_root shutdown "$([[ $1 == reboot ]] && echo -r || echo -h)" +0 ||
    { fail_item "Could not $([[ $1 == reboot ]] && echo restart || echo 'shut down') the computer."; return 1; }
  RESTARTING="$1"
  REBOOT_REASONS=()
  changed "$([[ $1 == reboot ]] && echo 'Restarting now.' || echo 'Shutting down now.')"
}
item_reboot() { power_off reboot; }
item_shutdown() { power_off poweroff; }

# ------------------------------------------------------------------ main
result_line() { # ok, error (optional)
  local items; items="$(IFS=,; printf '%s' "${RESULTS[*]:-}")"
  printf 'MARTLET-RESULT {"martlet_prepare":%s,"ok":%s,"error":%s,"reboot_required":%s,"reboot_reasons":%s,"restarting":%s,"wol_mac":%s,"items":[%s]}\n' \
    "${PREPARE_VERSION}" "$(jbool "$1")" "$(jstr "${2:-}")" "$(jbool "$([[ ${#REBOOT_REASONS[@]} -gt 0 ]] && echo 1)")" \
    "$(jarr "${REBOOT_REASONS[@]}")" "$(jstr "${RESTARTING}")" "$(jstr "${WOL_RESULT_MAC}")" "${items}"
}
refuse() { printf 'martlet-prepare: %s\n' "$1" >&2; result_line 0 "$1"; exit 2; }

usage() {
  cat <<'TEXT'
martlet-prepare status [--json]     what is installed and configured (read-only, no sudo)
martlet-prepare ITEM... [options]   apply the named items, in this order:
  updates          apt update + upgrade, noninteractive
  docker           Docker Engine + Compose plugin, started at boot, you in the docker group
  nvidia-driver    install/update the recommended NVIDIA driver (ubuntu-drivers); needs a restart
  nvidia-toolkit   NVIDIA Container Toolkit for Docker, checked with a --gpus all nvidia-smi container
  headless         SSH server on at boot; sleep/suspend/hibernate off     [--boot text|graphical]
  virtual-display  a virtual monitor for a GPU with no screen attached    [--resolution WxH | --virtual-display-off]
  gpu-power        persistence mode; power limits reapplied at boot      [--power GPU-UUID|INDEX=WATTS ... | --power-reset]
  tools            developer tools                                       [--tools cuda,python,node,git,build,htop,nvtop,curl,tmux]
  wol              Wake-on-LAN on the wired network card, kept across restarts
  reboot | shutdown
  --status         after applying, also print the status JSON line
Over SSH without a copy on the computer:  ssh user@computer 'bash -s -- status' < martlet-prepare
Changes need sudo, so give sudo a terminal:  scp martlet-prepare user@computer: && ssh -t user@computer bash martlet-prepare docker tools
TEXT
}

run_item() {
  CURRENT="$1"; ITEM_STATE=ok; ITEM_MSG=""
  printf '\n==> %s\n' "$1"
  "item_${1//-/_}" || { ITEM_STATE=failed; [[ -n "${ITEM_MSG}" ]] || ITEM_MSG="Failed; see the lines above."; OK=0; }
  printf 'MARTLET-ITEM %s %s %s\n' "$1" "${ITEM_STATE}" "${ITEM_MSG}"
  RESULTS+=("{\"item\":$(jstr "$1"),\"state\":$(jstr "${ITEM_STATE}"),\"message\":$(jstr "${ITEM_MSG}")}")
}

SUDO_KEEPER=""
start_sudo() {
  [[ ${EUID} -eq 0 ]] && return 0
  have sudo || refuse "sudo is not installed and this is not root."
  sudo -n true 2>/dev/null || {
    printf '==> sudo: the changes need administrator rights; sudo asks for your password on %s\n' "${HOST_NAME}"
    sudo -v -p "[sudo] password for %u on %H: " || refuse "sudo did not accept the password (or ${TARGET_USER} may not use sudo)."
  }
  ( while sleep 50; do sudo -n -v 2>/dev/null || exit 0; done ) &
  SUDO_KEEPER=$!
  trap '[[ -n "${SUDO_KEEPER}" ]] && kill "${SUDO_KEEPER}" 2>/dev/null' EXIT
}

cmd_apply() {
  declare -A selected=()
  local status_after=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) status_after=1 ;;
      --boot) BOOT="${2:-}"; shift ;;
      --boot=*) BOOT="${1#*=}" ;;
      --resolution) RESOLUTION="${2:-}"; shift ;;
      --resolution=*) RESOLUTION="${1#*=}" ;;
      --virtual-display-off) DISPLAY_OFF=1 ;;
      --power) POWER_SPECS+=("${2:-}"); shift ;;
      --power=*) POWER_SPECS+=("${1#*=}") ;;
      --power-reset) POWER_RESET=1 ;;
      --tools) TOOLS="${2:-}"; shift ;;
      --tools=*) TOOLS="${1#*=}" ;;
      -*) refuse "Unknown option '$1'. See: martlet-prepare help" ;;
      *)
        case " ${ITEM_ORDER[*]} " in *" $1 "*) selected["$1"]=1 ;; *) refuse "Unknown item '$1'. See: martlet-prepare help" ;; esac ;;
    esac
    shift
  done
  [[ ${#selected[@]} -gt 0 ]] || refuse "Name at least one item. See: martlet-prepare help"
  [[ -z "${BOOT}" || "${BOOT}" == text || "${BOOT}" == graphical ]] || refuse "--boot must be text or graphical."
  local spec
  for spec in "${POWER_SPECS[@]}"; do
    [[ "${spec}" =~ ^(GPU-[0-9a-fA-F-]{8,64}|[0-9]{1,2})=[0-9]{1,4}$ ]] || refuse "--power must look like GPU-uuid=WATTS or INDEX=WATTS, not '${spec}'."
  done
  [[ ${selected[reboot]:-0} == 1 && ${selected[shutdown]:-0} == 1 ]] && refuse "Choose reboot or shutdown, not both."

  detect_os
  [[ ${SUPPORTED} == 1 ]] || refuse "${REASON}"
  start_sudo
  printf '==> prepare: %s (%s) as %s: %s\n' "${HOST_NAME}" "${OS_NAME}" "${TARGET_USER}" "$(IFS=' '; printf '%s' "${!selected[*]}")"
  local item
  for item in "${ITEM_ORDER[@]}"; do
    [[ ${selected[${item}]:-0} == 1 ]] || continue
    # Restarting or powering off comes last and only when everything before it worked.
    if [[ "${item}" == reboot || "${item}" == shutdown ]] && [[ ${OK} == 0 ]]; then
      CURRENT="${item}"; RESULTS+=("{\"item\":$(jstr "${item}"),\"state\":\"skipped\",\"message\":\"Skipped because an earlier item failed.\"}")
      printf 'MARTLET-ITEM %s skipped Skipped because an earlier item failed.\n' "${item}"
      continue
    fi
    run_item "${item}"
  done
  printf '\n'
  if [[ ${#REBOOT_REASONS[@]} -gt 0 ]]; then
    printf '==> prepare: restart this computer to finish: %s\n' "$(IFS=,; printf '%s' "${REBOOT_REASONS[*]}")"
  fi
  result_line "${OK}"
  # --status: also print the status JSON afterwards, so a caller needs no second SSH sign-in to see the new state.
  local ok=${OK}
  if [[ ${status_after} == 1 && -z "${RESTARTING}" ]]; then collect; status_json; fi
  [[ ${ok} == 1 ]]
}

main() {
  case "${1:-help}" in
    status) shift; cmd_status "$@" ;;
    help|-h|--help) usage ;;
    *) cmd_apply "$@" ;;
  esac
}

# Everything above is parsed before anything runs, and nothing reads the script's own stdin (it may be the SSH pipe).
main "$@" < /dev/null
